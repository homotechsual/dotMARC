    "@homotechsual/docusaurus-plugin-plausible": "^1.1.1",
    "@mdx-js/react": "^3.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
