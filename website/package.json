    "write-heading-ids": "docusaurus write-heading-ids",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "typecheck": "docusaurus clean-api-docs all && docusaurus gen-api-docs all && tsc",
    "gen-api-docs": "docusaurus clean-api-docs all && docusaurus gen-api-docs all",
    "prebuild": "docusaurus clean-api-docs all && docusaurus gen-api-docs all && tsc --project tsconfig.json"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
