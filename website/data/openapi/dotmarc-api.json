  "info": {
    "description": "Read domains, DNS health, DMARC report summaries, groups, tags and alerts, and add, import and organise domains. Authenticate with an API key from dotMARC's Access page: `Authorization: Bearer dmk_...`. Each operation needs the permission named in its description, and a key limited to certain groups only sees their domains. Each key may make 120 requests a minute.",
    "title": "dotMARC API",
    "version": "0.8.2"
  },
  "openapi": "3.0.4",
  "paths": {
    "/api/v1/alerts": {
      "get": {
        "description": "Alerts newest first, open ones by default (status=all includes resolved), 50 a page by default and at most 200. A key limited to certain groups sees only alerts about its domains.\n\nNeeds the AlertsView permission.",
        "operationId": "ListAlerts",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "pageSize",
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiPageOfApiAlert"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          }
        },
        "summary": "List alerts",
        "tags": [
          "Alerts"
        ],
        "x-dotmarc-permission": "AlertsView"
      }
    },
    "/api/v1/alerts/{id}/acknowledge": {
      "post": {
        "description": "Closes a DMARC policy weakened or nameservers changed alert and accepts the current value as normal, closing its PSA ticket too. Other alerts close themselves once fixed, so acknowledging them is a conflict. ticketClosed is false when the ticket couldn't be closed and needs closing by hand.\n\nNeeds the AlertsManage permission.",
        "operationId": "AcknowledgeAlert",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiAcknowledgement"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Acknowledge an alert",
        "tags": [
          "Alerts"
        ],
        "x-dotmarc-permission": "AlertsManage"
      }
    },
    "/api/v1/domains": {
      "get": {
        "description": "Domains this key can see, in dashboard order, 50 a page by default and at most 200. Filter by group id, tag id or monitoring. The pass rate covers the last 30 days and is null with no reports.\n\nNeeds the DomainsView permission.",
        "operationId": "ListDomains",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "pageSize",
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "group",
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "tag",
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "monitored",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiPageOfApiDomain"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          }
        },
        "summary": "List domains",
        "tags": [
          "Domains"
        ],
        "x-dotmarc-permission": "DomainsView"
      },
      "post": {
        "description": "Adds a domain for dotMARC to monitor. It shows as missing reports until its first DMARC report arrives.\n\nNeeds the DomainsAdd permission.",
        "operationId": "AddDomain",
        "requestBody": {
          "content": {
