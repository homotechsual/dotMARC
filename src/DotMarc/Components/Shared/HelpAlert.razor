@* An in-app callout for information that actually needs attention right now (a required
   external step, a state the admin should notice before proceeding). For "here's what this page
   is/does" pointers to the docs site, use DocsLink instead - a callout box on every page for
   routine background reading just trains admins to stop reading them. *@
<MudAlert Severity="Severity.Info" Class="mb-4" Icon="@Icons.Material.Filled.Info" Dense="true">
    @ChildContent
    @if (!string.IsNullOrEmpty(DocsUrl))
    {
        <MudLink Href="@DocsUrl" Target="_blank" Class="ml-1">Learn more</MudLink>
    }
</MudAlert>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Absolute URL to the relevant docs.dotmarc.app page - external, so this always
    /// opens in a new tab rather than navigating the admin away from what they're doing.</summary>
    [Parameter] public string? DocsUrl { get; set; }
}
