@typeparam TValue

@* A dropdown you can type into to narrow a long list, for lists that grow with your data (Halo clients, groups,
   tags). Short fixed lists stay plain MudSelects. Strict is off so reopening it with a value chosen shows every
   option, not only the one that matches the chosen value's text. *@
<MudAutocomplete T="TValue" Value="Value" ValueChanged="ValueChanged" SearchFunc="SearchAsync" ToStringFunc="ToText"
                 Label="@Label" Placeholder="@Placeholder" HelperText="@HelperText" Variant="Variant" Margin="Margin" Class="@Class"
                 Clearable="Clearable" Disabled="Disabled" Strict="false" ResetValueOnEmptyText="true" MaxItems="null"
                 RelativeWidth="DropdownWidth.Adaptive" />

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SelectOption<TValue>> Options { get; set; } = [];
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Text;
    [Parameter] public Margin Margin { get; set; } = Margin.None;
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Clearable { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private Dictionary<object, string> _textByValue = [];

    protected override void OnParametersSet() =>
        _textByValue = Options.Where(option => option.Value is not null).DistinctBy(option => option.Value).ToDictionary(option => (object)option.Value!, option => option.Text);

    private string ToText(TValue? value) => value is not null && _textByValue.TryGetValue(value, out var text) ? text : "";

    private Task<IEnumerable<TValue>> SearchAsync(string search, CancellationToken cancellationToken)
    {
        // Selecting an option runs a search with its own text; with Strict off MudBlazor passes an empty string
        // instead, so the whole list shows again.
        return Task.FromResult(SelectSearch.Filter(Options, search).Select(option => option.Value));
    }
}
