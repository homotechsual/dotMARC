@using DotMarc.Baselines
@using DotMarc.Data
@using DotMarc.Notifications
@using DotMarc.Psa
@using DotMarc.Reporting
@using Microsoft.AspNetCore.Components.Authorization

<AppPageTitle>dotMARC - @(Inventory ? "Domain Inventory" : "Dashboard")</AppPageTitle>
<div class="domain-list-toolbar mb-3">
    <MudText Typo="Typo.h4">@(Inventory ? "Domain Inventory" : "Dashboard")</MudText>
    <MudButton Href="@(Inventory ? "/dashboard" : _state.ToUrl("/domains"))" StartIcon="@(Inventory ? Icons.Material.Filled.Dashboard : Icons.Material.Filled.Language)">
        @(Inventory ? "Dashboard" : "Domain Inventory")
    </MudButton>
    @if (Inventory)
    {
        <AuthorizeView Policy="DomainsAdd"><MudButton Href="/domains/import" StartIcon="@Icons.Material.Filled.UploadFile">Import domains</MudButton></AuthorizeView>
    }
</div>
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error <MudButton OnClick="LoadAsync">Retry</MudButton></MudAlert>
}
@if (!_loaded)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <DomainListFilters State="_state" Changed="ChangeFiltersAsync" Groups="_groups" Tags="_tags" Rows="_allRows"
                       ScopedGroupIds="_scope" Inventory="Inventory" Companies="_companyOptions" />
    <div class="domain-list-toolbar mb-3">
        @if (Inventory)
        {
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                <MudButton Variant="@(!_state.GroupedView ? Variant.Filled : Variant.Outlined)" OnClick="@(() => ChangeFiltersAsync(_state with { GroupedView = false }))">All domains</MudButton>
                <MudButton Variant="@(_state.GroupedView ? Variant.Filled : Variant.Outlined)" OnClick="@(() => ChangeFiltersAsync(_state with { GroupedView = true }))">By group</MudButton>
            </MudButtonGroup>
            <MudText Typo="Typo.caption" aria-live="polite">@_rows.Count matching domains</MudText>
            @if (_state.Sort is not null)
            {
                <MudText Typo="Typo.caption">Sorted by @_state.Sort @SortMark(_state.Sort)</MudText>
                <MudButton Size="Size.Small" OnClick="@(() => ChangeFiltersAsync(_state with { Sort = null, Descending = false }))">Clear sort</MudButton>
            }
        }
        @if (_userKey is not null)
        {
            <MudButton OnClick="SaveDefaultAsync" StartIcon="@Icons.Material.Filled.Save" Size="Size.Small">Save as my default</MudButton>
            @if (_hasDefault)
            {
                <MudButton OnClick="ClearDefaultAsync" Size="Size.Small">Clear my default</MudButton>
            }
        }
    </div>
    @if (Inventory)
    {
        <AuthorizeView Policy="DomainsAdd">
            <MudPaper Class="pa-3 mb-3" Outlined="true">
                <div class="domain-list-toolbar">
                    <MudTextField T="string" Label="Domain name" @bind-Value="_newDomain" Error="@(_addError is not null)" ErrorText="_addError" />
                    <MudButton OnClick="AddAsync" Variant="Variant.Filled" Color="Color.Primary">Add domain</MudButton>
                </div>
            </MudPaper>
        </AuthorizeView>
        <MudSwitch T="bool" @bind-Value="_management" Label="Show management columns" Color="Color.Primary" />
        @if (_management && !CanReorder)
        {
            <MudText Typo="Typo.caption">Manual reorder requires All domains, no filters or column sort, and unrestricted reorder access.</MudText>
        }
        @foreach (var list in _psaLists.Where(list => list.FailureReason is not null))
        {
            <MudAlert Severity="Severity.Warning">@list.FailureReason Saved company links are read-only until reloaded.</MudAlert>
        }
        @if (_rows.Count == 0)
        {
            <MudAlert Severity="Severity.Info">No domains match. Open Filters to change or clear your criteria.</MudAlert>
        }
        else if (_state.GroupedView)
        {
            @foreach (var group in _grouped)
            {
                <section class="mb-4">
                    <MudText Typo="Typo.h6">@(group.GroupName ?? "No group") (@group.Rows.Count)</MudText>
                    @DomainTable(group.Rows)
                </section>
            }
        }
        else
        {
            @DomainTable(_rows)
        }
    }
    else if (_summary is not null)
    {
        <MudGrid Class="mb-4">
            <MudItem xs="6" md="2"><MudPaper Class="pa-3"><MudText Typo="Typo.h5">@_summary.DomainCount</MudText><MudText Typo="Typo.caption">domains in scope</MudText></MudPaper></MudItem>
            <MudItem xs="6" md="2"><MudPaper Class="pa-3"><MudText Typo="Typo.h5" Class="domain-percentage">@_summary.OverallPassRate.ToString("P1")</MudText><MudText Typo="Typo.caption">overall pass rate (30d)</MudText></MudPaper></MudItem>
            <MudItem xs="6" md="2"><MudPaper Class="pa-3"><MudLink Href="@((_state with { Status = "Warning" }).ToUrl("/domains"))">@_summary.WarningCount domains with warnings</MudLink></MudPaper></MudItem>
            <MudItem xs="6" md="2"><MudPaper Class="pa-3"><MudLink Href="@((_state with { Status = "Missing" }).ToUrl("/domains"))">@_summary.MissingCount missing expected report</MudLink></MudPaper></MudItem>
            <AuthorizeView Policy="DomainsWrite">
                <MudItem xs="6" md="2"><MudPaper Class="pa-3"><MudLink Href="/parse-failures">@_summary.ParseFailureCount unparseable messages (all domains)</MudLink></MudPaper></MudItem>
            </AuthorizeView>
            <MudItem xs="6" md="2"><MudPaper Class="pa-3"><MudText Typo="Typo.h5">@_summary.SourceCount</MudText><MudText Typo="Typo.caption">sources provided reports (30d)</MudText></MudPaper></MudItem>
        </MudGrid>
        @if (_summary.ReasonBreakdown.Total > 0)
        {
            <MudPaper Class="pa-4 mb-4">
                <MudText Typo="Typo.subtitle1">Why rejects/quarantines happened, filtered domains (30d)</MudText>
                <MudChart ChartType="ChartType.Donut" T="double"
                          ChartSeries="@([new double[] { _summary.ReasonBreakdown.BenignOverride, _summary.ReasonBreakdown.LocalPolicy, _summary.ReasonBreakdown.Other, _summary.ReasonBreakdown.InferredSpfFailure, _summary.ReasonBreakdown.InferredDkimFailure, _summary.ReasonBreakdown.InferredBothFailure, _summary.ReasonBreakdown.NoReasonGiven }])"
                          ChartLabels="@(new[] { "Benign override", "Local policy", "Other", "SPF failure (inferred)", "DKIM failure (inferred)", "SPF & DKIM failure (inferred)", "No reason given" })" Width="220px" Height="220px" />
                <ReasonBreakdownList Breakdown="_summary.ReasonBreakdown" />
            </MudPaper>
        }
        <DashboardPolling />
    }
}

@code {
    private RenderFragment DomainTable(IReadOnlyList<DashboardDomainRow> rows) => @<MudTable Items="rows" T="DashboardDomainRow" Hover="true" Class="domain-inventory">
        <HeaderContent>
            @if (_management) { <MudTh>Order</MudTh> }
            @foreach (var column in Columns)
            {
                <MudTh aria-sort="@(_state.Sort == column.Key ? (_state.Descending ? "descending" : "ascending") : "none")"><button type="button" class="domain-sort" @onclick="@(() => SortAsync(column.Key))" aria-label="@($"Sort by {column.Value}")">
                    @column.Value
                    @if (_state.Sort == column.Key)
                    {
                        <MudIcon Icon="@(_state.Descending ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)" Size="Size.Small" />
                    }
                </button></MudTh>
            }
            @if (_management)
            {
                <MudTh><button type="button" class="domain-sort" @onclick="@(() => SortAsync("groups"))">Groups @SortMark("groups")</button></MudTh>
                <MudTh><button type="button" class="domain-sort" @onclick="@(() => SortAsync("tags"))">Tags @SortMark("tags")</button></MudTh>
                <MudTh><button type="button" class="domain-sort" @onclick="@(() => SortAsync("reports"))">Reports @SortMark("reports")</button></MudTh>
                @foreach (var psa in _companyOptions.Keys.Order()) { <MudTh>@psa.CompanyLabel() override</MudTh> }
                <MudTh>Actions</MudTh>
            }
        </HeaderContent>
        <RowTemplate Context="row">
            @if (_management)
            {
                <MudTd>
                    @if (CanReorder)
                    {
                        <div draggable="true" @ondragstart="@(() => _draggedId = row.Id)" @ondragover:preventDefault="true" @ondrop="@(() => DropAsync(row.Id))" title="Drag to reorder">
                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" />
                        </div>
                    }
                </MudTd>
            }
            <MudTd DataLabel="Domain">
                <a href="@($"/domains/{Uri.EscapeDataString(row.Name)}")" data-domain-link>@row.Name</a>
                @if (row.SpfCheckStatus == SpfCheckStatus.NullSpf) { <MudChip T="string" Size="Size.Small" Color="Color.Info">Null-routed</MudChip> }
            </MudTd>
            <MudTd DataLabel="Report status"><MudChip T="string" Size="Size.Small" Color="row.StatusColor">@row.Status</MudChip></MudTd>
            <MudTd DataLabel="Pass rate (30d)" Class="domain-percentage">@(row.PassRate?.ToString("P1") ?? "—")</MudTd>
            <MudTd DataLabel="Last report">@(row.LastReportReceivedUtc?.ToString("g") ?? "never")</MudTd>
            <MudTd DataLabel="Monitored">
                <AuthorizeView Policy="DomainsEdit" Context="edit">
                    <Authorized><MudSwitch T="bool" Value="row.IsMonitored" ValueChanged="@(value => SetMonitoredAsync(row.Id, value))" aria-label="@($"Monitor {row.Name}")" /></Authorized>
                    <NotAuthorized>@(row.IsMonitored ? "Yes" : "No")</NotAuthorized>
                </AuthorizeView>
            </MudTd>
            <MudTd DataLabel="Target">@TargetLabel(row.TargetOutcome)</MudTd>
            <MudTd DataLabel="DMARC"><MudChip T="string" Size="Size.Small" Color="@DmarcStatusPresentation.GetColor(row.DmarcCheckStatus, row.DmarcAuthorizationCheckStatus)">@DmarcStatusPresentation.GetLabel(row.DmarcCheckStatus, row.DmarcAuthorizationCheckStatus)</MudChip></MudTd>
            <MudTd DataLabel="MTA-STS"><MudChip T="string" Size="Size.Small" Color="@MtaStsStatusPresentation.GetColor(row.MtaStsStatus)">@MtaStsStatusPresentation.GetLabel(row.MtaStsStatus)</MudChip></MudTd>
            <MudTd DataLabel="DKIM"><MudChip T="string" Size="Size.Small" Color="@DkimStatusPresentation.GetColor(row.DkimCheckStatus)">@DkimStatusPresentation.GetLabel(row.DkimCheckStatus)</MudChip></MudTd>
            @if (_management)
            {
                var domain = _domainsById[row.Id];
                <MudTd DataLabel="Groups">
                    <AuthorizeView Policy="DomainsEdit" Context="groupEdit">
                        <Authorized><SearchableMultiSelect TValue="int" Label="@($"Groups for {row.Name}")" Options="@(_groups.Select(group => new SelectOption<int>(group.Id, group.Name)).ToList())" SelectedValues="@(VisibleGroups(domain))" SelectedValuesChanged="@(ids => SetGroupsAsync(row.Id, ids))" /></Authorized>
                        <NotAuthorized>@string.Join(", ", _groups.Where(group => domain.Groups.Any(member => member.Id == group.Id)).Select(group => group.Name))</NotAuthorized>
                    </AuthorizeView>
                </MudTd>
                <MudTd DataLabel="Tags">
                    <AuthorizeView Policy="DomainsEdit" Context="tagEdit">
                        <Authorized><SearchableMultiSelect TValue="int" Label="@($"Tags for {row.Name}")" Options="@(_tags.Select(tag => new SelectOption<int>(tag.Id, tag.Name)).ToList())" SelectedValues="@(domain.Tags.Select(tag => tag.Id).ToList())" SelectedValuesChanged="@(ids => SetTagsAsync(row.Id, ids))" /></Authorized>
                        <NotAuthorized>@string.Join(", ", domain.Tags.Select(tag => tag.Name))</NotAuthorized>
                    </AuthorizeView>
                </MudTd>
                <MudTd DataLabel="Reports">@_reportCounts.GetValueOrDefault(row.Id)</MudTd>
                @foreach (var psa in _companyOptions.Keys.Order())
                {
                    var list = _psaLists.FirstOrDefault(list => list.Psa == psa);
                    var link = domain.PsaCompanyLinks.FirstOrDefault(link => link.Psa == psa);
                    <MudTd DataLabel="@(psa.CompanyLabel())">
                        <AuthorizeView Policy="DomainsEdit" Context="psaEdit">
                            <Authorized><PsaCompanyPicker Psa="psa" Companies="list?.Companies" Current="link" Placeholder="Use Group's" CompanyChanged="@(company => SetCompanyAsync(row.Id, psa, company))" /></Authorized>
                            <NotAuthorized>@(link?.CompanyName ?? "Use Group's")</NotAuthorized>
                        </AuthorizeView>
                    </MudTd>
                }
                <MudTd><AuthorizeView Policy="DomainsDelete" Context="delete"><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteAsync(row.Id))" aria-label="@($"Remove {row.Name}")" /></AuthorizeView></MudTd>
            }
        </RowTemplate>
    </MudTable>;
}
