@using DotMarc.Baselines
@using DotMarc.Data
@using DotMarc.Notifications
@using DotMarc.Psa
@using DotMarc.Reporting
@using Microsoft.AspNetCore.Components.Authorization

<AppPageTitle>dotMARC - @(Inventory ? "Domains" : "Dashboard")</AppPageTitle>
<div class="domain-list-toolbar mb-3">
    <MudText Typo="Typo.h4">@(Inventory ? "Domains" : "Dashboard")</MudText>
    <MudButton Href="@(Inventory ? "/dashboard" : _state.ToUrl("/domains"))" StartIcon="@(Inventory ? Icons.Material.Filled.Dashboard : Icons.Material.Filled.Language)">
        @(Inventory ? "Dashboard" : "Domains")
    </MudButton>
</div>
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error <MudButton OnClick="LoadAsync">Retry</MudButton></MudAlert>
}
@if (!_loaded)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <DomainListFilters State="_state" Changed="ChangeFiltersAsync" Groups="_groups" Tags="_tags" Rows="_allRows"
                       ScopedGroupIds="_scope" Inventory="Inventory" Companies="_companyOptions">
        <Actions>
            <AuthorizeView Policy="DomainsAdd">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _showAddDomain = !_showAddDomain)"
                           aria-controls="add-domain" aria-expanded="@_showAddDomain.ToString().ToLowerInvariant()">@(_showAddDomain ? "Close add domain" : "Add domain")</MudButton>
                <MudButton Href="@ImportUrl" StartIcon="@Icons.Material.Filled.UploadFile">Import domains</MudButton>
            </AuthorizeView>
            <MudButton OnClick="LoadAsync" Disabled="_loading" StartIcon="@Icons.Material.Filled.Refresh">Refresh</MudButton>
        </Actions>
    </DomainListFilters>
    <div class="domain-list-toolbar mb-3">
        @if (Inventory)
        {
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                <MudButton Variant="@(!_state.GroupedView ? Variant.Filled : Variant.Outlined)" OnClick="@(() => ChangeFiltersAsync(_state with { GroupedView = false }))">All domains</MudButton>
                <MudButton Variant="@(_state.GroupedView ? Variant.Filled : Variant.Outlined)" OnClick="@(() => ChangeFiltersAsync(_state with { GroupedView = true }))">By group</MudButton>
            </MudButtonGroup>
            <MudText Typo="Typo.caption" aria-live="polite">@_rows.Count matching domains</MudText>
            @if (_state.Sort is not null)
            {
                <MudText Typo="Typo.caption">Sorted by @_state.Sort @SortMark(_state.Sort)</MudText>
                <MudButton Size="Size.Small" OnClick="@(() => ChangeFiltersAsync(_state with { Sort = null, Descending = false }))">Clear sort</MudButton>
            }
        }
        @if (_userKey is not null)
        {
            <MudButton OnClick="SaveDefaultAsync" StartIcon="@Icons.Material.Filled.Save" Size="Size.Small">Save as my default</MudButton>
            @if (_hasDefault)
            {
                <MudButton OnClick="ClearDefaultAsync" Size="Size.Small">Clear my default</MudButton>
            }
        }
    </div>
    <AddDomainForm GroupId="_state.GroupId" Added="@(_ => LoadAsync())" Collapsed="true" HideToggle="true" Open="_showAddDomain" />
    @if (Inventory)
    {
        @if (_canBulkDns)
        {
            <div class="domain-list-toolbar domain-dns-toolbar mb-3">
                <MudText Typo="Typo.body2" role="status">@_selectedDnsDomains.Count selected for DNS review</MudText>
                @if (_state.ActiveFilters.Count == 0)
                {
                    <MudButton OnClick="SelectAllDomains" Disabled="@(_checkingProviders || !RendererInfo.IsInteractive || _allRows.Count == 0)">Select all</MudButton>
                }
                else
                {
                    <MudMenu Label="Select domains" Disabled="@(_checkingProviders || !RendererInfo.IsInteractive)" EndIcon="@Icons.Material.Filled.ArrowDropDown">
                        <MudMenuItem OnClick="SelectVisibleDomains" Disabled="@(_rows.Count == 0)">Select visible (@_rows.Count)</MudMenuItem>
                        <MudMenuItem OnClick="SelectAllDomains" Disabled="@(_allRows.Count == 0)">Select all (@_allRows.Count accessible)</MudMenuItem>
                    </MudMenu>
                }
                @if (SelectedHiddenCount > 0)
                {
                    <MudText Typo="Typo.caption" role="status">@SelectedHiddenCount selected domains hidden by filters; actions include them.</MudText>
                }
                <MudButton OnClick="ClearDomainSelection" Disabled="@(_checkingProviders || _selectedDnsDomains.Count == 0)">Clear selection</MudButton>
                @if (_canCheckProviders)
                {
                    <MudButton OnClick="RecheckSelectedProvidersAsync" StartIcon="@Icons.Material.Filled.Refresh"
                               Disabled="@(_checkingProviders || !RendererInfo.IsInteractive || _selectedDnsDomains.Count == 0)">Recheck selected providers</MudButton>
                }
                <MudButton OnClick="ReviewSelectedDnsAsync" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudSync"
                           Disabled="@(_checkingProviders || !RendererInfo.IsInteractive || _selectedDnsDomains.Count == 0)">Review selected DNS</MudButton>
                @if (_checkingProviders) { <MudText role="status">Checking providers: @_providersChecked of @_providerCheckTotal</MudText> }
            </div>
            @if (!_checkingProviders && _providerCheckTotal > 0)
            {
                <MudAlert Severity="@(_providerCheckResults.Any(result => !result.Succeeded) || _providersChecked < _providerCheckTotal ? Severity.Warning : Severity.Success)" Class="mb-3">
                    Provider checks: @_providerCheckResults.Count(result => result.Succeeded) succeeded, @_providerCheckResults.Count(result => !result.Succeeded) failed, @(_providerCheckTotal - _providersChecked) not attempted. DNS records were not changed.
                    @foreach (var failure in _providerCheckResults.Where(result => !result.Succeeded))
                    {
                        <MudText Typo="Typo.body2">@(failure.DomainName.Length > 0 ? failure.DomainName : $"Domain {failure.DomainId}"): @failure.Error</MudText>
                    }
                </MudAlert>
            }
        }
        <MudSwitch T="bool" @bind-Value="_management" Label="Show management columns" Color="Color.Primary" />
        @if (_management)
        {
            <div class="domain-list-toolbar mb-3">
                <MudText Typo="Typo.caption">Expand a domain's Manage control for groups, tags and overrides.</MudText>
            </div>
        }
        @if (_management && !CanReorder)
        {
            <MudText Typo="Typo.caption">Manual reorder requires All domains, no filters or column sort, and unrestricted reorder access.</MudText>
        }
        @foreach (var list in _psaLists.Where(list => list.FailureReason is not null))
        {
            <MudAlert Severity="Severity.Warning">@list.FailureReason Saved company links are read-only until reloaded.</MudAlert>
        }
        @if (_rows.Count == 0)
        {
            <MudAlert Severity="Severity.Info">No domains match. Open Filters to change or clear your criteria.</MudAlert>
        }
        else if (_state.GroupedView)
        {
            @foreach (var group in _grouped)
            {
                <section class="mb-4">
                    <MudText Typo="Typo.h6">@(group.GroupName ?? "No group") (@group.Rows.Count)</MudText>
                    @DomainTable(group.Rows)
                </section>
            }
        }
        else
        {
            @DomainTable(_rows)
        }
    }
    else if (_actionCentre is not null)
    {
        <DashboardActionCentreView @key="_snapshotUtc" Data="_actionCentre" ParseFailures="_parseFailures" State="_state" Changed="ChangeFiltersAsync" />
    }
}

@code {
    private RenderFragment DomainTable(IReadOnlyList<DashboardDomainRow> rows) => @<MudTable Items="rows" T="DashboardDomainRow" Hover="true" Class="domain-inventory" aria-busy="@_loading.ToString().ToLowerInvariant()">
        <HeaderContent>
            @if (_canBulkDns) { <MudTh>Select for DNS</MudTh> }
            @if (_management) { <MudTh>Manage</MudTh> }
            @foreach (var column in Columns)
            {
                <MudTh aria-sort="@(_state.Sort == column.Key ? (_state.Descending ? "descending" : "ascending") : "none")"><button type="button" class="domain-sort" @onclick="@(() => SortAsync(column.Key))" aria-label="@($"Sort by {column.Value}")">
                    @column.Value
                    @if (_state.Sort == column.Key)
                    {
                        <MudIcon Icon="@(_state.Descending ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)" Size="Size.Small" />
                    }
                </button></MudTh>
            }
        </HeaderContent>
        <RowTemplate Context="row">
            @if (_canBulkDns)
            {
                <MudTd DataLabel="Select for DNS"><MudCheckBox T="bool" Value="@_selectedDnsDomains.Contains(row.Id)" ValueChanged="@(selected => SelectDnsDomain(row.Id, selected))"
                    Disabled="@(!RendererInfo.IsInteractive)" aria-label="@($"Select {row.Name} for DNS review")" /></MudTd>
            }
            @if (_management)
            {
                <MudTd>
                    <MudIconButton Icon="@(_expandedManagement.Contains(row.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                   OnClick="@(() => ToggleManagement(row.Id))" aria-label="@($"Manage {row.Name}")" aria-expanded="@_expandedManagement.Contains(row.Id).ToString().ToLowerInvariant()" />
                    @if (CanReorder)
                    {
                        <div draggable="true" @ondragstart="@(() => _draggedId = row.Id)" @ondragover:preventDefault="true" @ondrop="@(() => DropAsync(row.Id))" title="Drag to reorder">
                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" />
                        </div>
                    }
                </MudTd>
            }
            <MudTd DataLabel="Domain">
                <a href="@($"/domains/{Uri.EscapeDataString(row.Name)}")" data-domain-link>@row.Name</a>
                @if (row.SpfCheckStatus == SpfCheckStatus.NullSpf) { <MudChip T="string" Size="Size.Small" Color="Color.Info">Null-routed</MudChip> }
            </MudTd>
            <MudTd DataLabel="Report status"><DomainStatusIcon Label="@($"Report status: {row.Status}")" Color="row.StatusColor" /></MudTd>
            <MudTd DataLabel="Pass rate (30d)" Class="domain-percentage">@(row.PassRate?.ToString("P1") ?? "—")</MudTd>
            <MudTd DataLabel="Last report"><MudTooltip Text="@(row.LastReportReceivedUtc?.ToString("g") ?? "never")">@(row.LastReportReceivedUtc?.ToString("d") ?? "never")</MudTooltip></MudTd>
            <MudTd DataLabel="Monitored">
                <AuthorizeView Policy="DomainsEdit" Context="edit">
                    <Authorized><MudSwitch T="bool" Value="row.IsMonitored" ValueChanged="@(value => SetMonitoredAsync(row.Id, value))" Color="Color.Primary" aria-label="@($"Monitor {row.Name}")" /></Authorized>
                    <NotAuthorized>@(row.IsMonitored ? "Yes" : "No")</NotAuthorized>
                </AuthorizeView>
            </MudTd>
            <MudTd DataLabel="Target"><DomainStatusIcon Label="@($"DMARC target: {TargetLabel(row.TargetOutcome)}")" Color="@(row.TargetOutcome == Baselines.DmarcTargetOutcome.Meets ? Color.Success : row.TargetOutcome == Baselines.DmarcTargetOutcome.Below ? Color.Warning : Color.Default)" /></MudTd>
            <MudTd DataLabel="DMARC"><DomainStatusIcon Color="@DmarcStatusPresentation.GetColor(row.DmarcCheckStatus, row.DmarcAuthorizationCheckStatus, row.TargetOutcome)" Label="@($"DMARC: {DmarcStatusPresentation.GetLabel(row.DmarcCheckStatus, row.DmarcAuthorizationCheckStatus, row.TargetOutcome)}")" /></MudTd>
            <MudTd DataLabel="MTA-STS"><DomainStatusIcon Color="@MtaStsStatusPresentation.GetColor(row.MtaStsStatus)" Label="@($"MTA-STS: {MtaStsStatusPresentation.GetLabel(row.MtaStsStatus)}")" /></MudTd>
            <MudTd DataLabel="DKIM"><DomainStatusIcon Color="@DkimStatusPresentation.GetColor(row.DkimCheckStatus)" Label="@($"DKIM: {DkimStatusPresentation.GetLabel(row.DkimCheckStatus)}")" /></MudTd>
        </RowTemplate>
        <ChildRowContent Context="row">
            @if (_management && _expandedManagement.Contains(row.Id))
            {
                var domain = _domainsById[row.Id];
                <MudTr><MudTd colspan="@(Columns.Length + 1 + (_canBulkDns ? 1 : 0))">
                <div class="domain-management-details" aria-label="@($"Management for {row.Name}")">
                <div>
                    <AuthorizeView Policy="DomainsEdit" Context="groupEdit">
                        <Authorized><SearchableMultiSelect TValue="int" Label="@($"Groups for {row.Name}")" Options="@(_groups.Select(group => new SelectOption<int>(group.Id, group.Name)).ToList())" SelectedValues="@(VisibleGroups(domain))" SelectedValuesChanged="@(ids => SetGroupsAsync(row.Id, ids))" /></Authorized>
                        <NotAuthorized>@string.Join(", ", _groups.Where(group => domain.Groups.Any(member => member.Id == group.Id)).Select(group => group.Name))</NotAuthorized>
                    </AuthorizeView>
                </div>
                <div>
                    <AuthorizeView Policy="DomainsEdit" Context="tagEdit">
                        <Authorized><SearchableMultiSelect TValue="int" Label="@($"Tags for {row.Name}")" Options="@(_tags.Select(tag => new SelectOption<int>(tag.Id, tag.Name)).ToList())" SelectedValues="@(domain.Tags.Select(tag => tag.Id).ToList())" SelectedValuesChanged="@(ids => SetTagsAsync(row.Id, ids))" /></Authorized>
                        <NotAuthorized>@string.Join(", ", domain.Tags.Select(tag => tag.Name))</NotAuthorized>
                    </AuthorizeView>
                </div>
                <MudText Typo="Typo.body2">Reports: @_reportCounts.GetValueOrDefault(row.Id)</MudText>
                @foreach (var psa in _companyOptions.Keys.Order())
                {
                    var list = _psaLists.FirstOrDefault(list => list.Psa == psa);
                    var link = domain.PsaCompanyLinks.FirstOrDefault(link => link.Psa == psa);
                    <div>
                        <AuthorizeView Policy="DomainsEdit" Context="psaEdit">
                            <Authorized><PsaCompanyPicker Psa="psa" Companies="list?.Companies" Current="link" Placeholder="Use Group's" CompanyChanged="@(company => SetCompanyAsync(row.Id, psa, company))" /></Authorized>
                            <NotAuthorized>@(link?.CompanyName ?? "Use Group's")</NotAuthorized>
                        </AuthorizeView>
                    </div>
                }
                <AuthorizeView Policy="DomainsDelete" Context="delete"><MudButton StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteAsync(row.Id))" aria-label="@($"Remove {row.Name}")">Remove domain</MudButton></AuthorizeView>
                </div>
                </MudTd></MudTr>
            }
        </ChildRowContent>
    </MudTable>;
}
