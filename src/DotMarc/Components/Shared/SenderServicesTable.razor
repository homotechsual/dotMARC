@using DotMarc.Data
@using DotMarc.Reporting

@* One row per sending service found in a domain's reports, with the evidence behind it, what is failing, and the decision made about it. *@
@if (Result is null || (Result.Services.Count == 0 && Result.Unrecognised is null))
{
    <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">No sending sources in the last 30 days.</MudText>
}
else
{
    <MudText Typo="Typo.subtitle1" Class="mb-1">Senders</MudText>
    <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">
        The services your reports point to. Evidence is a score of the signals found for a service, not a certainty.
        Expand Source IPs to inspect evidence and @((CanReview ? "record decisions for individual IPs." : "view inherited or recorded IP decisions. You do not have permission to change decisions."))
    </MudText>
    <ListToolbar Label="Sender controls" SearchLabel="Search services or source IPs" @bind-Search="_search" @bind-Expanded="_showFilters"
                 FilterCount="@(_decisionFilter is null ? 0 : 1)" ClearFilters="@(() => _decisionFilter = null)">
        <SortContent>
            <MudSelect T="string" Label="Sort senders" @bind-Value="_sort" Variant="Variant.Outlined" Margin="Margin.Dense" Class="list-sort">
                <MudSelectItem Value="@("")">Default order</MudSelectItem>
                <MudSelectItem Value="@("name")">Name (A to Z)</MudSelectItem>
                <MudSelectItem Value="@("name-desc")">Name (Z to A)</MudSelectItem>
                <MudSelectItem Value="@("volume")">Most messages</MudSelectItem>
            </MudSelect>
        </SortContent>
        <FiltersContent><SenderDecisionFilter @bind-Value="_decisionFilter" /></FiltersContent>
    </ListToolbar>
    <MudSimpleTable Dense="true" Hover="true" Class="mb-6" Style="overflow-x:auto;">
        <thead>
            <tr>
                <th>Source IPs &amp; evidence</th>
                <th>Service</th>
                <th>Messages</th>
                <th>Share</th>
                <th>Evidence</th>
                <th>Decision</th>
                <th>Pass rate</th>
                <th>Failing</th>
                <th>Fix</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in VisibleRows())
            {
                var resolved = RowDecision(row);
                <tr>
                    <td>
                        <MudButton StartIcon="@(IsOpen(row) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small"
                                   Variant="Variant.Outlined" aria-label="@ToggleTitle(row)" aria-expanded="@(IsOpen(row) ? "true" : "false")"
                                   OnClick="@(() => Toggle(row))">Source IPs (@row.SourceIps.Count)</MudButton>
                    </td>
                    <td>@(row.IsUnrecognised ? "Not matched to a known service" : row.Name)</td>
                    <td>@row.Messages.ToString("N0")</td>
                    <td>@Percent(row.Share)</td>
                    <td>
                        @if (row.Evidence is { } evidence)
                        {
                            <MudChip T="string" Size="Size.Small" Color="@BandColor(evidence)">@(Percent(evidence) + " " + BandLabel(evidence))</MudChip>
                        }
                    </td>
                    <td>
                        @if (row.IsUnrecognised)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@(CanReview ? "Expand Source IPs to decide per IP" : "Expand Source IPs to view decisions")</MudText>
                        }
                        else
                        {
                            @DecisionChip(resolved, row.Name, row.Name, SenderDecisionKind.Service)
                        }
                    </td>
                    <td>@(row.PassRate is { } passRate ? Percent(passRate) : "n/a")</td>
                    <td>
                        @if (row.Failing > 0)
                        {
                            <div>@row.Failing.ToString("N0")</div>
                            @if (row.ActedOn > 0)
                            {
                                <div><MudText Typo="Typo.caption" Class="mud-text-secondary">@(row.ActedOn.ToString("N0") + " quarantined or rejected")</MudText></div>
                            }
                        }
                        else
                        {
                            <span>0</span>
                        }
                    </td>
                    <td>@FixText(row, resolved)</td>
                </tr>
                @if (IsOpen(row))
                {
                    <tr>
                        <td></td>
                        <td colspan="8">
                            @if (row.EvidenceLines.Count > 0)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@(row.IsUnrecognised ? "Who owns these IPs" : "Why we think so")</MudText>
                                <ul class="mb-2">
                                    @foreach (var line in row.EvidenceLines)
                                    {
                                        <li>@line</li>
                                    }
                                </ul>
                            }
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Source IPs</MudText>
                            @foreach (var ip in row.SourceIps)
                            {
                                <div class="d-flex align-center" style="gap:0.5rem; flex-wrap:wrap;">
                                    <span>@ip</span>
                                    @DecisionChip(IpResolved(ip), ip, ip, SenderDecisionKind.Ip)
                                </div>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </MudSimpleTable>
}

@code {
    private string? _search, _decisionFilter;
    private string _sort = "";
    private bool _showFilters;
    private IEnumerable<SenderServiceRow> VisibleRows()
    {
        var rows = Rows().Where(row => (string.IsNullOrWhiteSpace(_search) || row.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || row.SourceIps.Any(ip => ip.Contains(_search, StringComparison.OrdinalIgnoreCase)))
            && (_decisionFilter is null || SenderDecisionPresentation.StatusLabel(RowDecision(row).Status) == _decisionFilter));
        return _sort switch
        {
            "name" => rows.OrderBy(row => row.Name, StringComparer.OrdinalIgnoreCase),
            "name-desc" => rows.OrderByDescending(row => row.Name, StringComparer.OrdinalIgnoreCase),
            "volume" => rows.OrderByDescending(row => row.Messages),
            _ => rows
        };
    }
    [Parameter] public SenderIdentificationResult? Result { get; set; }

    /// <summary>The decision that applies to a service row. Unrecognised rows have no row-level decision.</summary>
    [Parameter] public Func<SenderServiceRow, ResolvedSenderDecision>? DecisionFor { get; set; }

    /// <summary>The decision that applies to one source IP, with its service's decision if it has no IP decision of its own.</summary>
    [Parameter] public Func<string, ResolvedSenderDecision>? IpDecisionFor { get; set; }

    [Parameter] public DmarcPolicyLevel Policy { get; set; }
    [Parameter] public IReadOnlyDictionary<int, string> GroupNames { get; set; } = new Dictionary<int, string>();

    /// <summary>Whether the person can change decisions. Without it the chips are labels, not buttons.</summary>
    [Parameter] public bool CanReview { get; set; }

    [Parameter] public EventCallback<SenderDecisionRequest> OnDecide { get; set; }

    /// <summary>Which sender someone asked to decide on, and what to call it in the dialog.</summary>
    public sealed record SenderDecisionRequest(SenderDecisionKind Kind, string Key, string Label);

    private static readonly ResolvedSenderDecision Unreviewed = new(null, SenderDecisionLevel.None, null, null);

    private readonly HashSet<string> _open = [];

    private IEnumerable<SenderServiceRow> Rows() =>
        Result is null ? [] : Result.Unrecognised is { } unrecognised ? Result.Services.Append(unrecognised) : Result.Services;

    private ResolvedSenderDecision RowDecision(SenderServiceRow row) =>
        row.IsUnrecognised || DecisionFor is null ? Unreviewed : DecisionFor(row);

    private ResolvedSenderDecision IpResolved(string ip) => IpDecisionFor?.Invoke(ip) ?? Unreviewed;

    private string? FixText(SenderServiceRow row, ResolvedSenderDecision resolved) =>
        row.IsUnrecognised ? row.Fix : SenderDecisionPresentation.FixFor(row, resolved, Policy);

    /// <summary>The status as a read-only chip, with a "Decide" or "Change" button beside it for people who may review. Where the
    /// decision came from is in the chip's tooltip rather than a second line under every chip.</summary>
    private RenderFragment DecisionChip(ResolvedSenderDecision resolved, string key, string label, SenderDecisionKind kind) => @<div class="d-flex align-center" style="gap:0.5rem; flex-wrap:wrap;">
        @{
            var tooltip = ChipTooltip(resolved, kind);
        }
        <MudTooltip Text="@tooltip" Disabled="@(tooltip is null)" Arrow="true">
            <MudChip T="string" Size="Size.Small" Color="@StatusColor(resolved.Status)">@SenderDecisionPresentation.StatusLabel(resolved.Status)</MudChip>
        </MudTooltip>
        @if (CanReview)
        {
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                       aria-label="@($"{(resolved.Status is null ? "Decide on" : "Change decision for")} {(kind == SenderDecisionKind.Ip ? "source IP" : "service")} {label}")"
                       OnClick="@(() => OnDecide.InvokeAsync(new SenderDecisionRequest(kind, key, label)))">@(resolved.Status is null ? "Decide" : "Change")</MudButton>
        }
    </div>;

    /// <summary>What the chip's tooltip says: a conflict when there is one, otherwise where the decision came from. Null when
    /// nothing was decided, so an unreviewed chip has no tooltip.</summary>
    private string? ChipTooltip(ResolvedSenderDecision resolved, SenderDecisionKind kind)
    {
        if (resolved.Conflict is not null)
        {
            return resolved.Conflict;
        }

        var source = kind == SenderDecisionKind.Ip && resolved.Decision?.Kind == SenderDecisionKind.Service
            ? "same as the service"
            : SenderDecisionPresentation.Provenance(resolved, GroupNames);
        return source.Length == 0 ? null : $"{SenderDecisionPresentation.StatusLabel(resolved.Status)}, {source}";
    }

    private static Color StatusColor(SenderDecisionStatus? status) => status switch
    {
        SenderDecisionStatus.Authorised => Color.Success,
        SenderDecisionStatus.Unauthorised => Color.Error,
        SenderDecisionStatus.UnderReview => Color.Warning,
        _ => Color.Default,
    };

    private bool IsOpen(SenderServiceRow row) => _open.Contains(row.Name);

    private void Toggle(SenderServiceRow row)
    {
        if (!_open.Remove(row.Name))
        {
            _open.Add(row.Name);
        }
    }

    private string ToggleTitle(SenderServiceRow row) => $"{(IsOpen(row) ? "Hide" : "Show")} source IPs and evidence for {(row.IsUnrecognised ? "unrecognised senders" : row.Name)}";

    private static string Percent(double value) => value.ToString("P0");

    private static Color BandColor(double evidence) =>
        evidence >= SenderScoring.StrongFrom ? Color.Success : evidence >= SenderScoring.ModerateFrom ? Color.Warning : Color.Default;

    private static string BandLabel(double evidence) =>
        evidence >= SenderScoring.StrongFrom ? "strong" : evidence >= SenderScoring.ModerateFrom ? "moderate" : "weak";
}
