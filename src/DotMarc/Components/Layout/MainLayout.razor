@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using DotMarc.Demo
@using DotMarc.Notifications
@using DotMarc.Components.Shared
@using DotMarc.Baselines
@using DotMarc.Reporting
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Options
@using System.Reflection
@implements IDisposable
@inject IJSRuntime Js
@using DotMarc.DevBuild
@inject IOptions<DemoOptions> DemoOptions
@inject IOptions<DevBuildOptions> DevBuild
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AuditRecorder AuditRecorder
@inject IAuthorizationService AuthorizationService
@inject ILogger<MainLayout> Logger

<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<DevBuildBanner />
<MudLayout>
    <MudAppBar Elevation="1">
        <div class="d-flex align-center">
            <a href="/dashboard">
                <img src="@Assets["logo.svg"]" alt="dotMARC Logo" height="48" />
            </a>
        </div>
        <AuthorizeView>
            <Authorized>
                <MudButton Href="/dashboard" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Dashboard">Dashboard</MudButton>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="AlertsView">
            <MudButton Href="/alerts" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Notifications">Alerts</MudButton>
        </AuthorizeView>
        <MudMenu Label="Manage" Color="Color.Inherit" EndIcon="@Icons.Material.Filled.ExpandMore">
            <AuthorizeView Policy="DomainsWrite">
                <MudMenuItem Href="/domains" Icon="@Icons.Material.Filled.Language">Domains</MudMenuItem>
            </AuthorizeView>
            <AuthorizeView Policy="GroupsOrTagsWrite">
                <MudMenuItem Href="/groups" Icon="@Icons.Material.Filled.GroupWork">Groups</MudMenuItem>
            </AuthorizeView>
            <AuthorizeView Policy="DnsPushManage">
                <MudMenuItem Href="/dns-push/settings" Icon="@Icons.Material.Filled.CloudSync">DNS push settings</MudMenuItem>
            </AuthorizeView>
            <AuthorizeView Policy="AlertsView">
                @if (AlertRuleAccess.MayView(context.User))
                {
                    <MudMenuItem Href="/alerts/rules" Icon="@Icons.Material.Filled.Rule">Alert rules</MudMenuItem>
                }
            </AuthorizeView>
            <AuthorizeView Policy="AlertsManage">
                <MudMenuItem Href="/alerts/settings" Icon="@Icons.Material.Filled.NotificationsActive">Alert settings</MudMenuItem>
                <MudMenuItem Href="/psa/settings" Icon="@Icons.Material.Filled.ConfirmationNumber">PSA settings</MudMenuItem>
            </AuthorizeView>
            <AuthorizeView Policy="AccessManage">
                <MudMenuItem Href="/access" Icon="@Icons.Material.Filled.ManageAccounts">Access</MudMenuItem>
                <MudMenuItem Href="/branding/settings" Icon="@Icons.Material.Filled.Palette">Branding</MudMenuItem>
            </AuthorizeView>
            <AuthorizeView Policy="LogsView">
                <MudMenuItem Href="/logs" Icon="@Icons.Material.Filled.Article">Server logs</MudMenuItem>
            </AuthorizeView>
            <AuthorizeView Policy="AuditView">
                <MudMenuItem Href="/audit" Icon="@Icons.Material.Filled.History">Audit log</MudMenuItem>
            </AuthorizeView>
            <AuthorizeView Policy="ReportsManage">
                <MudMenuItem Href="/reports/settings" Icon="@Icons.Material.Filled.Email">Email &amp; reports</MudMenuItem>
            </AuthorizeView>
            @if (_showBaselines)
            {
                <MudMenuItem Href="/baselines" Icon="@Icons.Material.Filled.Rule">Baselines</MudMenuItem>
            }
        </MudMenu>
        @if (DemoOptions.Value.Enabled)
        {
            <AuthorizeView>
                <Authorized>
                    <MudMenu Label="Demo" Color="Color.Warning" EndIcon="@Icons.Material.Filled.ExpandMore">
                        <MudMenuItem Disabled="true">Viewing as @context.User.Identity?.Name</MudMenuItem>
                        <MudMenuItem Href="/demo" Icon="@Icons.Material.Filled.SwitchAccount">Switch persona</MudMenuItem>
                    </MudMenu>
                </Authorized>
            </AuthorizeView>
        }
        <MudSpacer />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="ToggleDarkModeAsync" title="Toggle dark mode" />
        <AuthorizeView>
            <Authorized>
                <form method="post" action="/signout" class="d-inline">
                    <AntiforgeryToken />
                    <MudIconButton ButtonType="ButtonType.Submit" Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" title="Sign out" />
                </form>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
            @Body
        </MudContainer>
        <footer class="dotmarc-footer">
            <MudContainer MaxWidth="MaxWidth.Large">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    © @_currentYear dotMARC. Free software licensed under the
                    <MudLink Href="https://dotmarc.app/license" Target="_blank" Color="Color.Primary">GNU Affero General Public License v3.0</MudLink>.
                    @if (_versionLabel.ReleaseNotesUrl is { } releaseNotesUrl)
                    {
                        <MudLink Href="@releaseNotesUrl" Target="_blank" Color="Color.Primary">@_versionLabel.Text</MudLink>
                    }
                    else
                    {
                        <span>@_versionLabel.Text</span>
                    }.
                    <MudLink Href="https://github.com/homotechsual/dotMARC" Target="_blank" Color="Color.Primary">Source code</MudLink>.
                    <SponsorLink />
                </MudText>
            </MudContainer>
        </footer>
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _theme = DotMarc.Portal.PortalTheme.Default;

    private bool _isDarkMode;
    private readonly int _currentYear = DateTime.UtcNow.Year;
    private static readonly string _version = Assembly.GetExecutingAssembly().GetName().Version?.ToString(3) ?? "0.0.0";
    private VersionLabel _versionLabel = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Read after the first render, not in OnInitializedAsync: JS interop isn't available
            // until the circuit's first render completes.
            var stored = await Js.InvokeAsync<string?>("localStorage.getItem", "dotmarc-dark-mode");
            _isDarkMode = stored == "true";
            StateHasChanged();

            // The first page of the circuit. Recorded here, not in OnInitialized, because this only runs once the
            // circuit is interactive, so a prerender doesn't count the same view twice.
            await RecordPageViewAsync(Navigation.Uri);
        }
    }

    private string? _lastRecordedPath;

    protected override void OnInitialized()
    {
        _versionLabel = DevBuildOptions.VersionLabel(_version, DevBuild.Value.Enabled);
        Navigation.LocationChanged += OnLocationChanged;
    }

    private bool _showBaselines;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await RefreshBaselinesAsync();
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> authenticationState)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await RefreshBaselinesAsync();
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            // A stale menu entry must not end the circuit, so log it and carry on.
            Logger.LogWarning(ex, "Refreshing the Baselines menu entry after a sign-in change failed.");
        }
    }

    private async Task RefreshBaselinesAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _showBaselines = user.Identity?.IsAuthenticated == true
            && (await BaselineTabs.ForAsync(user, AuthorizationService)).Any(tab => tab.Visible);
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs args) => await RecordPageViewAsync(args.Location);

    /// <summary>Best-effort, like every page view: AuditRecorder never throws, and anything else here is caught,
    /// because this runs from an async void event handler where an exception would end the circuit.</summary>
    private async Task RecordPageViewAsync(string uri)
    {
        try
        {
            var path = PageViewPaths.PathOf(uri);
            if (path == _lastRecordedPath)
            {
                return;
            }

            _lastRecordedPath = path;
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            if (user.Identity?.IsAuthenticated != true)
            {
                return;
            }

            var domainName = PageViewPaths.DomainOf(path);
            await AuditRecorder.RecordAsync(AuditLog.Create(AuditActor.FromPrincipal(user), AuditEntryKind.PageView, AuditActions.PageViewed,
                domainName is null ? null : AuditTarget.DomainNamed(domainName), $"Opened {path}"));
        }
        catch (Exception)
        {
            // Nothing to do: a missed page view must not break the page.
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private async Task ToggleDarkModeAsync()
    {
        _isDarkMode = !_isDarkMode;
        await Js.InvokeVoidAsync("localStorage.setItem", "dotmarc-dark-mode", _isDarkMode ? "true" : "false");
    }
}
