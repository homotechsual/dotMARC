@using DotMarc.Data
@using DotMarc.Components.Shared
@using DotMarc.Notifications
@using DotMarc.Psa
@using DotMarc.Psa.Autotask
@using Microsoft.EntityFrameworkCore
@inject AuditActorAccessor AuditActorAccessor
@inject AuditRecorder AuditRecorder
@inject IDbContextFactory<DotMarcDbContext> DbFactory
@inject ISnackbar Snackbar
@inject ILogger<AutotaskSettingsTab> Logger
@inject IAutotaskClient AutotaskClient
@inject AutotaskZoneCache ZoneCache
@inject ISecretStore SecretStoreAccessor

@if (_settings is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4">
        <div class="d-flex align-center justify-space-between flex-wrap mb-2" style="gap: 0.5rem;">
            <MudText Typo="Typo.h5">Autotask</MudText>
            <FieldWithHelp Topic="Autotask tickets" Inline="true" Help="Opens an Autotask ticket for each alert (as set under 'Which alerts create tickets' on Alert settings) and completes it when the alert resolves. dotMARC checks open tickets every few minutes, so a ticket completed in Autotask resolves its alert.">
<MudSwitch @bind-Value="_settings.Enabled" Color="Color.Primary" Label="Enable Autotask tickets" />
</FieldWithHelp>
        </div>

        <MudText Typo="Typo.subtitle1" Class="mt-2 mb-2">Connection</MudText>
        <MudGrid>
            <MudItem xs="12" md="6">
                <FieldWithHelp Topic="Username" Help="The API user's username, an email address. dotMARC finds your Autotask zone (datacentre) from it.">
<MudTextField Label="Username" @bind-Value="_settings.Username" InputType="InputType.Email" Variant="Variant.Outlined" />
</FieldWithHelp>
            </MudItem>
            <MudItem xs="12" md="6">
                <FieldWithHelp Topic="Secret" Help="The API user's secret, generated when you create it. dotMARC keeps it in its secret store and never shows it again, so leave this blank to keep the saved one.">
<MudTextField Label="Secret" @bind-Value="_newSecret" InputType="InputType.Password" Variant="Variant.Outlined"
              HelperText="@(_settings.SecretConfigured ? "A secret is already saved - leave blank to keep it." : "No secret saved yet.")" />
</FieldWithHelp>
            </MudItem>
            <MudItem xs="12" md="6">
                <FieldWithHelp Topic="API tracking identifier" Help="@TrackingIdentifierHelp">
<MudTextField Label="API tracking identifier" @bind-Value="_settings.IntegrationCodeOverride" Variant="Variant.Outlined"
              Required="@(AutotaskSettings.DefaultIntegrationCode.Length == 0)" Placeholder="@(AutotaskSettings.DefaultIntegrationCode.Length > 0 ? "dotMARC's own" : null)" />
</FieldWithHelp>
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex align-start">
                <MudTooltip Text="dotMARC remembers which Autotask zone your API user is in. If Autotask moves your tenant, or you change the API user, clear it so the next call looks the zone up again.">
                    <MudButton Variant="Variant.Outlined" Class="button-beside-input" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ClearZoneAsync">Clear cached zone</MudButton>
                </MudTooltip>
            </MudItem>
        </MudGrid>

        <div class="d-flex align-center justify-space-between flex-wrap mt-6 mb-1" style="gap: 0.5rem;">
            <MudText Typo="Typo.subtitle1">Ticket defaults</MudText>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CloudDownload" Disabled="_loading" OnClick="LoadOptionsAsync">Load options from Autotask</MudButton>
        </div>
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
            Loads the queues, ticket types, issue types, priorities and statuses to choose from. Save the connection first.
        </MudText>
        <MudGrid>
            <MudItem xs="12" md="4">
                <FieldWithHelp Topic="Queue" Help="The queue alert tickets go to.">
<MudSelect T="int?" Label="Queue" @bind-Value="_settings.QueueId" Variant="Variant.Outlined">
                    @foreach (var queue in WithSaved(_picklists?.Queues, _settings.QueueId, _settings.QueueName))
                    {
                        <MudSelectItem T="int?" Value="@((int?)queue.Id)">@queue.Name</MudSelectItem>
                    }
                </MudSelect>
</FieldWithHelp>
            </MudItem>
            <MudItem xs="12" md="4">
                <FieldWithHelp Topic="Ticket type" Help="The ticket type alert tickets are created with, such as Service Request or Alert.">
<MudSelect T="int?" Label="Ticket type" @bind-Value="_settings.TicketTypeId" Variant="Variant.Outlined">
                    @foreach (var ticketType in WithSaved(_picklists?.TicketTypes, _settings.TicketTypeId, _settings.TicketTypeName))
                    {
                        <MudSelectItem T="int?" Value="@((int?)ticketType.Id)">@ticketType.Name</MudSelectItem>
                    }
                </MudSelect>
</FieldWithHelp>
            </MudItem>
            <MudItem xs="12" md="4">
                <FieldWithHelp Topic="Issue type" Help="Optional: the issue type for alert tickets.">
<MudSelect T="int?" Label="Issue type" @bind-Value="_settings.IssueTypeId" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var issueType in WithSaved(_picklists?.IssueTypes, _settings.IssueTypeId, _settings.IssueTypeName))
                    {
                        <MudSelectItem T="int?" Value="@((int?)issueType.Id)">@issueType.Name</MudSelectItem>
                    }
                </MudSelect>
</FieldWithHelp>
            </MudItem>
            <MudItem xs="12" md="4">
                <FieldWithHelp Topic="Priority" Help="The priority alert tickets are created with.">
<MudSelect T="int?" Label="Priority" @bind-Value="_settings.PriorityId" Variant="Variant.Outlined">
                    @foreach (var priority in WithSaved(_picklists?.Priorities, _settings.PriorityId, _settings.PriorityName))
                    {
                        <MudSelectItem T="int?" Value="@((int?)priority.Id)">@priority.Name</MudSelectItem>
                    }
                </MudSelect>
</FieldWithHelp>
            </MudItem>
            <MudItem xs="12" md="4">
                <FieldWithHelp Topic="Closed status" Help="The status that means a ticket is done, Complete unless you've added your own. dotMARC sets it when an alert resolves, and a ticket moved to it resolves the alert.">
<MudSelect T="int?" Label="Closed status" @bind-Value="_settings.ClosedStatusId" Variant="Variant.Outlined">
                    @foreach (var status in WithSaved(_picklists?.Statuses, _settings.ClosedStatusId, _settings.ClosedStatusName))
                    {
                        <MudSelectItem T="int?" Value="@((int?)status.Id)">@status.Name</MudSelectItem>
                    }
                </MudSelect>
</FieldWithHelp>
            </MudItem>
        </MudGrid>

        <div class="d-flex justify-end mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">Save Autotask settings</MudButton>
        </div>
    </MudPaper>

    <PsaIntegrationTestPanel Psa="PsaKind.Autotask" />
}

@code {
    /// <summary>Raised with whether Autotask is switched on in the saved settings, after loading and after saving.</summary>
    [Parameter] public EventCallback<bool> EnabledChanged { get; set; }

    private AutotaskSettings? _settings;
    private string? _newSecret;
    private bool _loading;
    private AutotaskTicketPicklists? _picklists;

    private static string TrackingIdentifierHelp => AutotaskSettings.DefaultIntegrationCode.Length > 0
        ? "dotMARC sends its own API tracking identifier. Enter yours only if you want to use your own."
        : "Required. When you create the API user, choose a tracking identifier (Integration vendor, or Custom (internal integration)) and enter that identifier here.";

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _settings = await AutotaskSettingsService.GetAsync(db);
        await EnabledChanged.InvokeAsync(_settings.Enabled);
    }

    /// <summary>The loaded options, plus the saved choice by its saved name when the lists haven't been loaded, so a
    /// select never shows a bare number.</summary>
    private static IEnumerable<PsaOption> WithSaved(IReadOnlyList<PsaOption>? options, int? savedId, string? savedName)
    {
        options ??= [];
        return savedId is { } id && options.All(option => option.Id != id)
            ? options.Prepend(new PsaOption(id, savedName ?? id.ToString(System.Globalization.CultureInfo.InvariantCulture)))
            : options;
    }

    private async Task LoadOptionsAsync()
    {
        _loading = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _picklists = await AutotaskClient.GetTicketPicklistsAsync(await AutotaskSettingsService.GetAsync(db));

            // Store the saved choices' names now, so they show after a reload without a save. A failure here never stops
            // the options loading.
            try
            {
                await PsaOptionNameCache.RememberAutotaskAsync(db, _picklists);
            }
            catch (Exception exception) when (exception is not OperationCanceledException)
            {
                Logger.LogWarning(exception, "Couldn't store the Autotask option names");
            }

            Snackbar.Add("Loaded queues, ticket types, issue types, priorities and statuses from Autotask.", Severity.Success);
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(exception, "Loading Autotask ticket options failed");
            ShowError($"Couldn't load options from Autotask. {exception.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ClearZoneAsync()
    {
        var cleared = ZoneCache.Clear();
        await AuditRecorder.RecordAsync(AuditLog.Create(await AuditActorAccessor.GetAsync(), AuditEntryKind.Change,
            AuditActions.AutotaskZoneCleared, AuditTarget.Settings("Autotask"), "Cleared the cached Autotask zone"));
        Snackbar.Add(cleared == 0
            ? "There was no cached Autotask zone. The next call looks it up anyway."
            : "Cleared the cached Autotask zone. The next call looks it up again.", Severity.Success);
    }

    private async Task SaveAsync()
    {
        try
        {
            // Keep the names of the chosen options beside their ids, so the selects show names before the lists load.
            _settings!.QueueName = NameOf(_picklists?.Queues, _settings.QueueId) ?? _settings.QueueName;
            _settings.TicketTypeName = NameOf(_picklists?.TicketTypes, _settings.TicketTypeId) ?? _settings.TicketTypeName;
            _settings.IssueTypeName = _settings.IssueTypeId is null ? null : NameOf(_picklists?.IssueTypes, _settings.IssueTypeId) ?? _settings.IssueTypeName;
            _settings.PriorityName = NameOf(_picklists?.Priorities, _settings.PriorityId) ?? _settings.PriorityName;
            _settings.ClosedStatusName = NameOf(_picklists?.Statuses, _settings.ClosedStatusId) ?? _settings.ClosedStatusName;

            await using var db = await DbFactory.CreateDbContextAsync();
            await AutotaskSettingsService.SaveAsync(db, await AuditActorAccessor.GetAsync(), SecretStoreAccessor, _settings, string.IsNullOrWhiteSpace(_newSecret) ? null : _newSecret);
            _newSecret = null;
            Snackbar.Add("Autotask settings saved.", Severity.Success);

            await using var reloadDb = await DbFactory.CreateDbContextAsync();
            _settings = await AutotaskSettingsService.GetAsync(reloadDb);
            await EnabledChanged.InvokeAsync(_settings.Enabled);
        }
        catch (ArgumentException exception)
        {
            ShowError(exception.Message);
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Saving Autotask settings failed");
            Snackbar.Add("Failed to save Autotask settings. Try again.", Severity.Error);
        }
    }

    private static string? NameOf(IReadOnlyList<PsaOption>? options, int? id) => options?.FirstOrDefault(option => option.Id == id)?.Name;

    // Stays on screen until dismissed: these messages can be long.
    private void ShowError(string message) => Snackbar.Add(message, Severity.Error, config => config.RequireInteraction = true);
}
