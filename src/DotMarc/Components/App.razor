@using Microsoft.AspNetCore.Components.Web

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet" />
    <link href="@Assets["app.css"]" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    <Routes @rendermode="PageRenderMode" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script>
        // Firefox refuses to start a drag on an element that isn't natively draggable (e.g. a
        // <td>) unless dataTransfer carries a payload set during dragstart. Blazor Server can't
        // set this from the C# handler - by the time the server round-trip returns, dragstart has
        // already finished and dataTransfer is no longer writable - so it has to happen here.
        // Guarded on types.length === 0 so it never overwrites a payload something else already set.
        document.addEventListener('dragstart', e => {
            if (e.dataTransfer && e.dataTransfer.types.length === 0) {
                try { e.dataTransfer.setData('text/plain', ''); } catch { }
            }
        });

        // Opens the DNS push OAuth round-trip in its own popup instead of navigating the current
        // tab away. A same-tab forceLoad navigation is fragile: some browser extensions that hook
        // page-lifecycle events (spelling/grammar checkers, translators) can interfere with a
        // full-page redirect chain and silently cancel it before it ever reaches the provider. A
        // popup sidesteps that entirely, and the /dns-push/{provider}/callback endpoint closes it
        // itself once the OAuth round trip finishes, posting the outcome back via postMessage
        // rather than redirecting (which would just navigate the popup, not this tab).
        // A provider's sign-in page can cut the popup off from this page (Cloudflare's sends
        // Cross-Origin-Opener-Policy: same-origin). Then window.opener is gone, so the result comes back
        // over a BroadcastChannel too, matched by this push's own id, and the popup looks closed here
        // while the person is still signing in, so "closed" means "waiting", not "cancelled".
        let currentDnsPush = null;
        window.dotMarcOpenDnsPush = (url, dotNetRef) => {
            currentDnsPush?.finish(null);
            const pushId = crypto.randomUUID();
            const popup = window.open(`${url}&pushId=${pushId}`, 'dnsPush', 'width=520,height=680');
            if (!popup) {
                dotNetRef.invokeMethodAsync('OnDnsPushPopupBlocked');
                return;
            }

            const channel = 'BroadcastChannel' in window ? new BroadcastChannel('dotmarc-dns-push') : null;
            let settled = false;
            let giveUp = null;
            const finish = outcome => {
                if (settled) {
                    return;
                }
                settled = true;
                window.removeEventListener('message', onMessage);
                channel?.close();
                clearInterval(poll);
                clearTimeout(giveUp);
                currentDnsPush = null;
                if (outcome !== null) {
                    dotNetRef.invokeMethodAsync('OnDnsPushResult', outcome);
                }
            };
            const accept = data => {
                if (data && typeof data.dnsPush === 'string' && data.pushId === pushId) {
                    finish(data.dnsPush);
                    try { popup.close(); } catch { }
                }
            };
            const onMessage = event => {
                if (event.origin === window.location.origin) {
                    accept(event.data);
                }
            };
            window.addEventListener('message', onMessage);
            if (channel) {
                channel.onmessage = event => accept(event.data);
            }

            // The popup looking closed may only mean the provider cut it off: wait for the result, give the
            // person a Cancel, and give up once the push's signed state has expired anyway.
            const poll = setInterval(() => {
                if (popup.closed) {
                    clearInterval(poll);
                    dotNetRef.invokeMethodAsync('OnDnsPushWaiting');
                    giveUp = setTimeout(() => finish('cancelled'), 6 * 60 * 1000);
                }
            }, 500);
            currentDnsPush = { finish };
        };
        window.dotMarcCancelDnsPush = () => currentDnsPush?.finish('cancelled');
    </script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;

    // Pages marked [ExcludeFromInteractiveRouting] (the ones a signed-out visitor can open) render statically: without
    // a sign-in nobody can open a circuit, so an interactive render would only fail trying.
    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? RenderMode.InteractiveServer : null;
}
