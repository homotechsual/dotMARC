@using Microsoft.AspNetCore.Components.Web

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="app.css" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <HeadOutlet @rendermode="RenderMode.InteractiveServer" />
</head>
<body>
    <Routes @rendermode="RenderMode.InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script>
        // Firefox refuses to start a drag on an element that isn't natively draggable (e.g. a
        // <td>) unless dataTransfer carries a payload set during dragstart. Blazor Server can't
        // set this from the C# handler — by the time the server round-trip returns, dragstart has
        // already finished and dataTransfer is no longer writable — so it has to happen here.
        // Guarded on types.length === 0 so it never overwrites a payload something else already set.
        document.addEventListener('dragstart', e => {
            if (e.dataTransfer && e.dataTransfer.types.length === 0) {
                try { e.dataTransfer.setData('text/plain', ''); } catch { }
            }
        });
    </script>
</body>
</html>
