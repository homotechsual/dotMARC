@* src/DotMarc/Components/Dialogs/DmarcTargetDialog.razor *@
@using DotMarc.Baselines
@using DotMarc.Data
<MudDialog>
    <TitleContent>@Heading</TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">
            Set the policy to measure against. Saving changes dotMARC's expectations and may change below-target alerts; it does not publish DNS or change how mail is handled. Review DNS changes separately.
        </MudText>
        @if (ScopeDescription is not null)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@ScopeDescription</MudText>
        }
        <MudSelect T="DmarcPolicyLevel?" @bind-Value="_policy" Label="Policy (p)" Variant="Variant.Outlined" Class="mb-2">
            <MudSelectItem T="DmarcPolicyLevel?" Value="@((DmarcPolicyLevel?)null)">@UnsetLabel</MudSelectItem>
            <MudSelectItem T="DmarcPolicyLevel?" Value="@((DmarcPolicyLevel?)DmarcPolicyLevel.None)">None</MudSelectItem>
            <MudSelectItem T="DmarcPolicyLevel?" Value="@((DmarcPolicyLevel?)DmarcPolicyLevel.Quarantine)">Quarantine</MudSelectItem>
            <MudSelectItem T="DmarcPolicyLevel?" Value="@((DmarcPolicyLevel?)DmarcPolicyLevel.Reject)">Reject</MudSelectItem>
        </MudSelect>
        <MudSelect T="DmarcPolicyLevel?" @bind-Value="_subdomainPolicy" Label="Subdomain policy (sp)" Variant="Variant.Outlined" Disabled="@(_policy is null)">
            <MudSelectItem T="DmarcPolicyLevel?" Value="@((DmarcPolicyLevel?)null)">Follows p</MudSelectItem>
            <MudSelectItem T="DmarcPolicyLevel?" Value="@((DmarcPolicyLevel?)DmarcPolicyLevel.None)">None</MudSelectItem>
            <MudSelectItem T="DmarcPolicyLevel?" Value="@((DmarcPolicyLevel?)DmarcPolicyLevel.Quarantine)">Quarantine</MudSelectItem>
            <MudSelectItem T="DmarcPolicyLevel?" Value="@((DmarcPolicyLevel?)DmarcPolicyLevel.Reject)">Reject</MudSelectItem>
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save target</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Heading { get; set; } = "";

    /// <summary>The target set at this level, or null when none is set.</summary>
    [Parameter] public DmarcTarget? Current { get; set; }
    [Parameter] public string UnsetLabel { get; set; } = "Inherit group or system target";
    [Parameter] public string? ScopeDescription { get; set; }

    private DmarcPolicyLevel? _policy;
    private DmarcPolicyLevel? _subdomainPolicy;

    protected override void OnInitialized()
    {
        _policy = Current?.Policy;
        _subdomainPolicy = Current?.SubdomainPolicy;
    }

    /// <summary>A null target clears this level; cancelling leaves it unchanged.</summary>
    private void Save()
    {
        DmarcTarget? target = _policy is { } policy ? new DmarcTarget(policy, _subdomainPolicy) : null;
        MudDialog.Close(DialogResult.Ok(new DmarcTargetDialogResult(target)));
    }

    private void Cancel() => MudDialog.Cancel();

    public sealed record DmarcTargetDialogResult(DmarcTarget? Target);
}
