<MudDialog>
    <TitleContent>Unsaved changes</TitleContent>
    <DialogContent>
        <MudText>You have unsaved changes on this page. Leave anyway and discard them?</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Stay</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Confirm">Discard</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();
}
