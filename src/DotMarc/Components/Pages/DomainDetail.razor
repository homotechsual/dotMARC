@page "/domains/{DomainName}"
@page "/domains/{DomainName}/{Tab}"
@attribute [Authorize(Policy = "DomainsView")]
@using DotMarc.Data
@using DotMarc.Reporting
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using DotMarc.IpEnrichment
@using DotMarc.DnsPush
@using DotMarc.Graph
@using DotMarc.Components.Dialogs
@inject IDbContextFactory<DotMarcDbContext> DbFactory
@inject IIpInfoLookup IpLookup
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ILogger<DomainDetail> Logger
@inject IDnsProviderDetector DnsProviderDetector
@inject IEnumerable<IDnsPushProvider> DnsPushProviders
@inject IDmarcTxtLookup DmarcTxtLookup
@inject ITlsrptTxtLookup TlsrptTxtLookup
@inject IOptions<GraphOptions> GraphOptions
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>dotMARC - @DomainName</PageTitle>
<MudButton Href="/dashboard" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-2">Back</MudButton>
<MudText Typo="Typo.h4" Class="mb-4">@DomainName</MudText>

@if (_domain is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudTabs ActivePanelIndex="_activeTabIndex" ActivePanelIndexChanged="OnActiveTabIndexChangedAsync">
        <MudTabPanel Text="Overview">
            <MudGrid Class="my-2">
                <MudItem xs="4"><MudText>Pass rate (30d): <b>@(_passRate is { } r ? r.ToString("P1") : "—")</b></MudText></MudItem>
                <MudItem xs="4"><MudText>Volume (30d): <b>@_totalVolume</b></MudText></MudItem>
                <MudItem xs="4"><MudText>Sources: <b>@_sourceCount</b></MudText></MudItem>
            </MudGrid>
            <MudChart ChartType="ChartType.Line" ChartSeries="@_series" ChartLabels="@_xAxisLabels" Width="100%" Height="250px" />
            <MudPaper Class="pa-4 mt-4" Elevation="1">
                <MudText Typo="Typo.subtitle1" Class="mb-2">DMARC record status</MudText>
                @if (_domain.DmarcCheckStatus == DmarcCheckStatus.NotChecked)
                {
                    <MudText Typo="Typo.body2">Not checked yet.</MudText>
                }
                else
                {
                    <MudChip T="string" Color="@DmarcStatusPresentation.GetColor(_domain.DmarcCheckStatus)" Size="Size.Small">@DmarcStatusPresentation.GetLabel(_domain.DmarcCheckStatus)</MudChip>
                    @if (_domain.DmarcCheckedUtc is { } checkedUtc)
                    {
                        <MudText Typo="Typo.caption" Class="mt-1">Last checked: @checkedUtc.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
                    }
                    @if (!string.IsNullOrWhiteSpace(_domain.DmarcCheckDetail))
                    {
                        <MudText Typo="Typo.body2" Class="mt-1">@_domain.DmarcCheckDetail</MudText>
                    }
                    @if (_domain.DmarcCheckStatus is DmarcCheckStatus.MissingOwnRecord or DmarcCheckStatus.Misconfigured)
                    {
                        <AuthorizeView Policy="DomainsEdit" Context="dmarcPushAuthState">
                            <div class="mt-2">
                                @if (_isPushingDmarcRecord)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudSync"
                                               OnClick="PushDmarcRecordAsync">Push via your DNS provider</MudButton>
                                }
                            </div>
                        </AuthorizeView>
                    }
                }
            </MudPaper>
            @if (!string.IsNullOrWhiteSpace(GraphOptions.Value.TlsrptMailboxAddress))
            {
                <MudPaper Class="pa-4 mt-4" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">TLS reporting record status</MudText>
                    @if (_domain.TlsrptCheckStatus == TlsrptCheckStatus.NotChecked)
                    {
                        <MudText Typo="Typo.body2">Not checked yet.</MudText>
                    }
                    else
                    {
                        <MudChip T="string" Color="@TlsrptStatusPresentation.GetColor(_domain.TlsrptCheckStatus)" Size="Size.Small">@TlsrptStatusPresentation.GetLabel(_domain.TlsrptCheckStatus)</MudChip>
                        @if (_domain.TlsrptCheckedUtc is { } checkedUtc)
                        {
                            <MudText Typo="Typo.caption" Class="mt-1">Last checked: @checkedUtc.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(_domain.TlsrptCheckDetail))
                        {
                            <MudText Typo="Typo.body2" Class="mt-1">@_domain.TlsrptCheckDetail</MudText>
                        }
                        @if (_domain.TlsrptCheckStatus is TlsrptCheckStatus.MissingOwnRecord or TlsrptCheckStatus.Misconfigured)
                        {
                            <AuthorizeView Policy="DomainsEdit">
                                <div class="mt-2">
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudSync"
                                               OnClick="PushTlsrptRecordAsync">Push via your DNS provider</MudButton>
                                </div>
                            </AuthorizeView>
                        }
                    }
                </MudPaper>
            }
        </MudTabPanel>

        <MudTabPanel Text="MTA-STS">
            <AuthorizeView Policy="MtaStsView" Context="viewAuthState">
                <MudPaper Class="pa-4 my-2" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Policy hosting status</MudText>
                    <MudChip T="string" Color="@MtaStsStatusPresentation.GetColor(_domain.MtaStsStatus)" Size="Size.Small">@MtaStsStatusPresentation.GetLabel(_domain.MtaStsStatus)</MudChip>
                    @if (_domain.MtaStsCheckedUtc is { } checkedUtc)
                    {
                        <MudText Typo="Typo.caption" Class="mt-1">Last checked: @checkedUtc.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
                    }
                    @if (!string.IsNullOrWhiteSpace(_domain.MtaStsCheckDetail))
                    {
                        <MudText Typo="Typo.body2" Class="mt-1">@_domain.MtaStsCheckDetail</MudText>
                    }
                    <div class="mt-3">
                        <AuthorizeView Policy="MtaStsManage" Context="manageAuthState">
                            <MudButton Href="/mta-sts" Variant="Variant.Text" Color="Color.Primary">Manage MTA-STS settings</MudButton>
                        </AuthorizeView>
                        <MudLink Href="https://dotmarc.app/docs/mta-sts#status" Target="_blank" Class="ml-2">What do these statuses mean?</MudLink>
                    </div>
                </MudPaper>
            </AuthorizeView>
        </MudTabPanel>

        <MudTabPanel Text="TLS reports">
            @if (_tlsrptReports.Count == 0)
            {
                <MudText Class="my-4">No TLS reports received yet.</MudText>
            }
            else
            {
                <MudTable Items="_tlsrptReports" Hover="true" T="TlsrptReport">
                    <HeaderContent>
                        <MudTh>From</MudTh>
                        <MudTh>Date range</MudTh>
                        <MudTh>Policy</MudTh>
                        <MudTh>Successful sessions</MudTh>
                        <MudTh>Failed sessions</MudTh>
                        <MudTh>Failure details</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.ReportingOrg</MudTd>
                        <MudTd>@context.DateRangeBeginUtc.ToString("d") - @context.DateRangeEndUtc.ToString("d")</MudTd>
                        <MudTd>@string.Join(", ", context.Policies.Select(policy => $"{policy.PolicyType}: {policy.PolicyDomain}"))</MudTd>
                        <MudTd>@context.Policies.Sum(policy => policy.SuccessfulSessionCount)</MudTd>
                        <MudTd>@context.Policies.Sum(policy => policy.FailedSessionCount)</MudTd>
                        <MudTd>@string.Join(", ", context.Policies.SelectMany(policy => policy.FailureDetails).Select(detail => $"{detail.ResultType} ({detail.FailedSessionCount})"))</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>

        <MudTabPanel Text="Sources">
            <MudTable Items="_sources" Hover="true" T="SourceRow">
                <HeaderContent>
                    <MudTh>Source IP</MudTh>
                    <MudTh>Volume</MudTh>
                    <MudTh>SPF</MudTh>
                    <MudTh>DKIM</MudTh>
                    <MudTh>Disposition</MudTh>
                    <MudTh>Owner</MudTh>
                    <MudTh>Country</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.SourceIp</MudTd>
                    <MudTd>@context.Volume</MudTd>
                    <MudTd>@context.SpfResult</MudTd>
                    <MudTd>@context.DkimResult</MudTd>
                    <MudTd>@context.Disposition</MudTd>
                    <MudTd>
                        @if (context.IsEnrichmentPending)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        }
                        else
                        {
                            @(context.Organization ?? "—")
                        }
                    </MudTd>
                    <MudTd>@(context.IsEnrichmentPending ? "" : (context.Country ?? "—"))</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Raw reports">
            <MudTable Items="_reports" Hover="true" T="Report">
                <HeaderContent>
                    <MudTh>From</MudTh>
                    <MudTh>Date range</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ReportingOrg</MudTd>
                    <MudTd>@context.DateRangeBeginUtc.ToString("d") – @context.DateRangeEndUtc.ToString("d")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
}

@code {
    private static readonly SemaphoreSlim EnrichmentThrottle = new(4);
    private static readonly string[] TabSlugs = ["overview", "mta-sts", "tls-reports", "sources", "raw-reports"];

    [Parameter] public string DomainName { get; set; } = "";
    [Parameter] public string? Tab { get; set; }

    private int _activeTabIndex;
    private Domain? _domain;
    private List<Report> _reports = [];
    private List<TlsrptReport> _tlsrptReports = [];
    private List<SourceRow> _sources = [];
    private double? _passRate;
    private int _totalVolume;
    private int _sourceCount;
    private List<ChartSeries<double>> _series = [];
    private string[] _xAxisLabels = [];
    private bool _isPushingDmarcRecord;
    private DotNetObjectReference<DomainDetail>? _dotNetRef;

    public void Dispose() => _dotNetRef?.Dispose();

    protected override void OnParametersSet()
    {
        var index = Tab is null ? -1 : Array.IndexOf(TabSlugs, Tab.ToLowerInvariant());
        _activeTabIndex = index >= 0 ? index : 0;
    }

    private Task OnActiveTabIndexChangedAsync(int index)
    {
        _activeTabIndex = index;
        var slug = TabSlugs[index >= 0 && index < TabSlugs.Length ? index : 0];
        Navigation.NavigateTo($"/domains/{DomainName}/{slug}", replace: true);
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        // See Dashboard.razor's OnInitializedAsync for why this is a fresh, untracked,
        // factory-created context rather than an injected DotMarcDbContext.
        await using var db = await DbFactory.CreateDbContextAsync();

        var cutoff = DomainStatistics.GetWindowCutoffUtc();
        _domain = await db.Domains
            .AsNoTracking()
            .Include(d => d.Reports.Where(r => r.ReceivedUtc >= cutoff))
            .ThenInclude(r => r.Records)
            .Include(d => d.TlsrptReports.Where(r => r.ReceivedUtc >= cutoff))
            .ThenInclude(r => r.Policies)
            .ThenInclude(policy => policy.FailureDetails)
            .Include(d => d.Groups)
            .SingleOrDefaultAsync(d => d.Name == DomainName);

        if (_domain is null)
        {
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var scopedGroupClaims = authState.User.FindAll(DotMarc.Security.UserAccessClaimsTransformation.ScopedGroupClaimType).ToList();
        if (scopedGroupClaims.Count > 0)
        {
            var scopedGroupIds = scopedGroupClaims.Select(c => int.Parse(c.Value)).ToHashSet();
            var domainGroupIds = _domain.Groups.Select(g => g.Id).ToHashSet();
            if (!domainGroupIds.Overlaps(scopedGroupIds))
            {
                Navigation.NavigateTo("/AccessDenied");
                return;
            }
        }

        _reports = _domain.Reports.OrderByDescending(r => r.ReceivedUtc).ToList();
        _tlsrptReports = _domain.TlsrptReports.OrderByDescending(report => report.ReceivedUtc).ToList();

        _totalVolume = DomainStatistics.GetTotalVolume(_domain.Reports);
        _sourceCount = _domain.Reports.SelectMany(r => r.Records).Select(r => r.SourceIp).Distinct().Count();
        _passRate = DomainStatistics.GetPassRate(_domain.Reports);

        _sources = DomainStatistics.GetSourceAggregates(_domain.Reports)
            .Select(a => new SourceRow(a.SourceIp, a.Volume, a.SpfResult.ToString(), a.DkimResult.ToString(), a.Disposition.ToString()))
            .OrderByDescending(s => s.Volume)
            .ToList();

        // Blazor Server's default prerendering means OnInitializedAsync genuinely runs twice on
        // every cold page load: once for the static prerender pass (no live circuit, no
        // SignalR connection back to the browser yet), once again when the real interactive
        // circuit starts. That's harmless for the plain DB queries above, but the enrichment
        // kick-off below makes real network calls (RDAP lookups) through a process-wide
        // semaphore — running it during the prerender pass would double every lookup and burn a
        // throttle permit that pass can't even display the result of (its renderer is disposed
        // by the time InvokeAsync(StateHasChanged) below would run). RendererInfo.IsInteractive
        // is false during prerendering and true once the interactive circuit is live, so gating
        // on it here confines enrichment to the one execution that can actually show it.
        if (RendererInfo.IsInteractive)
        {
            var ips = _sources.Select(s => s.SourceIp).Distinct().ToList();
            var cachedInfo = await IpInfoService.GetCachedAsync(db, ips, CancellationToken.None);
            var cachedRanges = await IpInfoService.GetCachedRangesAsync(db, CancellationToken.None);
            var nowUtc = DateTimeOffset.UtcNow;

            foreach (var source in _sources)
            {
                cachedInfo.TryGetValue(source.SourceIp, out var info);
                if (info is not null && !IpInfoService.NeedsLookup(info, nowUtc))
                {
                    source.Organization = info.Organization;
                    source.Country = info.Country;
                    source.IsEnrichmentPending = false;
                }
                else if (IpRangeMatcher.FindContaining(cachedRanges, source.SourceIp) is { } range)
                {
                    // A different IP in the same RDAP allocation block was already looked up —
                    // no need to spend another background lookup (or throttle permit) on this
                    // one, or to write it its own IpInfo row; the range cache alone covers it.
                    source.Organization = range.Organization;
                    source.Country = range.Country;
                    source.IsEnrichmentPending = false;
                }
                else
                {
                    _ = EnrichSourceInBackgroundAsync(source);
                }
            }
        }

        // Bucket by day-received (of the report, not the record) rather than the record itself,
        // since ReportRecord has no timestamp of its own — Report.ReceivedUtc is what's available.
        var dailyBuckets = _domain.Reports
            .SelectMany(r => r.Records.Select(rec => new { Date = DateOnly.FromDateTime(r.ReceivedUtc.UtcDateTime), rec.Disposition, rec.MessageCount }))
            .GroupBy(x => x.Date)
            .ToDictionary(g => g.Key, g => new
            {
                None = g.Where(x => x.Disposition == DispositionResult.None).Sum(x => x.MessageCount),
                Quarantine = g.Where(x => x.Disposition == DispositionResult.Quarantine).Sum(x => x.MessageCount),
                Reject = g.Where(x => x.Disposition == DispositionResult.Reject).Sum(x => x.MessageCount)
            });

        var days = Enumerable.Range(0, 30)
            .Select(i => DateOnly.FromDateTime(DateTime.UtcNow.AddDays(-29 + i)))
            .ToList();
        _xAxisLabels = days.Select(d => d.ToString("MM/dd")).ToArray();
        _series =
        [
            new ChartSeries<double> { Name = "Passed (none)", Data = days.Select(d => (double)(dailyBuckets.TryGetValue(d, out var b) ? b.None : 0)).ToArray() },
            new ChartSeries<double> { Name = "Quarantined", Data = days.Select(d => (double)(dailyBuckets.TryGetValue(d, out var b) ? b.Quarantine : 0)).ToArray() },
            new ChartSeries<double> { Name = "Rejected", Data = days.Select(d => (double)(dailyBuckets.TryGetValue(d, out var b) ? b.Reject : 0)).ToArray() }
        ];
    }

    private async Task EnrichSourceInBackgroundAsync(SourceRow source)
    {
        await EnrichmentThrottle.WaitAsync().ConfigureAwait(false);
        try
        {
            var info = await IpInfoService.EnrichAsync(DbFactory, IpLookup, source.SourceIp, CancellationToken.None).ConfigureAwait(false);
            source.Organization = info.Organization;
            source.Country = info.Country;

            if (info.Status != IpLookupStatus.Ok)
            {
                // Operational visibility for the failure mode this feature already hit once
                // (rdap.org's WAF silently rejecting requests): the orchestrating caller logs, not
                // the low-level checker (RdapIpInfoLookup) itself — matches
                // PollingService.RunDmarcCheckCycleAsync's logging around DmarcDnsChecker.
                Logger.LogWarning("RDAP lookup for source IP {SourceIp} did not resolve to Ok (status: {Status}).", source.SourceIp, info.Status);
            }
        }
        catch (Exception ex)
        {
            // Leave Organization/Country null — the row settles into an "unknown" state below
            // rather than spinning forever. EnrichAsync itself already turns network failures
            // into a persisted LookupFailed IpInfo row; this catch only guards against something
            // unexpected in that path taking down the whole fire-and-forget task.
            Logger.LogWarning(ex, "Background RDAP enrichment for source IP {SourceIp} threw unexpectedly.", source.SourceIp);
        }
        finally
        {
            EnrichmentThrottle.Release();
            source.IsEnrichmentPending = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PushDmarcRecordAsync()
    {
        _isPushingDmarcRecord = true;
        try
        {
            var detected = await DnsProviderDetector.DetectAsync(DomainName, CancellationToken.None);
            var providerKey = detected switch
            {
                DetectedDnsProvider.Cloudflare => "cloudflare",
                DetectedDnsProvider.AzureDns => "azure-dns",
                _ => null
            };
            var pushProvider = await DnsPushProviders.FindConfiguredAsync(providerKey);
            if (pushProvider is null)
            {
                Snackbar.Add("Couldn't find a configured DNS push option for this domain — add the record manually.", Severity.Warning);
                return;
            }

            if (_domain!.DmarcCheckStatus != DmarcCheckStatus.Misconfigured)
            {
                await OpenDnsPushPopupAsync(pushProvider.ProviderKey, _domain.Id, "dmarc");
                return;
            }

            string? existing;
            try
            {
                existing = await DmarcTxtLookup.LookupAsync(DomainName, CancellationToken.None);
            }
            catch (Exception)
            {
                // DmarcTxtLookup.LookupAsync mirrors MxHostsLookup.LookupAsync and doesn't catch
                // internally, so its caller must — matches FetchMxHostsAsync in ManageMtaSts.razor.
                // Left uncaught, an HttpRequestException here would escape a Blazor button-click
                // event handler and take down the whole circuit instead of just this action.
                Snackbar.Add($"Failed to look up {DomainName}'s current DMARC record. Try again.", Severity.Error);
                return;
            }

            var merged = existing is null ? null : DmarcRuaMerge.TryMerge(existing, GraphOptions.Value.MailboxAddress);
            if (existing is null || merged is null)
            {
                Snackbar.Add("Couldn't safely compute a fix for this record — it needs a manual look.", Severity.Warning);
                return;
            }

            var parameters = new DialogParameters<ConfirmDnsRecordPushDialog>
            {
                { x => x.DomainName, DomainName },
                { x => x.ExistingValue, existing },
                { x => x.ProposedValue, merged }
            };
            var dialogRef = await DialogService.ShowAsync<ConfirmDnsRecordPushDialog>("Push DMARC record fix", parameters);
            var result = await dialogRef.Result;
            if (result is { Canceled: false })
            {
                await OpenDnsPushPopupAsync(pushProvider.ProviderKey, _domain.Id, "dmarc");
            }
        }
        finally
        {
            _isPushingDmarcRecord = false;
        }
    }

    private async Task PushTlsrptRecordAsync()
    {
        var detected = await DnsProviderDetector.DetectAsync(DomainName, CancellationToken.None);
        var providerKey = detected switch
        {
            DetectedDnsProvider.Cloudflare => "cloudflare",
            DetectedDnsProvider.AzureDns => "azure-dns",
            _ => null
        };
        var pushProvider = await DnsPushProviders.FindConfiguredAsync(providerKey);
        if (pushProvider is null)
        {
            Snackbar.Add("Couldn't find a configured DNS push option for this domain — add the record manually.", Severity.Warning);
            return;
        }

        await OpenDnsPushPopupAsync(pushProvider.ProviderKey, _domain!.Id, "tlsrpt");
    }

    private async Task OpenDnsPushPopupAsync(string providerKey, int domainId, string target)
    {
        _dotNetRef ??= DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync("dotMarcOpenDnsPush",
            $"/dns-push/{providerKey}/start?domainId={domainId}&target={target}", _dotNetRef);
    }

    [JSInvokable]
    public void OnDnsPushResult(string outcome)
    {
        switch (outcome)
        {
            case "pushed":
                Snackbar.Add("DNS record pushed. It can take a few minutes to propagate.", Severity.Success);
                break;
            case "cancelled":
                break; // user backed out of the provider's consent screen — no need to say anything
            case "zone-not-found":
                Snackbar.Add("Couldn't find that domain in the account you authorized.", Severity.Warning);
                break;
            case "unmergeable":
                Snackbar.Add("Couldn't safely compute a fix for that record — it needs a manual look.", Severity.Warning);
                break;
            case "error":
                Snackbar.Add("The DNS push failed. Try again, or add the record manually.", Severity.Error);
                break;
        }
    }

    [JSInvokable]
    public void OnDnsPushPopupBlocked() =>
        Snackbar.Add("Your browser blocked the pop-up. Allow pop-ups for this site and try again, or add the record manually.", Severity.Warning);

    private sealed class SourceRow(string sourceIp, int volume, string spfResult, string dkimResult, string disposition)
    {
        public string SourceIp { get; } = sourceIp;
        public int Volume { get; } = volume;
        public string SpfResult { get; } = spfResult;
        public string DkimResult { get; } = dkimResult;
        public string Disposition { get; } = disposition;
        public string? Organization { get; set; }
        public string? Country { get; set; }
        public bool IsEnrichmentPending { get; set; } = true;
    }
}
