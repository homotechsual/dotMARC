    /// <summary>Runs PollingService's own per-domain DMARC check on demand, outside its ~24h
    /// schedule - for right after fixing a record, so the status updates without waiting for the
    /// next automatic pass. Reuses the exact same per-domain logic the batch cycle runs (see
    /// PollingService.RunSingleDmarcCheckAsync's remarks) so this can never drift from what the
    /// scheduled check actually does.</summary>
    private async Task RecheckDmarcAsync()
    {
        _isRecheckingDmarc = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var domain = await db.Domains.SingleAsync(d => d.Id == _domain!.Id);
            try
            {
                await PollingService.RunSingleDmarcCheckAsync(domain, DmarcDnsChecker, GraphOptions.Value.MailboxAddress, CancellationToken.None);
            }
            catch (Exception)
            {
                Snackbar.Add($"Failed to check {DomainName}'s DMARC record. Try again.", Severity.Error);
                return;
            }
            await db.SaveChangesAsync();

            _domain!.DmarcCheckStatus = domain.DmarcCheckStatus;
            _domain.DmarcCheckedUtc = domain.DmarcCheckedUtc;
            _domain.DmarcCheckDetail = domain.DmarcCheckDetail;
            _domain.DmarcPolicy = domain.DmarcPolicy;
            _domain.DmarcSubdomainPolicy = domain.DmarcSubdomainPolicy;
            _domain.DmarcPercent = domain.DmarcPercent;
            _domain.DmarcNonExistentSubdomainPolicy = domain.DmarcNonExistentSubdomainPolicy;
            _domain.DmarcTesting = domain.DmarcTesting;
            _domain.DmarcRecords = domain.DmarcRecords;
            _domain.DmarcProblems = domain.DmarcProblems;
            await ResolveTargetAsync(db);
        }
        finally
        {
            _isRecheckingDmarc = false;
        }
    }

