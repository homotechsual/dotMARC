    private Snackbar? _dnsPushWaiting;

    /// <summary>The popup looks closed but may only have been cut off from this page by the provider's sign-in page
    /// (Cloudflare does this), so the result is still on its way. Says so, with a way out if it really was closed.</summary>
    [JSInvokable]
    public void OnDnsPushWaiting()
    {
        _dnsPushWaiting = Snackbar.Add("Finish signing in to your DNS provider in the window that opened. dotMARC is waiting for the result.", Severity.Info, config =>
        {
            config.RequireInteraction = true;
            config.Action = "Cancel";
            config.OnClick = async _ => await JSRuntime.InvokeVoidAsync("dotMarcCancelDnsPush");
        });
    }

    [JSInvokable]
    public void OnDnsPushResult(string outcome)
    {
        if (_dnsPushWaiting is not null)
        {
            Snackbar.Remove(_dnsPushWaiting);
            _dnsPushWaiting = null;
        }

        switch (outcome)
        {
            case "pushed":
                Snackbar.Add("DNS record pushed. It can take a few minutes to propagate.", Severity.Success);
                break;
            case "cancelled":
                break; // user backed out of the provider's consent screen - no need to say anything
            case "zone-not-found":
                Snackbar.Add("Couldn't find that domain in the account you authorized.", Severity.Warning);
                break;
            case "unmergeable":
                Snackbar.Add("Couldn't safely compute a fix for that record - it needs a manual look.", Severity.Warning);
                break;
            case "replace-failed":
                // Distinct from the generic "error" case on purpose: this specific outcome means
                // the old record was already deleted before the replacement failed to create, so
                // the domain now has NO record at that name - worse than before the push, not just
                // "nothing happened." RequireInteraction keeps it on screen instead of
                // auto-dismissing like the other toasts.
                Snackbar.Add(
                    "The old record was deleted, but creating its replacement failed - this domain now has no record at that name and needs manual attention.",
                    Severity.Error, config => config.RequireInteraction = true);
                break;
            case "error":
                Snackbar.Add("The DNS push failed. Try again, or add the record manually.", Severity.Error);
                break;
            case "spf-changed":
                Snackbar.Add("SPF changed since you opened the editor. Reopen it to start from the current record.", Severity.Warning);
                break;
            case "spf-too-many-lookups":
                Snackbar.Add("This record would need more than 10 DNS lookups, so it wasn't pushed.", Severity.Warning);
                break;
            case "spf-duplicate":
                Snackbar.Add(
                    "The new SPF record was added, but the old one couldn't be removed, so the domain now has two SPF records and receivers will treat it as having none. Remove the old one in your DNS provider.",
                    Severity.Error, config => config.RequireInteraction = true);
                break;
            case "dmarc-duplicate":
                Snackbar.Add(
                    "The new DMARC record was added, but the old one could not be removed, so the name now has two DMARC records. Receivers ignore DMARC when there are two. Delete the old record at your DNS provider.",
                    Severity.Error, config => config.RequireInteraction = true);
                break;
            case "nothing-to-push":
                Snackbar.Add("DNS already matches, so there was nothing to push.", Severity.Info);
                break;
        }
    }

    [JSInvokable]
    public void OnDnsPushPopupBlocked() =>
        Snackbar.Add("Your browser blocked the pop-up. Allow pop-ups for this site and try again, or add the record manually.", Severity.Warning);

    private sealed class SourceRow(string sourceIp, int volume, string spfResult, string dkimResult, string disposition, IReadOnlyList<DmarcPolicyOverrideType> overrideReasonTypes, IReadOnlyList<AuthDetailSummary> authDetails, string? inferredReason)
    {
        public string SourceIp { get; } = sourceIp;
        public int Volume { get; } = volume;
        public string SpfResult { get; } = spfResult;
        public string DkimResult { get; } = dkimResult;
        public string Disposition { get; } = disposition;
        public IReadOnlyList<DmarcPolicyOverrideType> OverrideReasonTypes { get; } = overrideReasonTypes;
        public IReadOnlyList<AuthDetailSummary> AuthDetails { get; } = authDetails;
        public string? InferredReason { get; } = inferredReason;
        public string? Organization { get; set; }
        public string? Country { get; set; }
        public bool IsEnrichmentPending { get; set; } = true;
        public DateTimeOffset? FirstSeenUtc { get; set; }
        public int[] DailyVolumes { get; set; } = [];

        // A source whose earliest-ever report (across all history, not just this 30-day window)
        // is itself within the last week is brand new to this domain - the single highest-signal
        // fact for "is this bad volume actually new, or a long-running thing I've already looked
        // at and dismissed." Deliberately tighter than the 30-day reporting window itself, or
        // every source in a domain younger than 30 days would read as "new" forever.
        public bool IsNewSource => FirstSeenUtc is { } firstSeen && firstSeen >= DateTimeOffset.UtcNow.AddDays(-7);

        // Prefer the receiver's own reason when it gave one; otherwise fall back to our
        // extrapolated explanation (marked "Inferred" so it's not mistaken for receiver-reported
        // data) rather than showing nothing at all.
        public string ReasonSummary => OverrideReasonTypes.Count > 0
            ? string.Join(", ", OverrideReasonTypes.Select(t => t.ToString()))
            : InferredReason is { } inferred ? $"Inferred: {inferred}" : "";

        public string AuthDetailTooltip(DmarcAuthMechanism mechanism)
        {
            var matching = AuthDetails.Where(d => d.Mechanism == mechanism).ToList();
            return matching.Count == 0
                ? "No per-mechanism detail was reported for this source."
                : string.Join("; ", matching.Select(d => $"{d.Domain}: {d.Result}"));
        }
    }
}
