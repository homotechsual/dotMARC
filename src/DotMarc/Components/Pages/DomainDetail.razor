    /// <summary>Works out what a push to <paramref name="target"/> would change, the same way the server will once the
    /// person has signed in to their DNS provider, and shows it for review. True when they choose to continue.</summary>
    private async Task<bool> ReviewPushAsync(string target, string providerKey, string lookupFailedMessage)
    {
        var plan = await BuildPlanAsync(target, providerKey, lookupFailedMessage);
        return plan is not null && await DialogService.ConfirmDnsPushAsync(plan);
    }

    /// <summary>For a domain whose DNS provider has no push option configured: shows the records the person has to add by
    /// hand, with copy buttons, instead of just telling them to.</summary>
    private async Task ShowManualRecordsAsync(string target, string? providerKey, string reason, string lookupFailedMessage)
    {
        var plan = await BuildPlanAsync(target, providerKey, lookupFailedMessage);
        if (plan is not null)
        {
            await DialogService.ShowManualDnsRecordsAsync(plan, reason);
        }
    }

    private async Task<DnsChangePlan?> BuildPlanAsync(string target, string? providerKey, string lookupFailedMessage)
    {
        DnsChangePlan plan;
        try
        {
            plan = await ChangeBuilders.Find(target)!.BuildAsync(new DnsPushRequest(_domain!, providerKey ?? string.Empty, _domain!.DnsZone ?? DomainName, null), CancellationToken.None);
        }
        catch (Exception)
        {
            Snackbar.Add(lookupFailedMessage, Severity.Error);
            return null;
        }

        if (plan.Refusal is not null)
        {
            Snackbar.Add(plan.Refusal switch
            {
                "unmergeable" => "Couldn't safely compute a fix for this record - it needs a manual look.",
                "nothing-to-push" => "DNS already matches what dotMARC would write, so there's nothing to push.",
                "zone-not-found" => "That DNS provider doesn't host this zone, so dotMARC can't push the record there.",
                _ => lookupFailedMessage,
            }, plan.Refusal == "nothing-to-push" ? Severity.Info : Severity.Warning);
            return null;
        }

        return plan;
    }

