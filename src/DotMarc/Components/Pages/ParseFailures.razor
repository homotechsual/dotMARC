@page "/parse-failures"
@attribute [Authorize(Policy = "DomainsWrite")]
@using DotMarc.Data
@using DotMarc.Components.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<DotMarcDbContext> DbFactory

<AppPageTitle>dotMARC - Message Parse Failures</AppPageTitle>
<MudButton Href="/dashboard" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-2">Back</MudButton>
<MudText Typo="Typo.h4" Class="mb-4">Unparseable messages</MudText>

@if (_failures is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_failures.Count == 0)
{
    <MudText>No unparseable messages - every mailbox message has been parsed successfully.</MudText>
}
else
{
    <MudTable Items="_failures" Hover="true" T="ParseFailure" CustomHeader="true" Filter="FailureMatchesFilters">
        <ToolBarContent>
            <ListToolbar Label="Parse failure controls" SearchLabel="Search message IDs" @bind-Search="_messageIdFilter" @bind-Expanded="_showFilters"
                         FilterCount="@((string.IsNullOrWhiteSpace(_reasonFilter) ? 0 : 1) + (_minAttemptsFilter is null ? 0 : 1) + (string.IsNullOrWhiteSpace(_lastAttemptedFilter) ? 0 : 1))" ClearFilters="ClearFilters">
                <SortContent><ListTableSort TItem="ParseFailure" @ref="_tableSort" /></SortContent>
                <FiltersContent>
                    <MudTextField Label="Reason contains" @bind-Value="_reasonFilter" Immediate="true" />
                    <MudNumericField T="int?" Label="Minimum attempts" @bind-Value="_minAttemptsFilter" Min="0" />
                    <MudTextField Label="Last attempted contains" @bind-Value="_lastAttemptedFilter" Immediate="true" />
                </FiltersContent>
            </ListToolbar>
        </ToolBarContent>
        <HeaderContent>
            <tr>
                <MudTh><MudTableSortLabel SortDirectionChanged="RefreshSort" SortLabel="Message ID" SortBy="new Func<ParseFailure, object>(f => f.GraphMessageId)">Message ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortDirectionChanged="RefreshSort" SortLabel="Reason" SortBy="new Func<ParseFailure, object>(f => f.Reason)">Reason</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortDirectionChanged="RefreshSort" SortLabel="Attempts" SortBy="new Func<ParseFailure, object>(f => f.AttemptCount)">Attempts</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortDirectionChanged="RefreshSort" SortLabel="Last attempted" SortBy="new Func<ParseFailure, object>(f => f.LastAttemptedUtc)">Last attempted</MudTableSortLabel></MudTh>
            </tr>
        </HeaderContent>
        <RowTemplate>
            <MudTd Style="overflow-wrap:anywhere">@context.GraphMessageId</MudTd>
            <MudTd>@context.Reason</MudTd>
            <MudTd>@context.AttemptCount</MudTd>
            <MudTd>@context.LastAttemptedUtc.ToString("g")</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private ListTableSort<ParseFailure>? _tableSort;
    private Task RefreshSort(SortDirection _) => _tableSort?.RefreshAsync() ?? Task.CompletedTask;
    private void ClearFilters() { _reasonFilter = _lastAttemptedFilter = null; _minAttemptsFilter = null; }
    private List<ParseFailure>? _failures;

    private string? _messageIdFilter;
    private string? _reasonFilter;
    private int? _minAttemptsFilter;
    private string? _lastAttemptedFilter;
    private bool _showFilters;

    private bool FailureMatchesFilters(ParseFailure failure)
    {
        if (!string.IsNullOrWhiteSpace(_messageIdFilter) && !failure.GraphMessageId.Contains(_messageIdFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        if (!string.IsNullOrWhiteSpace(_reasonFilter) && !(failure.Reason ?? "").Contains(_reasonFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        if (_minAttemptsFilter is { } minAttempts && failure.AttemptCount < minAttempts)
        {
            return false;
        }
        if (!string.IsNullOrWhiteSpace(_lastAttemptedFilter) && !failure.LastAttemptedUtc.ToString("g").Contains(_lastAttemptedFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        return true;
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _failures = await db.ParseFailures
            .AsNoTracking()
            .OrderByDescending(f => f.LastAttemptedUtc)
            .ToListAsync();
    }
}
