@page "/groups"
@attribute [Authorize(Policy = "GroupsOrTagsWrite")]
@using DotMarc.Psa
@using DotMarc.Data
@using DotMarc.Components.Dialogs
@using DotMarc.Components.Shared
@using DotMarc.Notifications
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject AuditActorAccessor AuditActorAccessor
@inject IDbContextFactory<DotMarcDbContext> DbFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject PsaDirectory PsaDirectory
@inject ILogger<ManageGroups> Logger

<PageTitle>dotMARC - Manage Groups</PageTitle>
<MudButton Href="/dashboard" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-2">Back</MudButton>
<div class="d-flex align-center mb-1">
    <MudText Typo="Typo.h4">Manage groups</MudText>
    <DocsLink Href="https://dotmarc.app/docs/permissions-and-access#granting-access" Text="Groups vs. Tags" Class="ml-2" />
</div>
<MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
    <b>Groups</b> control access: a Viewer can be scoped to just the Groups you put a domain in,
    for external clients who should only see their own domains. <b>Tags</b> are for your own
    filtering on the dashboard and don't affect who can see what.
</MudText>

@foreach (var failed in _psaLists.Where(list => list.FailureReason is not null))
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        @failed.FailureReason Its column shows the saved companies but can't be changed until it loads. Check the
        @failed.Psa.DisplayName() settings under PSA settings, or the server logs, then reload.
    </MudAlert>
}

@if (_loadedLists.Count > 0 && _withoutGroupPsa is { } withoutGroupPsa && (_companiesWithoutGroup.Count > 0 || _loadedLists.Count > 1))
{
    <AuthorizeView Policy="GroupsAdd" Context="addAuthState">
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <div class="d-flex align-center mb-1" style="gap: 1rem;">
                <MudText Typo="Typo.h6">Companies without a group</MudText>
                @if (_loadedLists.Count > 1)
                {
                    <MudSelect T="PsaKind" Value="withoutGroupPsa" ValueChanged="@(psa => { _withoutGroupPsa = psa; RefreshCompaniesWithoutGroup(); })"
                               Dense="true" Margin="Margin.Dense" Style="max-width: 14rem;">
                        @foreach (var list in _loadedLists)
                        {
                            <MudSelectItem T="PsaKind" Value="list.Psa">@list.Psa.DisplayName()</MudSelectItem>
                        }
                    </MudSelect>
                }
                <MudSpacer />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Disabled="@(_creatingFromPsa || _companiesWithoutGroup.Count == 0)"
                           OnClick="CreateAllFromCompaniesAsync">Create all (@_companiesWithoutGroup.Count)</MudButton>
            </div>
            <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">
                These companies exist in @withoutGroupPsa.DisplayName() but not in dotMARC. Creating a group links it to its
                company, so tickets for its domains go to that company once you add the domains to it.
            </MudText>
            @if (_companiesWithoutGroup.Count == 0)
            {
                <MudText Typo="Typo.body2">Every @withoutGroupPsa.DisplayName() company already has a group.</MudText>
            }
            else
            {
            <MudTable Items="_companiesWithoutGroup" T="PsaCompany" Dense="true" Hover="true" CustomHeader="true" Filter="CompanyWithoutGroupMatchesFilters">
                <ToolBarContent>
                    <MudSpacer />
                    <MudButton Variant="@(_showClientFilters ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.FilterList"
                               OnClick="@(() => _showClientFilters = !_showClientFilters)">@(_showClientFilters ? "Hide filters" : "Filters")</MudButton>
                </ToolBarContent>
                <HeaderContent>
                    <tr>
                        <MudTh><MudTableSortLabel SortBy="new Func<PsaCompany, object>(company => company.Name)">@withoutGroupPsa.CompanyLabel()</MudTableSortLabel></MudTh>
                        <MudTh></MudTh>
                    </tr>
                    @if (_showClientFilters)
                    {
                    <tr>
                        <MudTh><MudTextField T="string" @bind-Value="_clientNameFilter" Placeholder="Search" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" /></MudTh>
                        <MudTh></MudTh>
                    </tr>
                    }
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Name</MudTd>
                    <MudTd Style="text-align: right;">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Disabled="_creatingFromPsa"
                                   StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => CreateFromCompanyAsync(withoutGroupPsa, context))">Create group</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
            }
        </MudPaper>
    </AuthorizeView>
}

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-2">Groups</MudText>
    <AuthorizeView Policy="GroupsAdd">
        <MudGrid>
            <MudItem xs="9">
                <MudTextField @bind-Value="_newGroupName" Label="Group name" Placeholder="Client A" Variant="Variant.Outlined"
                              Error="@(_addGroupError is not null)" ErrorText="@_addGroupError" Immediate="true" />
            </MudItem>
            <MudItem xs="3" Class="d-flex align-start">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="button-beside-input" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddGroupAsync">Add group</MudButton>
            </MudItem>
        </MudGrid>
    </AuthorizeView>

    @if (_groups is { Count: > 0 })
    {
        <MudTable Items="_groups" Hover="true" T="GroupRow" Class="mt-4" CustomHeader="true" Filter="GroupMatchesFilters">
            <ToolBarContent>
                <MudSpacer />
                <MudButton Variant="@(_showGroupFilters ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.FilterList"
                           OnClick="@(() => _showGroupFilters = !_showGroupFilters)">@(_showGroupFilters ? "Hide filters" : "Filters")</MudButton>
            </ToolBarContent>
            <HeaderContent>
                <tr>
                    <MudTh><MudTableSortLabel SortBy="new Func<GroupRow, object>(g => g.Name)">Name</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<GroupRow, object>(g => g.DomainCount)">Domains</MudTableSortLabel></MudTh>
                    @foreach (var list in _psaLists)
                    {
                        <MudTh>@list.Psa.CompanyLabel()</MudTh>
                    }
                    @if (_psaLists.Count > 0)
                    {
                        <MudTh>Ticket rules</MudTh>
                    }
                    <MudTh>Portal branding</MudTh>
                    <MudTh></MudTh>
                </tr>
                @if (_showGroupFilters)
                {
                <tr>
                    <MudTh><MudTextField T="string" @bind-Value="_groupNameFilter" Placeholder="Search" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" /></MudTh>
                    <MudTh><MudNumericField T="int?" @bind-Value="_groupMinDomainsFilter" Placeholder="Min" Margin="Margin.Dense" Min="0" /></MudTh>
                    @foreach (var list in _psaLists)
                    {
                        <MudTh>
                            <MudSelect T="bool?" Value="@_hasCompanyFilters.GetValueOrDefault(list.Psa)" ValueChanged="@(linked => _hasCompanyFilters[list.Psa] = linked)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                                <MudSelectItem T="bool?" Value="true">Linked</MudSelectItem>
                                <MudSelectItem T="bool?" Value="false">Not linked</MudSelectItem>
                            </MudSelect>
                        </MudTh>
                    }
                    @if (_psaLists.Count > 0)
                    {
                        <MudTh>
                            <MudSelect T="bool?" Value="_groupHasTicketOverridesFilter" ValueChanged="@(v => _groupHasTicketOverridesFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                                <MudSelectItem T="bool?" Value="true">Has overrides</MudSelectItem>
                                <MudSelectItem T="bool?" Value="false">No overrides</MudSelectItem>
                            </MudSelect>
                        </MudTh>
                    }
                    <MudTh></MudTh>
                    <MudTh></MudTh>
                </tr>
                }
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <AuthorizeView Policy="GroupsRename" Context="authState">
                        <Authorized>
                            <MudTextField T="string" Value="context.Name" ValueChanged="@(v => RenameGroupAsync(context, v))" />
                        </Authorized>
                        <NotAuthorized>
                            @context.Name
                        </NotAuthorized>
                    </AuthorizeView>
                </MudTd>
                <MudTd>@context.DomainCount</MudTd>
                @foreach (var list in _psaLists)
                {
                    var current = context.Links.FirstOrDefault(link => link.Psa == list.Psa);
                    <MudTd>
                        <PsaCompanyPicker Psa="list.Psa" Companies="list.Companies" Current="current" CompanyChanged="@(company => SetPsaCompanyAsync(context, list.Psa, company))" />
                        @if (current is null && list.Companies is not null)
                        {
                            @foreach (var suggestion in PsaCompanySuggestions.SuggestCompaniesForGroup(list.Psa, context.Name, list.Companies).Take(3))
                            {
                                <MudText Typo="Typo.caption">
                                    Suggested match: @suggestion.Name.
                                    <MudLink OnClick="@(() => SetPsaCompanyAsync(context, list.Psa, suggestion))">Use it</MudLink>
                                </MudText>
                            }
                        }
                    </MudTd>
                }
                @if (_psaLists.Count > 0)
                {
                    <MudTd>
                        @if (context.Links.Count > 0)
                        {
                            <div class="d-flex align-center" style="gap: 0.5rem;">
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Tune" OnClick="@(() => OpenTicketRulesAsync(context))">
                                    Ticket rules
                                </MudButton>
                                @if (_ticketRuleOverrideCounts.TryGetValue(context.Id, out var overrideCount))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@overrideCount @(overrideCount == 1 ? "override" : "overrides")</MudChip>
                                }
                            </div>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Link a PSA company first</MudText>
                        }
                    </MudTd>
                }
                <MudTd>
                    <div class="d-flex align-center" style="gap: 0.5rem;">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Palette" OnClick="@(() => OpenBrandingAsync(context))">
                            Branding
                        </MudButton>
                        @if (_brandedGroupIds.Contains(context.Id))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">Branded</MudChip>
                        }
                    </div>
                </MudTd>
                <MudTd>
                    <AuthorizeView Policy="GroupsDelete" Context="authState">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteGroupAsync(context))" />
                    </AuthorizeView>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    else if (_groups is not null)
    {
        <MudText Typo="Typo.body2" Class="mt-4">No groups yet - add one above.</MudText>
    }
</MudPaper>

<MudPaper Class="pa-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-2">Tags</MudText>
    <AuthorizeView Policy="TagsAdd">
        <MudGrid>
            <MudItem xs="6">
                <MudTextField @bind-Value="_newTagName" Label="Tag name" Placeholder="primary" Variant="Variant.Outlined"
                              Error="@(_addTagError is not null)" ErrorText="@_addTagError" Immediate="true" />
            </MudItem>
            <MudItem xs="3">
                <MudSelect T="Color" @bind-Value="_newTagColor" Label="Color" Variant="Variant.Outlined">
                    @foreach (var color in TagManagementService.AllowedColors)
                    {
                        <MudSelectItem T="Color" Value="color">@color</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="3" Class="d-flex align-start">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="button-beside-input" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddTagAsync">Add tag</MudButton>
            </MudItem>
        </MudGrid>
    </AuthorizeView>

    @if (_tags is { Count: > 0 })
    {
        <MudTable Items="_tags" Hover="true" T="TagRow" Class="mt-4" CustomHeader="true" Filter="TagMatchesFilters">
            <ToolBarContent>
                <MudSpacer />
                <MudButton Variant="@(_showTagFilters ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.FilterList"
                           OnClick="@(() => _showTagFilters = !_showTagFilters)">@(_showTagFilters ? "Hide filters" : "Filters")</MudButton>
            </ToolBarContent>
            <HeaderContent>
                <tr>
                    <MudTh>Preview</MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<TagRow, object>(t => t.Name)">Name</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<TagRow, object>(t => t.Color.ToString())">Color</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<TagRow, object>(t => t.DomainCount)">Domains</MudTableSortLabel></MudTh>
                    <MudTh></MudTh>
                </tr>
                @if (_showTagFilters)
                {
                <tr>
                    <MudTh></MudTh>
                    <MudTh><MudTextField T="string" @bind-Value="_tagNameFilter" Placeholder="Search" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" /></MudTh>
                    <MudTh>
                        <MudSelect T="Color?" Value="_tagColorFilter" ValueChanged="@(v => _tagColorFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                            @foreach (var color in TagManagementService.AllowedColors)
                            {
                                <MudSelectItem T="Color?" Value="color">@color</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTh>
                    <MudTh><MudNumericField T="int?" @bind-Value="_tagMinDomainsFilter" Placeholder="Min" Margin="Margin.Dense" Min="0" /></MudTh>
                    <MudTh></MudTh>
                </tr>
                }
            </HeaderContent>
            <RowTemplate>
                <MudTd><MudChip T="string" Color="context.Color">@context.Name</MudChip></MudTd>
                <MudTd>
                    <AuthorizeView Policy="TagsEdit" Context="authState">
                        <Authorized>
                            <MudTextField T="string" Value="context.Name" ValueChanged="@(v => UpdateTagAsync(context, v, context.Color))" />
                        </Authorized>
                        <NotAuthorized>
                            @context.Name
                        </NotAuthorized>
                    </AuthorizeView>
                </MudTd>
                <MudTd>
                    <AuthorizeView Policy="TagsEdit" Context="authState">
                        <Authorized>
                            <MudSelect T="Color" Value="context.Color" ValueChanged="@(v => UpdateTagAsync(context, context.Name, v))">
                                @foreach (var color in TagManagementService.AllowedColors)
                                {
                                    <MudSelectItem T="Color" Value="color">@color</MudSelectItem>
                                }
                            </MudSelect>
                        </Authorized>
                        <NotAuthorized>
                            <MudChip T="string" Color="context.Color">@context.Name</MudChip>
                        </NotAuthorized>
                    </AuthorizeView>
                </MudTd>
                <MudTd>@context.DomainCount</MudTd>
                <MudTd>
                    <AuthorizeView Policy="TagsDelete" Context="authState">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteTagAsync(context))" />
                    </AuthorizeView>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    else if (_tags is not null)
    {
        <MudText Typo="Typo.body2" Class="mt-4">No tags yet - add one above.</MudText>
    }
</MudPaper>

@code {
    private List<GroupRow>? _groups;
    private List<TagRow>? _tags;
    private List<PsaCompanyList> _psaLists = [];
    private List<PsaCompanyList> _loadedLists = [];
    private PsaKind? _withoutGroupPsa;
    private List<PsaCompany> _companiesWithoutGroup = [];
    private bool _creatingFromPsa;
    private Dictionary<int, int> _ticketRuleOverrideCounts = [];
    private HashSet<int> _brandedGroupIds = [];
    private string _newGroupName = "";
    private string? _addGroupError;
    private string _newTagName = "";
    private Color _newTagColor = Color.Primary;
    private string? _addTagError;

    private string? _clientNameFilter;
    private bool _showClientFilters;

    private string? _groupNameFilter;
    private int? _groupMinDomainsFilter;
    private readonly Dictionary<PsaKind, bool?> _hasCompanyFilters = [];
    private bool? _groupHasTicketOverridesFilter;
    private bool _showGroupFilters;

    private string? _tagNameFilter;
    private Color? _tagColorFilter;
    private int? _tagMinDomainsFilter;
    private bool _showTagFilters;

    private bool CompanyWithoutGroupMatchesFilters(PsaCompany company) =>
        string.IsNullOrWhiteSpace(_clientNameFilter) || company.Name.Contains(_clientNameFilter, StringComparison.OrdinalIgnoreCase);

    private bool GroupMatchesFilters(GroupRow row)
    {
        if (!string.IsNullOrWhiteSpace(_groupNameFilter) && !row.Name.Contains(_groupNameFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        if (_groupMinDomainsFilter is { } minDomains && row.DomainCount < minDomains)
        {
            return false;
        }
        foreach (var (psa, filter) in _hasCompanyFilters)
        {
            if (filter is { } linked && row.Links.Any(link => link.Psa == psa) != linked)
            {
                return false;
            }
        }
        if (_groupHasTicketOverridesFilter is { } hasOverrides && _ticketRuleOverrideCounts.ContainsKey(row.Id) != hasOverrides)
        {
            return false;
        }
        return true;
    }

    private bool TagMatchesFilters(TagRow row)
    {
        if (!string.IsNullOrWhiteSpace(_tagNameFilter) && !row.Name.Contains(_tagNameFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        if (_tagColorFilter is { } color && row.Color != color)
        {
            return false;
        }
        if (_tagMinDomainsFilter is { } minDomains && row.DomainCount < minDomains)
        {
            return false;
        }
        return true;
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _groups = await db.Groups
            .AsNoTracking()
            .OrderBy(g => g.Name)
            .Select(g => new GroupRow(g.Id, g.Name, g.Domains.Count, g.PsaCompanyLinks.ToList()))
            .ToListAsync();
        _ticketRuleOverrideCounts = await AlertTicketRuleService.CountOverridesByGroupAsync(db);
        _brandedGroupIds = (await db.GroupBrandings.Select(branding => branding.GroupId).ToListAsync()).ToHashSet();
        _tags = await db.Tags
            .AsNoTracking()
            .OrderBy(t => t.Name)
            .Select(t => new TagRow(t.Id, t.Name, t.Color, t.Domains.Count))
            .ToListAsync();

        await using var psaDb = await DbFactory.CreateDbContextAsync();
        _psaLists = (await PsaDirectory.LoadAsync(psaDb)).ToList();
        _loadedLists = _psaLists.Where(list => list.Companies is not null).ToList();
        if (_withoutGroupPsa is null || _loadedLists.All(list => list.Psa != _withoutGroupPsa))
        {
            _withoutGroupPsa = _loadedLists.FirstOrDefault()?.Psa;
        }

        RefreshCompaniesWithoutGroup();
    }

    private void RefreshCompaniesWithoutGroup()
    {
        var list = _loadedLists.FirstOrDefault(candidate => candidate.Psa == _withoutGroupPsa);
        _companiesWithoutGroup = list?.Companies is { } companies && _groups is not null
            ? PsaCompanySuggestions.CompaniesWithoutGroup(list.Psa, companies,
                _groups.Select(group => new GroupSummary(group.Name, group.Links.FirstOrDefault(link => link.Psa == list.Psa)?.CompanyId))).ToList()
            : [];
    }

    private async Task CreateFromCompanyAsync(PsaKind psa, PsaCompany company)
    {
        _creatingFromPsa = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await GroupManagementService.AddGroupAsync(db, await AuditActorAccessor.GetAsync(), company.Name, CancellationToken.None, (psa, company));
            if (result == GroupManagementService.AddGroupResult.Added)
            {
                Snackbar.Add($"Created group {company.Name}.", Severity.Success);
                OfferMatchingLinks(psa, company);
            }
            else
            {
                Snackbar.Add($"A group named {company.Name} already exists.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Creating a group from {Psa} company {CompanyName} failed", psa.DisplayName(), company.Name);
            Snackbar.Add($"Failed to create {company.Name}. Try again.", Severity.Error);
        }
        finally
        {
            _creatingFromPsa = false;
        }

        await LoadAsync();
    }

    /// <summary>When a company with the same name exists in another PSA, offers to link the new group to it there too.</summary>
    private void OfferMatchingLinks(PsaKind createdFrom, PsaCompany company)
    {
        var key = PsaCompanySuggestions.LooseKey(company.Name);
        foreach (var other in _loadedLists.Where(list => list.Psa != createdFrom))
        {
            if (other.Companies!.FirstOrDefault(candidate => PsaCompanySuggestions.LooseKey(candidate.Name) == key) is not { } match)
            {
                continue;
            }

            Snackbar.Add($"{other.Psa.DisplayName()} has a company called {match.Name}.", Severity.Info, options =>
            {
                options.Action = $"Link it";
                options.OnClick = async _ =>
                {
                    var created = _groups?.FirstOrDefault(group => string.Equals(group.Name, company.Name, StringComparison.OrdinalIgnoreCase));
                    if (created is not null)
                    {
                        await SetPsaCompanyAsync(created, other.Psa, match);
                    }
                };
            });
        }
    }

    private async Task CreateAllFromCompaniesAsync()
    {
        if (_withoutGroupPsa is not { } psa)
        {
            return;
        }

        var companies = _companiesWithoutGroup.ToList();
        var confirmed = await DialogService.ShowMessageBoxAsync(
            $"Create groups from {psa.DisplayName()}",
            $"Create {companies.Count} group{(companies.Count == 1 ? "" : "s")}, one for each {psa.DisplayName()} company listed, each linked to its company?",
            yesText: "Create", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _creatingFromPsa = true;
        var created = 0;
        var skipped = 0;
        try
        {
            foreach (var company in companies)
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                var result = await GroupManagementService.AddGroupAsync(db, await AuditActorAccessor.GetAsync(), company.Name, CancellationToken.None, (psa, company));
                if (result == GroupManagementService.AddGroupResult.Added)
                {
                    created++;
                }
                else
                {
                    skipped++;
                }
            }

            Snackbar.Add(skipped == 0
                ? $"Created {created} group{(created == 1 ? "" : "s")}."
                : $"Created {created}, skipped {skipped} whose name already exists.", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Creating groups from {Psa} companies failed after {Created} were created", psa.DisplayName(), created);
            Snackbar.Add($"Created {created} before something went wrong. Try again for the rest.", Severity.Error);
        }
        finally
        {
            _creatingFromPsa = false;
        }

        await LoadAsync();
    }

    private async Task AddGroupAsync()
    {
        _addGroupError = null;
        GroupManagementService.AddGroupResult result;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            result = await GroupManagementService.AddGroupAsync(db, await AuditActorAccessor.GetAsync(), _newGroupName, CancellationToken.None);
        }
        catch (Exception)
        {
            _addGroupError = "Something went wrong adding the group. Try again.";
            return;
        }

        _addGroupError = result switch
        {
            GroupManagementService.AddGroupResult.InvalidName => "Enter a group name.",
            GroupManagementService.AddGroupResult.AlreadyExists => "A group with that name already exists.",
            _ => null
        };

        if (result == GroupManagementService.AddGroupResult.Added)
        {
            _newGroupName = "";
            await LoadAsync();
        }
    }

    private async Task RenameGroupAsync(GroupRow row, string newName)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await GroupManagementService.RenameGroupAsync(db, await AuditActorAccessor.GetAsync(), row.Id, newName, CancellationToken.None);
            var error = result switch
            {
                GroupManagementService.AddGroupResult.InvalidName => "Group name can't be empty.",
                GroupManagementService.AddGroupResult.AlreadyExists => "A group with that name already exists.",
                _ => null
            };
            if (error is not null)
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add($"Failed to rename {row.Name}. Try again.", Severity.Error);
        }
        await LoadAsync();
    }

    private async Task DeleteGroupAsync(GroupRow row)
    {
        var parameters = new DialogParameters<ConfirmDeleteLabelDialog>
        {
            { x => x.Kind, "group" },
            { x => x.LabelName, row.Name },
            { x => x.DomainCount, row.DomainCount }
        };
        var dialogRef = await DialogService.ShowAsync<ConfirmDeleteLabelDialog>(parameters);
        var result = await dialogRef.Result;

        if (result is { Canceled: false })
        {
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                var removeResult = await GroupManagementService.RemoveGroupAsync(db, await AuditActorAccessor.GetAsync(), row.Id, CancellationToken.None);
                if (removeResult == GroupManagementService.RemoveGroupResult.InUseByApiKey)
                {
                    Snackbar.Add($"Can't remove {row.Name}. An API key is limited to it. Revoke that key on the Access page first.", Severity.Error);
                }
                else if (removeResult == GroupManagementService.RemoveGroupResult.LastGroupOfClientPortal)
                {
                    Snackbar.Add($"Can't remove {row.Name}. It's the only Group a client portal user can see. Change their access on the Access page first.", Severity.Error);
                }

                await LoadAsync();
            }
            catch (Exception)
            {
                Snackbar.Add($"Failed to remove {row.Name}. Try again.", Severity.Error);
            }
        }
    }

    private async Task AddTagAsync()
    {
        _addTagError = null;
        TagManagementService.AddTagResult result;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            result = await TagManagementService.AddTagAsync(db, await AuditActorAccessor.GetAsync(), _newTagName, _newTagColor, CancellationToken.None);
        }
        catch (Exception)
        {
            _addTagError = "Something went wrong adding the tag. Try again.";
            return;
        }

        _addTagError = result switch
        {
            TagManagementService.AddTagResult.InvalidName => "Enter a tag name.",
            TagManagementService.AddTagResult.AlreadyExists => "A tag with that name already exists.",
            TagManagementService.AddTagResult.InvalidColor => "Choose one of the available colors.",
            _ => null
        };

        if (result == TagManagementService.AddTagResult.Added)
        {
            _newTagName = "";
            _newTagColor = Color.Primary;
            await LoadAsync();
        }
    }

