@page "/groups"
@attribute [Authorize(Policy = "GroupsOrTagsWrite")]
@using DotMarc.Data
@using DotMarc.Components.Dialogs
@using DotMarc.Components.Shared
@using DotMarc.Notifications
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<DotMarcDbContext> DbFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IHaloPsaClient HaloPsaClient
@inject ILogger<ManageGroups> Logger

<PageTitle>dotMARC - Manage Groups</PageTitle>
<MudButton Href="/dashboard" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-2">Back</MudButton>
<div class="d-flex align-center mb-1">
    <MudText Typo="Typo.h4">Manage groups</MudText>
    <DocsLink Href="https://dotmarc.app/docs/permissions-and-access#granting-access" Text="Groups vs. Tags" Class="ml-2" />
</div>
<MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
    <b>Groups</b> control access: a Viewer can be scoped to just the Groups you put a domain in,
    for external clients who should only see their own domains. <b>Tags</b> are for your own
    filtering on the dashboard and don't affect who can see what.
</MudText>

@if (_haloLoadFailed)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        Halo clients couldn't be loaded, so Halo suggestions and the Halo Client picker are unavailable.
        Check the HaloPSA settings under Alerts, or the server logs, then reload.
    </MudAlert>
}

@if (_clientsWithoutGroup.Count > 0)
{
    <AuthorizeView Policy="GroupsAdd" Context="addAuthState">
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <div class="d-flex align-center mb-1">
                <MudText Typo="Typo.h6">Halo clients without a group</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Disabled="_creatingFromHalo"
                           OnClick="CreateAllFromHaloAsync">Create all (@_clientsWithoutGroup.Count)</MudButton>
            </div>
            <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">
                These clients exist in Halo but not in dotMARC. Creating a group links it to its Halo client, so
                tickets for its domains go to that client once you add the domains to it.
            </MudText>
            <MudTable Items="_clientsWithoutGroup" T="HaloClient" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Halo client</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Name</MudTd>
                    <MudTd Style="text-align: right;">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Disabled="_creatingFromHalo"
                                   StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => CreateFromHaloAsync(context))">Create group</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </AuthorizeView>
}

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-2">Groups</MudText>
    <AuthorizeView Policy="GroupsAdd">
        <MudGrid>
            <MudItem xs="9">
                <MudTextField @bind-Value="_newGroupName" Label="Group name" Placeholder="Client A" Variant="Variant.Outlined"
                              Error="@(_addGroupError is not null)" ErrorText="@_addGroupError" Immediate="true" />
            </MudItem>
            <MudItem xs="3" Class="d-flex align-start">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="button-beside-input" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddGroupAsync">Add group</MudButton>
            </MudItem>
        </MudGrid>
    </AuthorizeView>

    @if (_groups is { Count: > 0 })
    {
        <MudTable Items="_groups" Hover="true" T="GroupRow" Class="mt-4">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Domains</MudTh>
                @if (_haloConfigured)
                {
                    <MudTh>Halo Client</MudTh>
                    <MudTh>Ticket rules</MudTh>
                }
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <AuthorizeView Policy="GroupsRename" Context="authState">
                        <Authorized>
                            <MudTextField T="string" Value="context.Name" ValueChanged="@(v => RenameGroupAsync(context, v))" />
                        </Authorized>
                        <NotAuthorized>
                            @context.Name
                        </NotAuthorized>
                    </AuthorizeView>
                </MudTd>
                <MudTd>@context.DomainCount</MudTd>
                @if (_haloConfigured)
                {
                    <MudTd>
                        <MudSelect T="int?" Value="context.HaloClientId" ValueChanged="@(id => SetHaloClientIdAsync(context, id))" Clearable="true">
                            @foreach (var haloClient in _haloClients)
                            {
                                <MudSelectItem T="int?" Value="@((int?)haloClient.Id)">@haloClient.Name</MudSelectItem>
                            }
                        </MudSelect>
                        @if (!context.HaloClientId.HasValue)
                        {
                            @foreach (var suggestion in HaloGroupSuggestions.SuggestClientsForGroup(context.Name, _haloClients).Take(3))
                            {
                                <MudText Typo="Typo.caption">
                                    Suggested match: @suggestion.Name.
                                    <MudLink OnClick="@(() => SetHaloClientIdAsync(context, suggestion.Id))">Use it</MudLink>
                                </MudText>
                            }
                        }
                    </MudTd>
                    <MudTd>
                        @if (context.HaloClientId.HasValue)
                        {
                            <div class="d-flex align-center" style="gap: 0.5rem;">
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Tune" OnClick="@(() => OpenTicketRulesAsync(context))">
                                    Ticket rules
                                </MudButton>
                                @if (_ticketRuleOverrideCounts.TryGetValue(context.Id, out var overrideCount))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@overrideCount @(overrideCount == 1 ? "override" : "overrides")</MudChip>
                                }
                            </div>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Set a Halo client first</MudText>
                        }
                    </MudTd>
                }
                <MudTd>
                    <AuthorizeView Policy="GroupsDelete" Context="authState">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteGroupAsync(context))" />
                    </AuthorizeView>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    else if (_groups is not null)
    {
        <MudText Typo="Typo.body2" Class="mt-4">No groups yet - add one above.</MudText>
    }
</MudPaper>

<MudPaper Class="pa-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-2">Tags</MudText>
    <AuthorizeView Policy="TagsAdd">
        <MudGrid>
            <MudItem xs="6">
                <MudTextField @bind-Value="_newTagName" Label="Tag name" Placeholder="primary" Variant="Variant.Outlined"
                              Error="@(_addTagError is not null)" ErrorText="@_addTagError" Immediate="true" />
            </MudItem>
            <MudItem xs="3">
                <MudSelect T="Color" @bind-Value="_newTagColor" Label="Color" Variant="Variant.Outlined">
                    @foreach (var color in TagManagementService.AllowedColors)
                    {
                        <MudSelectItem T="Color" Value="color">@color</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="3" Class="d-flex align-start">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="button-beside-input" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddTagAsync">Add tag</MudButton>
            </MudItem>
        </MudGrid>
    </AuthorizeView>

    @if (_tags is { Count: > 0 })
    {
        <MudTable Items="_tags" Hover="true" T="TagRow" Class="mt-4">
            <HeaderContent>
                <MudTh>Preview</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Color</MudTh>
                <MudTh>Domains</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><MudChip T="string" Color="context.Color">@context.Name</MudChip></MudTd>
                <MudTd>
                    <AuthorizeView Policy="TagsEdit" Context="authState">
                        <Authorized>
                            <MudTextField T="string" Value="context.Name" ValueChanged="@(v => UpdateTagAsync(context, v, context.Color))" />
                        </Authorized>
                        <NotAuthorized>
                            @context.Name
                        </NotAuthorized>
                    </AuthorizeView>
                </MudTd>
                <MudTd>
                    <AuthorizeView Policy="TagsEdit" Context="authState">
                        <Authorized>
                            <MudSelect T="Color" Value="context.Color" ValueChanged="@(v => UpdateTagAsync(context, context.Name, v))">
                                @foreach (var color in TagManagementService.AllowedColors)
                                {
                                    <MudSelectItem T="Color" Value="color">@color</MudSelectItem>
                                }
                            </MudSelect>
                        </Authorized>
                        <NotAuthorized>
                            <MudChip T="string" Color="context.Color">@context.Name</MudChip>
                        </NotAuthorized>
                    </AuthorizeView>
                </MudTd>
                <MudTd>@context.DomainCount</MudTd>
                <MudTd>
                    <AuthorizeView Policy="TagsDelete" Context="authState">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteTagAsync(context))" />
                    </AuthorizeView>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    else if (_tags is not null)
    {
        <MudText Typo="Typo.body2" Class="mt-4">No tags yet - add one above.</MudText>
    }
</MudPaper>

@code {
    private List<GroupRow>? _groups;
    private List<TagRow>? _tags;
    private List<HaloClient> _haloClients = [];
    private List<HaloClient> _clientsWithoutGroup = [];
    private bool _haloLoadFailed;
    private bool _creatingFromHalo;
    private Dictionary<int, int> _ticketRuleOverrideCounts = [];
    private bool _haloConfigured;
    private string _newGroupName = "";
    private string? _addGroupError;
    private string _newTagName = "";
    private Color _newTagColor = Color.Primary;
    private string? _addTagError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _groups = await db.Groups
            .AsNoTracking()
            .OrderBy(g => g.Name)
            .Select(g => new GroupRow(g.Id, g.Name, g.Domains.Count, g.HaloClientId))
            .ToListAsync();
        _ticketRuleOverrideCounts = await AlertTicketRuleService.CountOverridesByGroupAsync(db);
        _tags = await db.Tags
            .AsNoTracking()
            .OrderBy(t => t.Name)
            .Select(t => new TagRow(t.Id, t.Name, t.Color, t.Domains.Count))
            .ToListAsync();

        await using var haloSettingsDb = await DbFactory.CreateDbContextAsync();
        var haloSettings = await HaloPsaSettingsService.GetAsync(haloSettingsDb);
        _haloConfigured = haloSettings.Enabled && haloSettings.ClientSecretConfigured;
        _haloLoadFailed = false;
        _haloClients = [];
        if (_haloConfigured)
        {
            try
            {
                _haloClients = (await HaloPsaClient.ListClientsAsync(haloSettings)).ToList();
            }
            catch (Exception ex)
            {
                _haloLoadFailed = true;
                Logger.LogWarning(ex, "Manage groups could not load the Halo client list");
            }
        }

        _clientsWithoutGroup = HaloGroupSuggestions
            .ClientsWithoutGroup(_haloClients, _groups.Select(group => new GroupSummary(group.Name, group.HaloClientId)))
            .ToList();
    }

    private async Task CreateFromHaloAsync(HaloClient client)
    {
        _creatingFromHalo = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await GroupManagementService.AddGroupAsync(db, client.Name, CancellationToken.None, client.Id);
            if (result == GroupManagementService.AddGroupResult.Added)
            {
                Snackbar.Add($"Created group {client.Name}.", Severity.Success);
            }
            else
            {
                Snackbar.Add($"A group named {client.Name} already exists.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Creating a group from Halo client {ClientName} failed", client.Name);
            Snackbar.Add($"Failed to create {client.Name}. Try again.", Severity.Error);
        }
        finally
        {
            _creatingFromHalo = false;
        }

        await LoadAsync();
    }

    private async Task CreateAllFromHaloAsync()
    {
        var clients = _clientsWithoutGroup.ToList();
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Create groups from Halo",
            $"Create {clients.Count} group{(clients.Count == 1 ? "" : "s")}, one for each Halo client listed, each linked to its client?",
            yesText: "Create", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _creatingFromHalo = true;
        var created = 0;
        var skipped = 0;
        try
        {
            foreach (var client in clients)
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                var result = await GroupManagementService.AddGroupAsync(db, client.Name, CancellationToken.None, client.Id);
                if (result == GroupManagementService.AddGroupResult.Added)
                {
                    created++;
                }
                else
                {
                    skipped++;
                }
            }

            Snackbar.Add(skipped == 0
                ? $"Created {created} group{(created == 1 ? "" : "s")}."
                : $"Created {created}, skipped {skipped} whose name already exists.", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Creating groups from Halo clients failed after {Created} were created", created);
            Snackbar.Add($"Created {created} before something went wrong. Try again for the rest.", Severity.Error);
        }
        finally
        {
            _creatingFromHalo = false;
        }

        await LoadAsync();
    }

    private async Task AddGroupAsync()
    {
        _addGroupError = null;
        GroupManagementService.AddGroupResult result;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            result = await GroupManagementService.AddGroupAsync(db, _newGroupName, CancellationToken.None);
        }
        catch (Exception)
        {
            _addGroupError = "Something went wrong adding the group. Try again.";
            return;
        }

        _addGroupError = result switch
        {
            GroupManagementService.AddGroupResult.InvalidName => "Enter a group name.",
            GroupManagementService.AddGroupResult.AlreadyExists => "A group with that name already exists.",
            _ => null
        };

        if (result == GroupManagementService.AddGroupResult.Added)
        {
            _newGroupName = "";
            await LoadAsync();
        }
    }

    private async Task RenameGroupAsync(GroupRow row, string newName)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await GroupManagementService.RenameGroupAsync(db, row.Id, newName, CancellationToken.None);
            var error = result switch
            {
                GroupManagementService.AddGroupResult.InvalidName => "Group name can't be empty.",
                GroupManagementService.AddGroupResult.AlreadyExists => "A group with that name already exists.",
                _ => null
            };
            if (error is not null)
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add($"Failed to rename {row.Name}. Try again.", Severity.Error);
        }
        await LoadAsync();
    }

    private async Task DeleteGroupAsync(GroupRow row)
    {
        var parameters = new DialogParameters<ConfirmDeleteLabelDialog>
        {
            { x => x.Kind, "group" },
            { x => x.LabelName, row.Name },
            { x => x.DomainCount, row.DomainCount }
        };
        var dialogRef = await DialogService.ShowAsync<ConfirmDeleteLabelDialog>(parameters);
        var result = await dialogRef.Result;

        if (result is { Canceled: false })
        {
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                await GroupManagementService.RemoveGroupAsync(db, row.Id, CancellationToken.None);
                await LoadAsync();
            }
            catch (Exception)
            {
                Snackbar.Add($"Failed to remove {row.Name}. Try again.", Severity.Error);
            }
        }
    }

    private async Task AddTagAsync()
    {
        _addTagError = null;
        TagManagementService.AddTagResult result;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            result = await TagManagementService.AddTagAsync(db, _newTagName, _newTagColor, CancellationToken.None);
        }
        catch (Exception)
        {
            _addTagError = "Something went wrong adding the tag. Try again.";
            return;
        }

        _addTagError = result switch
        {
            TagManagementService.AddTagResult.InvalidName => "Enter a tag name.",
            TagManagementService.AddTagResult.AlreadyExists => "A tag with that name already exists.",
            TagManagementService.AddTagResult.InvalidColor => "Choose one of the available colors.",
            _ => null
        };

        if (result == TagManagementService.AddTagResult.Added)
        {
            _newTagName = "";
            _newTagColor = Color.Primary;
            await LoadAsync();
        }
    }

    private async Task UpdateTagAsync(TagRow row, string newName, Color newColor)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await TagManagementService.UpdateTagAsync(db, row.Id, newName, newColor, CancellationToken.None);
            var error = result switch
            {
                TagManagementService.AddTagResult.InvalidName => "Tag name can't be empty.",
                TagManagementService.AddTagResult.AlreadyExists => "A tag with that name already exists.",
                TagManagementService.AddTagResult.InvalidColor => "Choose one of the available colors.",
                _ => null
            };
            if (error is not null)
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add($"Failed to update {row.Name}. Try again.", Severity.Error);
        }
        await LoadAsync();
    }

    private async Task DeleteTagAsync(TagRow row)
    {
        var parameters = new DialogParameters<ConfirmDeleteLabelDialog>
        {
            { x => x.Kind, "tag" },
            { x => x.LabelName, row.Name },
            { x => x.DomainCount, row.DomainCount }
        };
        var dialogRef = await DialogService.ShowAsync<ConfirmDeleteLabelDialog>(parameters);
        var result = await dialogRef.Result;

        if (result is { Canceled: false })
        {
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                await TagManagementService.RemoveTagAsync(db, row.Id, CancellationToken.None);
                await LoadAsync();
            }
            catch (Exception)
            {
                Snackbar.Add($"Failed to remove {row.Name}. Try again.", Severity.Error);
            }
        }
    }

    private async Task SetHaloClientIdAsync(GroupRow row, int? haloClientId)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await GroupManagementService.SetHaloClientIdAsync(db, row.Id, haloClientId, CancellationToken.None);
        }
        catch (Exception)
        {
            Snackbar.Add($"Failed to update {row.Name}'s Halo client. Try again.", Severity.Error);
        }
        await LoadAsync();
    }

    private async Task OpenTicketRulesAsync(GroupRow row)
    {
        var parameters = new DialogParameters<GroupTicketRulesDialog>
        {
            { dialog => dialog.GroupId, row.Id },
            { dialog => dialog.GroupName, row.Name }
        };
        var dialogRef = await DialogService.ShowAsync<GroupTicketRulesDialog>("Ticket rules", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        await dialogRef.Result;

        // The dialog saves each change itself, so refresh the badge counts when it closes. A failure here must not
        // escape the handler (that would end the user's session); the badges just stay as they were.
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _ticketRuleOverrideCounts = await AlertTicketRuleService.CountOverridesByGroupAsync(db);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't refresh the ticket rule badges. Reload the page to see the latest.", Severity.Warning);
        }
    }

    private sealed record GroupRow(int Id, string Name, int DomainCount, int? HaloClientId);
    private sealed record TagRow(int Id, string Name, Color Color, int DomainCount);
}
