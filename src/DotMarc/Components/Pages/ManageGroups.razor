    private async Task OpenBrandingAsync(GroupRow row)
    {
        var parameters = new DialogParameters<GroupBrandingDialog>
        {
            { dialog => dialog.GroupId, row.Id },
            { dialog => dialog.GroupName, row.Name }
        };
        var dialogRef = await DialogService.ShowAsync<GroupBrandingDialog>("Portal branding", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialogRef.Result is { Canceled: false })
        {
            // Refresh the Branded chips. A failure here must not escape the handler; the chips just stay as they were.
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                _brandedGroupIds = (await db.GroupBrandings.Select(branding => branding.GroupId).ToListAsync()).ToHashSet();
            }
            catch (Exception)
            {
                Snackbar.Add("Couldn't refresh the Branded chips. Reload the page to see the latest.", Severity.Warning);
            }
        }
    }

    private async Task OpenTicketRulesAsync(GroupRow row)
    {
        var parameters = new DialogParameters<GroupTicketRulesDialog>
        {
            { dialog => dialog.GroupId, row.Id },
            { dialog => dialog.GroupName, row.Name }
        };
        var dialogRef = await DialogService.ShowAsync<GroupTicketRulesDialog>("Ticket rules", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        await dialogRef.Result;

        // The dialog saves each change itself, so refresh the badge counts when it closes. A failure here must not
        // escape the handler (that would end the user's session); the badges just stay as they were.
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _ticketRuleOverrideCounts = await AlertTicketRuleService.CountOverridesByGroupAsync(db);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't refresh the ticket rule badges. Reload the page to see the latest.", Severity.Warning);
        }
    }

