    /// <summary>Each Group's schedule frequency, and which Groups' latest scheduled report failed.</summary>
    private async Task LoadReportChipsAsync(DotMarcDbContext db)
    {
        _reportFrequencies = await db.GroupReportSchedules
            .Where(schedule => schedule.Frequency != ReportFrequency.Off)
            .ToDictionaryAsync(schedule => schedule.GroupId, schedule => schedule.Frequency);
        // The latest scheduled delivery is the one with no later scheduled delivery for the same Group.
        _failedReportGroupIds = (await db.ClientReportDeliveries
            .Where(delivery => delivery.Kind == ClientReportDeliveryKind.Scheduled && delivery.Status == ClientReportDeliveryStatus.Failed)
            .Where(delivery => !db.ClientReportDeliveries.Any(later => later.GroupId == delivery.GroupId
                && later.Kind == ClientReportDeliveryKind.Scheduled && later.PeriodStart > delivery.PeriodStart))
            .Select(delivery => delivery.GroupId)
            .ToListAsync()).ToHashSet();
    }

    private void OpenSenderDefaults(GroupRow row) => Navigation.NavigateTo($"/groups/{row.Id}/senders");

    private async Task<bool> MayChangeBaselineAsync(int groupId)
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if (await BaselineAccess.MayChangeGroupAsync(user, AuthorizationService, groupId))
        {
            return true;
        }

        Snackbar.Add("You no longer have access to change that group's DMARC target.", Severity.Warning);
        return false;
    }

    private async Task OpenDomainBaselineAsync(GroupRow row)
    {
        if (!await MayChangeBaselineAsync(row.Id))
        {
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var group = await db.Groups.AsNoTracking().SingleOrDefaultAsync(candidate => candidate.Id == row.Id);
            if (group is null)
            {
                Snackbar.Add("This group no longer exists.", Severity.Error);
                await LoadAsync();
                return;
            }

            var heading = $"DMARC target for {row.Name}";
            var parameters = new DialogParameters<DmarcTargetDialog>
            {
                { dialog => dialog.Heading, heading },
                { dialog => dialog.Current, group.DmarcTarget },
            };
            var dialogRef = await DialogService.ShowAsync<DmarcTargetDialog>(heading, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
            var result = await dialogRef.Result;
            if (result is null || result.Canceled)
            {
                return;
            }

            // The dialog can stay open while permissions change, so check again before saving.
            if (!await MayChangeBaselineAsync(row.Id))
            {
                return;
            }

            var choice = (DmarcTargetDialog.DmarcTargetDialogResult)result.Data!;
            await using var saveDb = await DbFactory.CreateDbContextAsync();
            if (await DmarcTargetService.SetGroupAsync(saveDb, await AuditActorAccessor.GetAsync(), row.Id, choice.Target))
            {
                Snackbar.Add($"Saved the DMARC target for {row.Name}", Severity.Success);
            }
            else
            {
                Snackbar.Add("This group no longer exists.", Severity.Error);
            }
        }
        catch (Exception ex) when (ex is InvalidOperationException or DbUpdateException)
        {
            Logger.LogWarning(ex, "Saving the DMARC target for group {GroupName} failed.", row.Name);
            Snackbar.Add("Could not save the DMARC target. Try again.", Severity.Error);
        }

        await LoadAsync();
    }

