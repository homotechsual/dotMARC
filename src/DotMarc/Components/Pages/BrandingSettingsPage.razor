@page "/branding/settings"
@attribute [Authorize(Policy = "AccessManage")]
@using DotMarc.Components.Portal
@using DotMarc.Components.Shared
@using DotMarc.Data
@using DotMarc.Portal
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AuditActorAccessor AuditActorAccessor
@inject IDbContextFactory<DotMarcDbContext> DbFactory
@inject ISnackbar Snackbar
@inject SponsorLinkState SponsorState

<PageTitle>dotMARC - Branding</PageTitle>
<div class="d-flex align-center mb-1">
    <MudText Typo="Typo.h4">Branding</MudText>
    <DocsLink Href="https://dotmarc.app/docs/client-portal" Text="The client portal and branding" Class="ml-2" />
</div>
<MudText Typo="Typo.body1" Class="mb-4">
    How the client portal looks to your clients, and project support links throughout the app. A Group can override the logo, colours and name from Manage groups.
</MudText>

@if (_settings is not null)
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h5" Class="mb-2">Project support</MudText>
        <MudSwitch T="bool" @bind-Value="_settings.ShowSponsorLink" Color="Color.Primary"
                   Label="Show sponsor link" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Show the GitHub Sponsors link in the staff app and client portal.
            Please support the project if you're hiding the link:
            <MudLink Href="https://github.com/sponsors/homotechsual" Target="_blank" rel="noopener noreferrer">GitHub Sponsors</MudLink>.
        </MudText>
    </MudPaper>
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h5" Class="mb-4">Your brand</MudText>
        <MudGrid>
            <MudItem xs="12" md="6">
                <FieldWithHelp Topic="Product name" Help="Your name for the portal, shown in the app bar when there's no logo, in page titles, and as the heading for a client with several Groups.">
                    <MudTextField Label="Product name" @bind-Value="_settings.ProductName" MaxLength="60" Variant="Variant.Outlined" />
                </FieldWithHelp>
            </MudItem>
            <MudItem xs="12" md="6"></MudItem>

            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Light mode</MudText>
                <BrandColourField Label="Primary colour" Help="Links, buttons and highlights in light mode."
                                  Value="@_settings.PrimaryColour" ValueChanged="@(colour => _settings.PrimaryColour = colour ?? "")"
                                  FallbackColour="@BrandingSettings.DefaultPrimaryColour"
                                  Background="@Preview.LightBackgroundColour" Surface="@Preview.LightSurfaceColour" />
                <div class="mt-4">
                    <BrandColourField Label="Secondary colour" Help="Light mode's app bar, and headings, the pass rate line, footer links and neutral statuses in the portal and reports."
                                      Value="@_settings.SecondaryColour" ValueChanged="@(colour => _settings.SecondaryColour = colour ?? "")"
                                      FallbackColour="@BrandingSettings.DefaultSecondaryColour"
                                      Background="@Preview.LightBackgroundColour" Surface="@Preview.LightSurfaceColour" />
                </div>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Dark mode</MudText>
                <BrandColourField Label="Dark primary colour" Help="Links, buttons and highlights in dark mode. Left automatic, it's the light primary, lightened until it reads on the dark cards."
                                  @bind-Value="_settings.DarkPrimaryColour" DefaultColour="@AutomaticDarkPrimary"
                                  DefaultHint="Automatic, from the light primary" ResetLabel="Use automatic"
                                  Background="@Preview.DarkBackgroundColour" Surface="@Preview.DarkSurfaceColour" />
                <div class="mt-4">
                    <BrandColourField Label="Dark secondary colour" Help="The secondary colour's accents in dark mode. Left automatic, it's the light secondary, lightened until it reads on the dark cards."
                                      @bind-Value="_settings.DarkSecondaryColour" DefaultColour="@AutomaticDarkSecondary"
                                      DefaultHint="Automatic, from the light secondary" ResetLabel="Use automatic"
                                      Background="@Preview.DarkBackgroundColour" Surface="@Preview.DarkSurfaceColour" />
                </div>
            </MudItem>

            <MudItem xs="12" md="6">
                <BrandLogoField Label="Logo" Help="@LogoHelp" @bind-ImageId="_settings.LogoImageId" />
            </MudItem>
            <MudItem xs="12" md="6">
                <BrandLogoField Label="Dark logo" Help="@DarkLogoHelp" @bind-ImageId="_settings.DarkLogoImageId" IsDark="true" />
            </MudItem>

            <MudItem xs="12" md="6">
                <FieldWithHelp Topic="Support email" Help="Shown at the foot of the portal so clients know who to contact.">
                    <MudTextField Label="Support email" @bind-Value="_settings.SupportEmail" Variant="Variant.Outlined" InputType="InputType.Email" />
                </FieldWithHelp>
            </MudItem>
            <MudItem xs="12" md="6">
                <FieldWithHelp Topic="Support URL" Help="Your support site, shown at the foot of the portal. It must start with https://.">
                    <MudTextField Label="Support URL" @bind-Value="_settings.SupportUrl" Variant="Variant.Outlined" InputType="InputType.Url" />
                </FieldWithHelp>
            </MudItem>
            <MudItem xs="12" md="6">
                <FieldWithHelp Topic="Support phone" Help="A support phone number, shown at the foot of the portal.">
                    <MudTextField Label="Support phone" @bind-Value="_settings.SupportPhone" MaxLength="40" Variant="Variant.Outlined" InputType="InputType.Telephone" />
                </FieldWithHelp>
            </MudItem>
            <MudItem xs="12" md="6">
                <FieldWithHelp Topic="Footer text" Help="A short line of plain text at the foot of the portal, such as your company name.">
                    <MudTextField Label="Footer text" @bind-Value="_settings.FooterText" MaxLength="200" Variant="Variant.Outlined" />
                </FieldWithHelp>
            </MudItem>
            <MudItem xs="12">
                <MudExpansionPanels Elevation="0" Outlined="true">
                    <MudExpansionPanel Text="Advanced: backgrounds">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">The portal's page and card colours in each mode. They apply to every client.</MudText>
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <BrandColourField Label="Light page background" Help="Behind everything in light mode." @bind-Value="_settings.LightBackgroundColour"
                                                  DefaultColour="@BrandColours.DefaultLightBackground" DefaultHint="Using the default" ResetLabel="Use the default" TextColour="@BrandColours.LightModeText" />
                                <div class="mt-4">
                                    <BrandColourField Label="Light card background" Help="Cards and panels in light mode." @bind-Value="_settings.LightSurfaceColour"
                                                      DefaultColour="@BrandColours.DefaultLightSurface" DefaultHint="Using the default" ResetLabel="Use the default" TextColour="@BrandColours.LightModeText" />
                                </div>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <BrandColourField Label="Dark page background" Help="Behind everything in dark mode. The app bar is a step darker." @bind-Value="_settings.DarkBackgroundColour"
                                                  DefaultColour="@BrandColours.DefaultDarkBackground" DefaultHint="Using the default" ResetLabel="Use the default" TextColour="@BrandColours.DarkModeText" />
                                <div class="mt-4">
                                    <BrandColourField Label="Dark card background" Help="Cards and panels in dark mode." @bind-Value="_settings.DarkSurfaceColour"
                                                      DefaultColour="@BrandColours.DefaultDarkSurface" DefaultHint="Using the default" ResetLabel="Use the default" TextColour="@BrandColours.DarkModeText" />
                                </div>
                            </MudItem>
                        </MudGrid>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudItem>
        </MudGrid>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Disabled="_busy" OnClick="SaveAsync">Save branding</MudButton>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h5" Class="mb-1">Preview</MudText>
        <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">How a client with one Group sees the portal. Unsaved changes are shown.</MudText>
        <PortalBrandPreview Brand="Preview" />
    </MudPaper>
}

@code {
    /// <summary>Shared with the Group branding dialog, so both explain the two logos the same way.</summary>
    public const string LogoHelp = "For light backgrounds: shown in the portal's app bar when the secondary colour is light. PNG, JPEG or SVG, up to 512 KB. A wide logo about 40 pixels tall works best.";
    public const string DarkLogoHelp = "For dark backgrounds: shown in dark mode, and in light mode when the secondary colour is dark. Leave it empty to use the main logo there too.";

    private BrandingSettings? _settings;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _settings = await db.BrandingSettings.AsNoTracking().SingleAsync();
    }

    // Resolved exactly as a client with one unbranded Group would see it, with the unsaved fields; anything not yet
    // valid falls back, so typing a colour never breaks the preview.
    private ResolvedBrand Preview
    {
        get
        {
            var settings = _settings!;
            static string? Valid(string? colour) => BrandColours.IsValid(colour) ? colour : null;
            var unsaved = new BrandingSettings
            {
                ProductName = string.IsNullOrWhiteSpace(settings.ProductName) ? "dotMARC" : settings.ProductName.Trim(),
                PrimaryColour = Valid(settings.PrimaryColour) ?? BrandingSettings.DefaultPrimaryColour,
                SecondaryColour = Valid(settings.SecondaryColour) ?? BrandingSettings.DefaultSecondaryColour,
                DarkPrimaryColour = Valid(settings.DarkPrimaryColour),
                DarkSecondaryColour = Valid(settings.DarkSecondaryColour),
                LightBackgroundColour = Valid(settings.LightBackgroundColour),
                LightSurfaceColour = Valid(settings.LightSurfaceColour),
                DarkBackgroundColour = Valid(settings.DarkBackgroundColour),
                DarkSurfaceColour = Valid(settings.DarkSurfaceColour),
                LogoImageId = settings.LogoImageId,
                DarkLogoImageId = settings.DarkLogoImageId,
                SupportEmail = settings.SupportEmail,
                SupportUrl = settings.SupportUrl,
                SupportPhone = settings.SupportPhone,
                FooterText = settings.FooterText,
            };
            return PortalBranding.Resolve(unsaved, [new ScopedGroupBrand("Example client", null)]);
        }
    }

    private string AutomaticDarkPrimary => BrandColours.AutomaticDark(Preview.PrimaryColour, Preview.DarkSurfaceColour);
    private string AutomaticDarkSecondary => BrandColours.AutomaticDark(Preview.SecondaryColour, Preview.DarkSurfaceColour);

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await BrandingSettingsService.SaveAsync(db, await AuditActorAccessor.GetAsync(), _settings!);
            await SponsorState.RefreshAsync();
            Snackbar.Add("Branding saved.", Severity.Success);
        }
        catch (ArgumentException exception)
        {
            Snackbar.Add(exception.Message.Split(" (Parameter")[0], Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
