@page "/alerts/settings"
@attribute [Authorize(Policy = "AlertsManage")]
@using DotMarc.Data
@using DotMarc.Components.Shared
@using DotMarc.Notifications
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<DotMarcDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IJSRuntime Js
@inject ILogger<AlertsSettings> Logger
@inject IHaloPsaClient HaloPsaClient
@inject HaloIntegrationTestService HaloTester
@inject HaloWebhookActivity WebhookActivity
@inject ISecretStore SecretStoreAccessor
@inject NavigationManager NavigationManager

<PageTitle>dotMARC - Alert Settings</PageTitle>
<div class="d-flex align-center mb-4">
    <MudText Typo="Typo.h4">Alert settings</MudText>
    <DocsLink Href="https://dotmarc.app/docs/psa-integration" Text="Sync alerts to HaloPSA tickets" Class="ml-2" />
</div>

@if (_settings is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4">
        <MudGrid>
            <MudItem xs="12">
                <MudSwitch @bind-Value="_settings.Enabled" Color="Color.Primary" Label="Enable notifications" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="string" Label="Delivery mode" Variant="Variant.Outlined" @bind-Value="_settings.DeliveryMode">
                    <MudSelectItem Value="@("Teams")">Teams only</MudSelectItem>
                    <MudSelectItem Value="@("Generic")">Generic webhook only</MudSelectItem>
                    <MudSelectItem Value="@("Both")">Teams + generic webhook</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField Label="Teams webhook URL" @bind-Value="_settings.TeamsWebhookUrl" InputType="InputType.Url" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField Label="Generic webhook URL" @bind-Value="_settings.GenericWebhookUrl" InputType="InputType.Url" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudNumericField Label="Missing report threshold (days)" @bind-Value="_settings.MissingReportThresholdDays" Min="1" Max="90" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudNumericField Label="Cooldown (minutes)" @bind-Value="_settings.CooldownMinutes" Min="1" Max="10080" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudNumericField Label="Monitor interval (seconds)" @bind-Value="_settings.MonitorIntervalSeconds" Min="30" Max="86400" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudNumericField Label="Suspicious reject minimum volume" @bind-Value="_settings.SuspiciousRejectMinVolume" Min="1" Max="1000000" Variant="Variant.Outlined"
                                  HelperText="Don't alert below this many rejected/quarantined messages in a domain's 30-day window." />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudNumericField Label="Suspicious reject non-benign %" @bind-Value="_settings.SuspiciousRejectNonBenignPercent" Min="1" Max="100" Variant="Variant.Outlined"
                                  HelperText="Alert when at least this % of rejects/quarantines have no benign override reason (forwarder/mailing list/sampling)." />
            </MudItem>
        </MudGrid>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="SaveAsync">Save settings</MudButton>
    </MudPaper>
}

@if (_haloSettings is not null)
{
    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h5" Class="mb-4">PSA integration (HaloPSA)</MudText>
        <MudGrid>
            <MudItem xs="12">
                <MudSwitch @bind-Value="_haloSettings.Enabled" Color="Color.Primary" Label="Enable HaloPSA ticket sync" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Label="Account name" @bind-Value="_haloSettings.AccountName" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Label="Client ID" @bind-Value="_haloSettings.ClientId" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Label="Auth server URL" @bind-Value="_haloSettings.AuthServerUrl" Placeholder="https://<account>.halopsa.com/auth" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Label="Resource server URL" @bind-Value="_haloSettings.ResourceServerUrl" Placeholder="https://<account>.halopsa.com/api" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Label="Client secret" @bind-Value="_newHaloClientSecret" InputType="InputType.Password" Variant="Variant.Outlined"
                              HelperText="@(_haloSettings.ClientSecretConfigured ? "A secret is already configured - leave blank to keep it." : "No secret configured yet.")" />
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex align-center">
                <MudButton Variant="Variant.Outlined" OnClick="LoadHaloOptionsAsync">Load ticket types / priorities / statuses / agents from Halo</MudButton>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="int?" Label="Ticket type" @bind-Value="_haloSettings.TicketTypeId" Variant="Variant.Outlined">
                    @foreach (var ticketType in _haloTicketTypes)
                    {
                        <MudSelectItem T="int?" Value="@((int?)ticketType.Id)">@ticketType.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="int?" Label="Default priority" @bind-Value="_haloSettings.DefaultPriorityId" Variant="Variant.Outlined">
                    @foreach (var priority in _haloPriorities)
                    {
                        <MudSelectItem T="int?" Value="@((int?)priority.Id)">@priority.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="int?" Label="Closed status" @bind-Value="_haloSettings.ClosedStatusId" Variant="Variant.Outlined">
                    @foreach (var status in _haloStatuses)
                    {
                        <MudSelectItem T="int?" Value="@((int?)status.Id)">@status.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="int" Label="Assign new tickets to" @bind-Value="AssignedAgentSelection" Variant="Variant.Outlined"
                           HelperText="Halo won't close a ticket nobody is assigned to. Pick an agent, or don't assign if Halo assigns tickets itself (round robin, a rule or the ticket type's default).">
                    <MudSelectItem T="int" Value="@DontAssignAgent">Don't assign (Halo decides)</MudSelectItem>
                    @foreach (var agent in _haloAgents)
                    {
                        <MudSelectItem T="int" Value="@agent.Id">@agent.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <div @onclick="CopyWebhookUrlAsync" @onkeydown="OnWebhookUrlKeyDown" style="cursor: copy;" title="Click to copy">
                    <MudTextField Label="Webhook URL" ReadOnly="true" Value="@WebhookUrl" Variant="Variant.Outlined"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                                  HelperText="Click to copy. Point HaloPSA's outbound webhook (on ticket status change) at this URL." />
                </div>
            </MudItem>
            <MudItem xs="12" Class="d-flex align-center" Style="gap: 0.5rem;">
                <MudButton Variant="Variant.Outlined" OnClick="GenerateWebhookSecretAsync">Generate new webhook secret</MudButton>
                @if (_webhookSecretJustGenerated)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning">Not saved yet - click Save PSA settings before copying this URL.</MudText>
                }
            </MudItem>
        </MudGrid>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="SaveHaloSettingsAsync">Save PSA settings</MudButton>
    </MudPaper>

    <MudPaper Class="pa-4 mt-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-2">Test the integration</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">
            Checks the whole lifecycle against your live Halo tenant, using the <b>saved</b> settings: it creates a clearly
            marked test ticket from the most recent alert's details, closes it, then waits for Halo to call the webhook above.
            Real alerts are not touched. This proves Halo's side works; resolving an alert from the webhook is covered by
            automated tests.
        </MudText>

        @if (_testNeedsClient)
        {
            <MudSelect T="int?" @bind-Value="_testHaloClientId" Label="Halo client to test with" Variant="Variant.Outlined" Class="mb-3" Clearable="true">
                @foreach (var testClient in _testClients)
                {
                    <MudSelectItem T="int?" Value="@((int?)testClient.Id)">@testClient.Name</MudSelectItem>
                }
            </MudSelect>
        }

        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="_testRunning" OnClick="RunHaloTestAsync"
                   StartIcon="@Icons.Material.Filled.PlayArrow">@(_testRunning ? "Testing..." : "Run the full test")</MudButton>

        @if (_testSteps.Count > 0)
        {
            <div class="mt-3">
                @foreach (var step in _testSteps)
                {
                    <div class="d-flex align-start mb-2" style="gap: 0.75rem;">
                        @if (step.Outcome == HaloTestOutcome.Running)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        }
                        else
                        {
                            <MudIcon Icon="@StepIcon(step.Outcome)" Color="@StepColor(step.Outcome)" />
                        }
                        <div>
                            <MudText Typo="Typo.subtitle2">@step.Name</MudText>
                            <MudText Typo="Typo.body2" Style="overflow-wrap:anywhere">@step.Detail</MudText>
                        </div>
                    </div>
                }
            </div>
        }

        @if (_testRun is { } finishedRun && !_testRunning)
        {
            @if (finishedRun.Succeeded)
            {
                <MudAlert Severity="Severity.Success" Class="mt-2">The whole lifecycle worked: Halo accepted the ticket, closed it, and called the webhook back.</MudAlert>
            }
            else if (!finishedRun.NeedsClientChoice)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-2">Not everything passed. The step marked with a warning or error above says what to check; the details are also in Manage > Server logs.</MudAlert>
            }
        }

        <MudText Typo="Typo.subtitle2" Class="mt-4">Recent calls to the webhook</MudText>
        @{
            var recentWebhookCalls = WebhookActivity.Recent(5);
        }
        @if (recentWebhookCalls.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">None since the app last started.</MudText>
        }
        else
        {
            @foreach (var call in recentWebhookCalls)
            {
                <MudText Typo="Typo.body2">@call.ReceivedUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC: @DescribeWebhookCall(call)</MudText>
            }
        }
    </MudPaper>
}

@code {
    private NotificationSettings? _settings;
    private HaloPsaSettings? _haloSettings;
    private string? _newHaloClientSecret;
    private List<HaloTicketType> _haloTicketTypes = [];
    private List<HaloTicketStatus> _haloStatuses = [];
    private List<HaloPriority> _haloPriorities = [];
    private List<HaloAgent> _haloAgents = [];

    // MudSelect can't offer a null item, so "don't assign" is 0 here and null on the saved settings.
    private const int DontAssignAgent = 0;

    private int AssignedAgentSelection
    {
        get => _haloSettings?.AssignedAgentId ?? DontAssignAgent;
        set
        {
            if (_haloSettings is not null)
            {
                _haloSettings.AssignedAgentId = value == DontAssignAgent ? null : value;
            }
        }
    }
    private bool _webhookSecretJustGenerated;

    private string WebhookUrl => _haloSettings?.WebhookSecret is { Length: > 0 } secret
        ? $"{NavigationManager.BaseUri.TrimEnd('/')}/integrations/halopsa/webhook/{secret}"
        : "Generate a webhook secret first.";

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _settings = await NotificationSettingsService.GetAsync(db);
        _haloSettings = await HaloPsaSettingsService.GetAsync(db);
    }

    private async Task SaveAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await NotificationSettingsService.SaveAsync(db, _settings!);
            Snackbar.Add("Alert settings saved.", Severity.Success);
        }
        catch (ArgumentException exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private async Task LoadHaloOptionsAsync()
    {
        if (_haloSettings is null)
        {
            return;
        }

        try
        {
            _haloTicketTypes = (await HaloPsaClient.ListTicketTypesAsync(_haloSettings)).ToList();
            _haloStatuses = (await HaloPsaClient.ListStatusesAsync(_haloSettings)).ToList();
            _haloPriorities = (await HaloPsaClient.ListPrioritiesAsync(_haloSettings)).ToList();
            await LoadHaloAgentsAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidDataException)
        {
            // HttpRequestException covers HaloPSA answering with an error (the message carries its
            // OAuth error or status code) and genuine network failures (the connection error).
            // InvalidDataException is a response that wasn't the shape dotMARC expects, and its
            // message quotes the start of what Halo sent.
            Logger.LogWarning(exception, "Loading HaloPSA ticket options failed");
            ShowHaloError($"Couldn't load options from HaloPSA. {exception.Message}");
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "Loading HaloPSA ticket options failed");
            ShowHaloError($"{exception.Message} Save your client secret first, then try again.");
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Loading HaloPSA ticket options failed");
            ShowHaloError("Couldn't load options from HaloPSA. Check the account details and client secret are saved, then try again. See Manage > Server logs for the details.");
        }
    }

    // Listing agents needs a scope the Halo application may not allow. That mustn't undo the lists that
    // did load, so it reports its own problem and leaves "don't assign" and any saved agent in place.
    private async Task LoadHaloAgentsAsync()
    {
        try
        {
            _haloAgents = (await HaloPsaClient.ListAgentsAsync(_haloSettings!)).ToList();
            Snackbar.Add("Loaded ticket types, priorities, statuses and agents from Halo.", Severity.Success);
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidDataException)
        {
            Logger.LogWarning(exception, "Loading HaloPSA agents failed");
            Snackbar.Add("Loaded ticket types, priorities and statuses from Halo.", Severity.Success);
            ShowHaloError($"Couldn't load the Halo agents to assign tickets to, so that list is empty. Allow the read:agents permission on the Halo API application to choose one. {exception.Message}");
        }
    }

    // Stays on screen until dismissed: these messages can be long, and a few seconds isn't enough
    // to read (or copy) them.
    private void ShowHaloError(string message) =>
        Snackbar.Add(message, Severity.Error, config => config.RequireInteraction = true);

    private bool _testRunning;
    private bool _testNeedsClient;
    private int? _testHaloClientId;
    private List<HaloClient> _testClients = [];
    private readonly List<HaloTestStep> _testSteps = [];
    private HaloTestRun? _testRun;

    private async Task RunHaloTestAsync()
    {
        _testRunning = true;
        _testRun = null;
        _testSteps.Clear();
        try
        {
            var progress = new Progress<HaloTestStep>(step =>
            {
                var index = _testSteps.FindIndex(existing => existing.Name == step.Name);
                if (index >= 0)
                {
                    _testSteps[index] = step;
                }
                else
                {
                    _testSteps.Add(step);
                }

                _ = InvokeAsync(StateHasChanged);
            });

            _testRun = await HaloTester.RunAsync(_testHaloClientId, progress, null, CancellationToken.None);

            // The progress callbacks are posted asynchronously, so take the final list from the
            // run itself rather than trusting they have all landed.
            _testSteps.Clear();
            _testSteps.AddRange(_testRun.Steps);
            _testNeedsClient = _testRun.NeedsClientChoice;
            if (_testNeedsClient && _testClients.Count == 0)
            {
                await LoadTestClientsAsync();
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "The HaloPSA integration test failed unexpectedly");
            Snackbar.Add($"The test couldn't run: {exception.Message}", Severity.Error, config => config.RequireInteraction = true);
        }
        finally
        {
            _testRunning = false;
        }
    }

    private async Task LoadTestClientsAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var savedSettings = await HaloPsaSettingsService.GetAsync(db);
            _testClients = (await HaloPsaClient.ListClientsAsync(savedSettings)).OrderBy(c => c.Name).ToList();
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Loading HaloPSA clients for the integration test failed");
            ShowHaloError($"Couldn't load the Halo clients to choose from. {exception.Message}");
        }
    }

    private static string StepIcon(HaloTestOutcome outcome) => outcome switch
    {
        HaloTestOutcome.Passed => Icons.Material.Filled.CheckCircle,
        HaloTestOutcome.Warning => Icons.Material.Filled.Warning,
        HaloTestOutcome.Failed => Icons.Material.Filled.Error,
        _ => Icons.Material.Filled.HelpOutline
    };

    private static Color StepColor(HaloTestOutcome outcome) => outcome switch
    {
        HaloTestOutcome.Passed => Color.Success,
        HaloTestOutcome.Warning => Color.Warning,
        HaloTestOutcome.Failed => Color.Error,
        _ => Color.Default
    };

    private static string DescribeWebhookCall(HaloWebhookReceipt call) => call.Delivery switch
    {
        HaloWebhookDelivery.ClosedStatus => $"ticket #{call.TicketId} closed (status {call.StatusId}){(call.ResolvedAnAlert ? ", resolved an alert" : "")}",
        HaloWebhookDelivery.OtherStatus => $"ticket #{call.TicketId}, status {call.StatusId} (not the closed status, ignored)",
        HaloWebhookDelivery.Unreadable => "the body wasn't understood",
        HaloWebhookDelivery.WrongSecret => "wrong secret (answered 404)",
        _ => "received"
    };

    private Task OnWebhookUrlKeyDown(KeyboardEventArgs args) =>
        args.Key == "Enter" ? CopyWebhookUrlAsync() : Task.CompletedTask;

    private async Task CopyWebhookUrlAsync()
    {
        if (_haloSettings?.WebhookSecret is not { Length: > 0 })
        {
            Snackbar.Add("Generate a webhook secret first.", Severity.Info);
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", WebhookUrl);
        }
        catch (JSException)
        {
            // The clipboard API is only available in a secure context (HTTPS or localhost) and can
            // be refused by the browser, so there has to be a manual way out.
            Snackbar.Add("Couldn't copy automatically. Select the URL and copy it manually.", Severity.Warning);
            return;
        }

        if (_webhookSecretJustGenerated)
        {
            // A URL copied before saving 404s until the secret is persisted (see the note beside
            // the Generate button), so say so at the moment it matters.
            Snackbar.Add("Copied, but this secret isn't saved yet. Click Save PSA settings before using the URL in HaloPSA.", Severity.Warning);
        }
        else
        {
            Snackbar.Add("Webhook URL copied.", Severity.Success);
        }
    }

    private Task GenerateWebhookSecretAsync()
    {
        if (_haloSettings is not null)
        {
            _haloSettings.WebhookSecret = Convert.ToHexString(System.Security.Cryptography.RandomNumberGenerator.GetBytes(32));
            _webhookSecretJustGenerated = true;
        }
        return Task.CompletedTask;
    }

    private async Task SaveHaloSettingsAsync()
    {
        if (_haloSettings is null)
        {
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await HaloPsaSettingsService.SaveAsync(db, SecretStoreAccessor, _haloSettings, string.IsNullOrWhiteSpace(_newHaloClientSecret) ? null : _newHaloClientSecret);
            _newHaloClientSecret = null;
            _webhookSecretJustGenerated = false;
            Snackbar.Add("PSA settings saved.", Severity.Success);

            await using var reloadDb = await DbFactory.CreateDbContextAsync();
            _haloSettings = await HaloPsaSettingsService.GetAsync(reloadDb);
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to save PSA settings. Try again.", Severity.Error);
        }
    }
}
