@page "/alerts/settings"
@attribute [Authorize(Policy = "AlertsManage")]
@using DotMarc.Data
@using DotMarc.Components.Shared
@using DotMarc.Notifications
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AuditActorAccessor AuditActorAccessor
@inject IDbContextFactory<DotMarcDbContext> DbFactory
@inject ISnackbar Snackbar
@inject ILogger<AlertsSettings> Logger
@inject IAlertWebhookClient AlertWebhookClient

<PageTitle>dotMARC - Alert Settings</PageTitle>
<div class="d-flex align-center mb-4">
    <MudText Typo="Typo.h4">Alert settings</MudText>
    <DocsLink Href="https://dotmarc.app/docs/alerts" Text="How alerts work" Class="ml-2" />
</div>

@if (_settings is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4">
        <MudGrid>
            <MudItem xs="12">
                <FieldWithHelp Topic="Enable notifications" Inline="true" Help="Turns alerting on or off. While it's off, dotMARC raises no alerts, so nothing is sent to any channel and no PSA tickets are opened.">
<MudSwitch @bind-Value="_settings.Enabled" Color="Color.Primary" Label="Enable notifications" />
</FieldWithHelp>
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1">Where alerts go</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                    Switch on each channel alerts should reach. PSA tickets are set up under PSA settings.
                </MudText>
            </MudItem>

            @foreach (var channelSetting in AlertChannelSettings)
            {
                <MudItem xs="12" sm="4" md="3" Class="d-flex align-center">
                    <MudSwitch T="bool" Value="channelSetting.GetEnabled(_settings)" ValueChanged="@(enabled => channelSetting.SetEnabled(_settings!, enabled))"
                               Color="Color.Primary" Label="@channelSetting.Name" />
                </MudItem>
                <MudItem xs="12" sm="8" md="7">
                    <FieldWithHelp Topic="@($"{channelSetting.Name} webhook URL")" Help="@channelSetting.Help">
                        <MudTextField T="string" Label="@($"{channelSetting.Name} webhook URL")" Value="channelSetting.GetUrl(_settings)"
                                      ValueChanged="@(url => channelSetting.SetUrl(_settings!, url))" InputType="InputType.Url" Variant="Variant.Outlined" />
                    </FieldWithHelp>
                </MudItem>
                <MudItem xs="12" md="2" Class="d-flex align-center">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Send" Disabled="@(_testingChannel is not null || string.IsNullOrWhiteSpace(channelSetting.GetUrl(_settings)))"
                               OnClick="@(() => SendTestAlertAsync(channelSetting))">@(_testingChannel == channelSetting.Channel ? "Sending..." : "Send test")</MudButton>
                </MudItem>
            }

            <MudItem xs="12" md="6">
                <FieldWithHelp Topic="Missing report threshold" Help="How many days a monitored domain can go without a DMARC aggregate report before a 'Missing DMARC report' alert. Most receivers report daily, so 2 allows for one late day.">
<MudNumericField Label="Missing report threshold (days)" @bind-Value="_settings.MissingReportThresholdDays" Min="1" Max="90" Variant="Variant.Outlined" />
</FieldWithHelp>
            </MudItem>

            <MudItem xs="12" md="6">
                <FieldWithHelp Topic="Cooldown" Help="While an alert is open, dotMARC won't raise it again for this long. After that, if the problem is still there, it's raised again, with a new notification and ticket.">
<MudNumericField Label="Cooldown (minutes)" @bind-Value="_settings.CooldownMinutes" Min="1" Max="10080" Variant="Variant.Outlined" />
</FieldWithHelp>
            </MudItem>

            <MudItem xs="12" md="6">
                <FieldWithHelp Topic="Monitor interval" Help="How often dotMARC checks monitored domains for missing reports, suspicious rejects and DNS health problems, and closes alerts that have cleared.">
<MudNumericField Label="Monitor interval (seconds)" @bind-Value="_settings.MonitorIntervalSeconds" Min="30" Max="86400" Variant="Variant.Outlined" />
</FieldWithHelp>
            </MudItem>

            <MudItem xs="12" md="6">
                <FieldWithHelp Topic="Suspicious reject minimum volume" Help="A 'Suspicious reject activity' alert needs at least this many rejected or quarantined messages in the domain's last 30 days, so a handful of stray messages don't alert.">
<MudNumericField Label="Suspicious reject minimum volume" @bind-Value="_settings.SuspiciousRejectMinVolume" Min="1" Max="1000000" Variant="Variant.Outlined" />
</FieldWithHelp>
            </MudItem>

            <MudItem xs="12" md="6">
                <FieldWithHelp Topic="Suspicious reject non-benign %" Help="Alerts when at least this share of a domain's rejected or quarantined mail has no benign reason given by the receiver (such as a forwarder, mailing list or sampling), which suggests spoofing or a misconfigured sender.">
<MudNumericField Label="Suspicious reject non-benign %" @bind-Value="_settings.SuspiciousRejectNonBenignPercent" Min="1" Max="100" Variant="Variant.Outlined" />
</FieldWithHelp>
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.h6" Class="mt-2">DNS health alerts</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                    Alert when a domain's DNS health check fails. "When it breaks" alerts only once the check has passed at least
                    once, so domains that were never set up stay quiet. A failure is rechecked about 15 minutes later before it alerts.
                </MudText>
            </MudItem>

            @foreach (var modeSetting in DnsHealthModeSettings)
            {
                <MudItem xs="12" sm="6" md="4">
                    <FieldWithHelp Topic="@modeSetting.Label" Help="@($"{modeSetting.Help} When it breaks: only once the check has passed at least once. Whenever it fails: every failure. Off: never.")">
                    <MudSelect T="DnsHealthAlertMode" Label="@modeSetting.Label" Variant="Variant.Outlined"
                               Value="modeSetting.Get(_settings)" ValueChanged="@(mode => modeSetting.Set(_settings!, mode))">
                        <MudSelectItem T="DnsHealthAlertMode" Value="DnsHealthAlertMode.WhenItBreaks">When it breaks</MudSelectItem>
                        <MudSelectItem T="DnsHealthAlertMode" Value="DnsHealthAlertMode.WheneverItFails">Whenever it fails</MudSelectItem>
                        <MudSelectItem T="DnsHealthAlertMode" Value="DnsHealthAlertMode.Off">Off</MudSelectItem>
                    </MudSelect>
                    </FieldWithHelp>
                </MudItem>
            }

            <MudItem xs="12" md="4">
                <FieldWithHelp Topic="DMARC policy weakens" Inline="true" Help="Alerts when a domain's DMARC policy, subdomain policy or percentage goes down, such as reject to quarantine. If the change was deliberate, acknowledge the alert and the new policy becomes the baseline.">
<MudSwitch @bind-Value="_settings.DmarcPolicyWeakenedEnabled" Color="Color.Primary" Label="Alert when a DMARC policy weakens" />
</FieldWithHelp>
            </MudItem>
            <MudItem xs="12" md="4">
                <FieldWithHelp Topic="Nameservers change" Inline="true" Help="Alerts when a domain's nameservers change, often the first sign of a DNS migration that could drop its records. It doesn't open a PSA ticket unless you turn that on.">
<MudSwitch @bind-Value="_settings.NameserversChangedEnabled" Color="Color.Primary" Label="Alert when nameservers change" />
</FieldWithHelp>
            </MudItem>
            <MudItem xs="12" md="4">
                <FieldWithHelp Topic="Close policy and nameserver alerts after" Help="Policy and nameserver alerts can describe deliberate changes, so they stay open until someone acknowledges them or closes their ticket. Set a number of days to close them automatically, as if acknowledged. 0 keeps them open.">
<MudNumericField Label="Close policy and nameserver alerts after (days)" @bind-Value="_settings.AcknowledgeableAutoCloseDays" Min="0" Max="365" Variant="Variant.Outlined" HelperText="0 keeps them open." />
</FieldWithHelp>
            </MudItem>
        </MudGrid>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="SaveAsync">Save settings</MudButton>
    </MudPaper>
}

<MudPaper Class="pa-4 mt-4">
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
        PSA connections have moved to <MudLink Href="/psa/settings">PSA settings</MudLink>.
    </MudAlert>
    <MudText Typo="Typo.h5" Class="mb-1">Which alerts create tickets</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        These apply to every PSA. Turn off an alert type to stop it opening tickets. The alert is still recorded and any
        Teams, Slack or webhook notification still goes out. A group can override this for its own domains from Manage
        groups. A domain with its own company set on Manage domains uses these settings.
    </MudText>
    @foreach (var alertType in AlertTypes.All)
    {
        <div class="d-flex align-center justify-space-between py-2" style="gap: 1rem; border-top: 1px solid var(--mud-palette-lines-default);">
            <div>
                <MudText Typo="Typo.subtitle2">@alertType.DisplayName</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@alertType.Description</MudText>
            </div>
            <MudSwitch @key="@($"{alertType.Key}-{_ticketRuleRenderVersion}")" T="bool" Value="@TicketRuleValue(alertType)" ValueChanged="@(createTicket => SetTicketRuleAsync(alertType, createTicket))"
                       Color="Color.Primary" Label="@(TicketRuleValue(alertType) ? "Creates tickets" : "No tickets")"
                       UserAttributes="@(new Dictionary<string, object> { ["aria-label"] = $"{alertType.DisplayName}: {(TicketRuleValue(alertType) ? "creates tickets" : "no tickets")}" })" />
        </div>
    }
</MudPaper>

@code {
    private sealed record DnsHealthModeSetting(string Label, string Help, Func<NotificationSettings, DnsHealthAlertMode> Get, Action<NotificationSettings, DnsHealthAlertMode> Set);

    private static readonly DnsHealthModeSetting[] DnsHealthModeSettings =
    [
        new("DMARC record", "Alerts when the domain's DMARC record (_dmarc TXT) is missing or can't be read.", settings => settings.DmarcAlertMode, (settings, mode) => settings.DmarcAlertMode = mode),
        new("DMARC authorization record", "Alerts when the record that lets receivers send this domain's reports to dotMARC's mailbox (on another domain) is missing. Without it, receivers drop the reports.", settings => settings.DmarcAuthorizationAlertMode, (settings, mode) => settings.DmarcAuthorizationAlertMode = mode),
        new("TLS-RPT record", "Alerts when the domain's TLS reporting record (_smtp._tls TXT) is missing or invalid.", settings => settings.TlsrptAlertMode, (settings, mode) => settings.TlsrptAlertMode = mode),
        new("SPF record", "Alerts when the domain's SPF record is missing, duplicated or broken.", settings => settings.SpfAlertMode, (settings, mode) => settings.SpfAlertMode = mode),
        new("MX", "Alerts when the domain has no MX record, or its mail server's name doesn't resolve.", settings => settings.MxAlertMode, (settings, mode) => settings.MxAlertMode = mode),
        new("DKIM", "Alerts when a DKIM selector set for the domain is missing or broken. Domains with no selectors set aren't checked.", settings => settings.DkimAlertMode, (settings, mode) => settings.DkimAlertMode = mode),
        new("MTA-STS", "Alerts when dotMARC stops being able to serve the domain's MTA-STS policy. Only for domains with MTA-STS hosting on.", settings => settings.MtaStsAlertMode, (settings, mode) => settings.MtaStsAlertMode = mode),
    ];

    private NotificationSettings? _settings;
    private AlertChannel? _testingChannel;

    private sealed record AlertChannelSetting(AlertChannel Channel, string Name, string Help,
        Func<NotificationSettings, bool> GetEnabled, Action<NotificationSettings, bool> SetEnabled,
        Func<NotificationSettings, string?> GetUrl, Action<NotificationSettings, string?> SetUrl);

    private static readonly AlertChannelSetting[] AlertChannelSettings =
    [
        new(AlertChannel.Teams, "Teams", "The webhook URL of the Teams channel alerts should post to.",
            settings => settings.TeamsEnabled, (settings, enabled) => settings.TeamsEnabled = enabled,
            settings => settings.TeamsWebhookUrl, (settings, url) => settings.TeamsWebhookUrl = url),
        new(AlertChannel.Slack, "Slack", "The incoming webhook URL from your Slack app (Incoming Webhooks), starting https://hooks.slack.com/services/. Alerts post to the channel you picked when you added the webhook.",
            settings => settings.SlackEnabled, (settings, enabled) => settings.SlackEnabled = enabled,
            settings => settings.SlackWebhookUrl, (settings, url) => settings.SlackWebhookUrl = url),
        new(AlertChannel.GenericWebhook, "Generic", "dotMARC POSTs each alert here as JSON, with domainName, alertType, title, message, severity and createdUtc.",
            settings => settings.GenericWebhookEnabled, (settings, enabled) => settings.GenericWebhookEnabled = enabled,
            settings => settings.GenericWebhookUrl, (settings, url) => settings.GenericWebhookUrl = url),
    ];

    /// <summary>Sends a marked test alert to the URL as typed, saved or not, so a channel can be checked before saving.</summary>
    private async Task SendTestAlertAsync(AlertChannelSetting channelSetting)
    {
        _testingChannel = channelSetting.Channel;
        try
        {
            var problem = await AlertWebhookClient.SendTestAsync(channelSetting.Channel, channelSetting.GetUrl(_settings!));
            if (problem is null)
            {
                Snackbar.Add($"Test alert sent to {channelSetting.Name}. Check that it arrived.", Severity.Success);
            }
            else
            {
                Snackbar.Add($"The {channelSetting.Name} test didn't go through: {problem}", Severity.Error);
            }
        }
        finally
        {
            _testingChannel = null;
        }
    }
    private Dictionary<string, bool> _globalTicketRules = [];

    // MudSwitch keeps its own toggled state. Bumping this after a failed save changes the switch @key, so a fresh
    // instance is created that shows the stored value again instead of the value the user just clicked.
    private int _ticketRuleRenderVersion;

    private bool TicketRuleValue(AlertTypeInfo alertType) =>
        _globalTicketRules.TryGetValue(alertType.Key, out var createTicket) ? createTicket : alertType.CreatesTicketByDefault;

    private async Task SetTicketRuleAsync(AlertTypeInfo alertType, bool createTicket)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await AlertTicketRuleService.SetGlobalAsync(db, await AuditActorAccessor.GetAsync(), alertType.Key, createTicket);
            _globalTicketRules[alertType.Key] = createTicket;
            Snackbar.Add($"{alertType.DisplayName}: tickets {(createTicket ? "on" : "off")}.", Severity.Success);
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Saving the ticket rule for {AlertType} failed", alertType.Key);
            _ticketRuleRenderVersion++;
            Snackbar.Add("Couldn't save that ticket rule. Try again.", Severity.Error);
        }
    }


    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _settings = await NotificationSettingsService.GetAsync(db);
        _globalTicketRules = await AlertTicketRuleService.GetGlobalAsync(db);
    }

    private async Task SaveAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await NotificationSettingsService.SaveAsync(db, await AuditActorAccessor.GetAsync(), _settings!);
            Snackbar.Add("Alert settings saved.", Severity.Success);
        }
        catch (ArgumentException exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

}
