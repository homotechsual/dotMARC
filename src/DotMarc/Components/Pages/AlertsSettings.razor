@page "/alerts/settings"
@attribute [Authorize(Policy = "AlertsManage")]
@using DotMarc.Components.Dialogs
@using DotMarc.Data
@using DotMarc.Components.Shared
@using DotMarc.Notifications
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject AuditActorAccessor AuditActorAccessor
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthorizationService AuthorizationService
@inject IDbContextFactory<DotMarcDbContext> DbFactory
@inject ISnackbar Snackbar
@inject ILogger<AlertsSettings> Logger
@inject IDialogService DialogService

<AppPageTitle>dotMARC - Alerts &amp; PSA - Settings</AppPageTitle>
<TabbedPage Title="Alerts & PSA" Tabs="_tabs">

@if (_settings is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4">
        <MudGrid>
            <MudItem xs="12" Class="d-flex align-center">
                <FieldWithHelp Topic="Enable notifications" Inline="true" Help="Turns alerting on or off. While it's off, dotMARC raises no alerts, so nothing is sent to any channel and no PSA tickets are opened.">
<MudSwitch @bind-Value="_settings.Enabled" Color="Color.Primary" Label="Enable notifications" />
</FieldWithHelp>
                <DocsLink Href="https://dotmarc.app/docs/alerts" Text="How alerts work" Class="ml-2" />
            </MudItem>

            <MudItem xs="12" md="6">
                <FieldWithHelp Topic="Cooldown" Help="While an alert is open, dotMARC won't raise it again for this long. After that, if the problem is still there, it's raised again, with a new notification and ticket.">
<MudNumericField Label="Cooldown (minutes)" @bind-Value="_settings.CooldownMinutes" Min="1" Max="10080" Variant="Variant.Outlined" />
</FieldWithHelp>
            </MudItem>

            <MudItem xs="12" md="6">
                <FieldWithHelp Topic="Monitor interval" Help="How often dotMARC checks monitored domains for missing reports, suspicious rejects and DNS health problems, and closes alerts that have cleared.">
<MudNumericField Label="Monitor interval (seconds)" @bind-Value="_settings.MonitorIntervalSeconds" Min="30" Max="86400" Variant="Variant.Outlined" />
</FieldWithHelp>
            </MudItem>

            <MudItem xs="12" md="6">
                <FieldWithHelp Topic="Time zone" Help="The time zone the quiet hours on alert rules are read in. A rule's quiet window of 22:00 to 07:00 means those times here.">
                    <MudAutocomplete T="string" Label="Time zone" @bind-Value="_settings.TimeZoneId" SearchFunc="SearchZones" MaxItems="50" Variant="Variant.Outlined" />
                </FieldWithHelp>
            </MudItem>

            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                    When each alert is raised, for which domains, and how serious it is now live on the <MudLink Href="/alerts/rules">Rules tab</MudLink>.
                    The thresholds, DNS check modes and sender settings that used to be here are rule settings there.
                </MudAlert>
            </MudItem>
        </MudGrid>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="SaveAsync">Save settings</MudButton>
    </MudPaper>
}

<MudPaper Class="pa-4 mt-4">
    <div class="d-flex align-center flex-wrap mb-1" style="gap: 0.5rem;">
        <MudText Typo="Typo.h5">Where alerts go</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => EditDestinationAsync(null))">Add a destination</MudButton>
    </div>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        A destination is a Teams channel, a Slack channel or a webhook. Each alert rule sends to all of them, or only to the ones it chooses
        on the <MudLink Href="/alerts/rules">Rules tab</MudLink>. PSA tickets are set up on the <MudLink Href="/alerts/psa">PSA tab</MudLink>.
    </MudText>
    @if (_destinations is null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_destinations.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true">
            No destinations yet. Alerts are still recorded and tickets still open, but nothing is posted anywhere. Add a destination to send alerts to Teams, Slack or a webhook.
        </MudAlert>
    }
    else
    {
        <MudSimpleTable Dense="true" Hover="true" Style="overflow-x:auto;">
            <thead>
                <tr><th>Name</th><th>Kind</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var destination in _destinations)
                {
                    <tr @key="destination.Id">
                        <td>@destination.Name</td>
                        <td>@KindName(destination.Kind)</td>
                        <td><MudChip T="string" Size="Size.Small" Color="@(destination.Enabled ? Color.Success : Color.Default)">@(destination.Enabled ? "On" : "Off")</MudChip></td>
                        <td style="white-space:nowrap;">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => EditDestinationAsync(destination.Id))">Edit</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Class="ml-1" OnClick="@(() => DeleteDestinationAsync(destination))">Delete</MudButton>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</MudPaper>

<MudPaper Class="pa-4 mt-4">
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
        PSA connections have moved to the <MudLink Href="/alerts/psa">PSA tab</MudLink>.
    </MudAlert>
    <MudText Typo="Typo.h5" Class="mb-1">Which alerts create tickets</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        These apply to every PSA. Turn off an alert type to stop it opening tickets. The alert is still recorded and any
        notification to its destinations still goes out. A group can override this for its own domains from Manage
        groups. A domain with its own company set in Inventory uses these settings.
    </MudText>
    @foreach (var alertType in AlertTypes.All)
    {
        <div class="d-flex align-center justify-space-between py-2" style="gap: 1rem; border-top: 1px solid var(--mud-palette-lines-default);">
            <div>
                <MudText Typo="Typo.subtitle2">@alertType.DisplayName</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@alertType.Description</MudText>
            </div>
            <MudSwitch @key="@($"{alertType.Key}-{_ticketRuleRenderVersion}")" T="bool" Value="@TicketRuleValue(alertType)" ValueChanged="@(createTicket => SetTicketRuleAsync(alertType, createTicket))"
                       Color="Color.Primary" Label="@(TicketRuleValue(alertType) ? "Creates tickets" : "No tickets")"
                       UserAttributes="@(new Dictionary<string, object> { ["aria-label"] = $"{alertType.DisplayName}: {(TicketRuleValue(alertType) ? "creates tickets" : "no tickets")}" })" />
        </div>
    }
</MudPaper>
</TabbedPage>

@code {
    private IReadOnlyList<TabbedPageTab> _tabs = [];
    private NotificationSettings? _settings;
    private IReadOnlyList<AlertDestinationSummary>? _destinations;
    private IReadOnlyList<string> _zones = [];

    private Task<IEnumerable<string>> SearchZones(string? text, CancellationToken cancellationToken) =>
        Task.FromResult(string.IsNullOrWhiteSpace(text)
            ? _zones.AsEnumerable()
            : _zones.Where(zone => zone.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase)));

    private static string KindName(AlertChannel kind) => kind switch
    {
        AlertChannel.Teams => "Teams",
        AlertChannel.Slack => "Slack",
        _ => "Generic webhook"
    };

    private async Task LoadDestinationsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _destinations = await AlertDestinationService.ListSummariesAsync(db);
    }

    private async Task EditDestinationAsync(int? destinationId)
    {
        var parameters = new DialogParameters<AlertDestinationDialog> { { dialog => dialog.DestinationId, destinationId } };
        var dialog = await DialogService.ShowAsync<AlertDestinationDialog>(destinationId is null ? "Add a destination" : "Edit destination", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadDestinationsAsync();
        }
    }

    private async Task DeleteDestinationAsync(AlertDestinationSummary destination)
    {
        int ruleCount;
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            ruleCount = await AlertDestinationService.CountRulesAsync(db, destination.Id);
        }

        var consequence = ruleCount == 0
            ? "No rule chooses it specifically."
            : $"{ruleCount} rule{(ruleCount == 1 ? " chooses" : "s choose")} it specifically, and will stop sending there. A rule that chose only this destination will send nowhere.";
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete destination", $"Delete '{destination.Name}'? {consequence} This can't be undone.", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await AlertDestinationService.DeleteAsync(db, await AuditActorAccessor.GetAsync(), destination.Id);
            Snackbar.Add("Destination deleted.", Severity.Success);
        }
        catch (AlertDestinationException exception)
        {
            Snackbar.Add(exception.Message, Severity.Warning);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Deleting alert destination {DestinationId} failed", destination.Id);
            Snackbar.Add("Couldn't delete that destination. Try again.", Severity.Error);
        }

        await LoadDestinationsAsync();
    }

    private Dictionary<string, bool> _globalTicketRules = [];

    // MudSwitch keeps its own toggled state. Bumping this after a failed save changes the switch @key, so a fresh
    // instance is created that shows the stored value again instead of the value the user just clicked.
    private int _ticketRuleRenderVersion;

    private bool TicketRuleValue(AlertTypeInfo alertType) =>
        _globalTicketRules.TryGetValue(alertType.Key, out var createTicket) ? createTicket : alertType.CreatesTicketByDefault;

    private async Task SetTicketRuleAsync(AlertTypeInfo alertType, bool createTicket)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await AlertTicketRuleService.SetGlobalAsync(db, await AuditActorAccessor.GetAsync(), alertType.Key, createTicket);
            _globalTicketRules[alertType.Key] = createTicket;
            Snackbar.Add($"{alertType.DisplayName}: tickets {(createTicket ? "on" : "off")}.", Severity.Success);
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Saving the ticket rule for {AlertType} failed", alertType.Key);
            _ticketRuleRenderVersion++;
            Snackbar.Add("Couldn't save that ticket rule. Try again.", Severity.Error);
        }
    }


    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _tabs = await AlertsPsaTabs.ForAsync(user, AuthorizationService);
        await using var db = await DbFactory.CreateDbContextAsync();
        _settings = await NotificationSettingsService.GetAsync(db);
        _globalTicketRules = await AlertTicketRuleService.GetGlobalAsync(db);
        _destinations = await AlertDestinationService.ListSummariesAsync(db);
        _zones = DotMarc.Reporting.ClientReports.ReportSettingsService.ListAvailableZones();
    }

    private async Task SaveAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await NotificationSettingsService.SaveAsync(db, await AuditActorAccessor.GetAsync(), _settings!);
            Snackbar.Add("Alert settings saved.", Severity.Success);
        }
        catch (ArgumentException exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

}
