@page "/alerts/settings"
@attribute [Authorize(Policy = "AlertsManage")]
@using DotMarc.Data
@using DotMarc.Notifications
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<DotMarcDbContext> DbFactory
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4">Alert settings</MudText>

@if (_settings is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4">
        <MudGrid>
            <MudItem xs="12">
                <MudSwitch @bind-Value="_settings.Enabled" Color="Color.Primary" Label="Enable notifications" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="string" Label="Delivery mode" Variant="Variant.Outlined" @bind-Value="_settings.DeliveryMode">
                    <MudSelectItem Value="@("Teams")">Teams only</MudSelectItem>
                    <MudSelectItem Value="@("Generic")">Generic webhook only</MudSelectItem>
                    <MudSelectItem Value="@("Both")">Teams + generic webhook</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField Label="Teams webhook URL" @bind-Value="_settings.TeamsWebhookUrl" InputType="InputType.Url" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField Label="Generic webhook URL" @bind-Value="_settings.GenericWebhookUrl" InputType="InputType.Url" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudNumericField Label="Missing report threshold (days)" @bind-Value="_settings.MissingReportThresholdDays" Min="1" Max="90" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudNumericField Label="Cooldown (minutes)" @bind-Value="_settings.CooldownMinutes" Min="1" Max="10080" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudNumericField Label="Monitor interval (seconds)" @bind-Value="_settings.MonitorIntervalSeconds" Min="30" Max="86400" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="SaveAsync">Save settings</MudButton>
    </MudPaper>
}

@code {
    private NotificationSettings? _settings;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _settings = await NotificationSettingsService.GetAsync(db);
    }

    private async Task SaveAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await NotificationSettingsService.SaveAsync(db, _settings!);
        Snackbar.Add("Alert settings saved.", Severity.Success);
    }
}
