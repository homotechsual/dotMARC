@page "/mta-sts"
@attribute [Authorize(Policy = "MtaStsManage")]
@using DotMarc.Components.Shared
@using DotMarc.Data
@using DotMarc.DnsPush
@using DotMarc.MtaSts
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@inject IDbContextFactory<DotMarcDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IOptions<MtaStsOptions> MtaStsOptions
@inject IMxHostsLookup MxHostsLookup
@inject IDnsProviderDetector DnsProviderDetector
@inject IMtaStsHostProvisioner MtaStsHostProvisioner
@inject IEnumerable<IDnsPushProvider> DnsPushProviders
@inject NavigationManager Navigation

<PageTitle>dotMARC - Manage MTA-STS</PageTitle>
<UnsavedChangesGuard HasUnsavedChanges="AnyUnsavedChanges" />
<MudButton Href="/dashboard" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-2">Back</MudButton>
<MudText Typo="Typo.h4" Class="mb-4">Manage MTA-STS</MudText>

<HelpAlert DocsUrl="https://dotmarc.app/docs/mta-sts#enabling-a-domain">
    @if (string.IsNullOrEmpty(MtaStsOptions.Value.HostingHostname))
    {
        <text>MTA-STS hosting isn't configured on this deployment yet (no <code>MtaSts__HostingHostname</code> set), so enabling a domain below won't progress past "Waiting for DNS."</text>
    }
    else
    {
        <text>Enabling a domain starts hosting its MTA-STS policy. For each one, add a CNAME:
        <code>mta-sts.&lt;domain&gt; → @MtaStsOptions.Value.HostingHostname</code>.
        <b>Testing</b> reports without enforcing; <b>Enforce</b> requires a valid TLS connection;
        <b>None</b> publishes no strictness policy. Status updates automatically once DNS propagates.
        @if (string.Equals(MtaStsOptions.Value.Provisioner, "Azure", StringComparison.OrdinalIgnoreCase))
        {
            <text> That's this deployment's raw Container App hostname, not a nicer custom domain,
            because Azure's free managed certificates refuse to issue through an intermediate CNAME
            like one. Each enabled domain adds its own custom domain and certificate to this app;
            Azure doesn't publish a hard limit on either, so there's no cap to plan around here.
            @if (!string.IsNullOrEmpty(_domainVerificationId))
            {
                <text> Azure also requires a second record proving you control the domain, the same
                value for every domain on this deployment:
                <code>asuid.mta-sts.&lt;domain&gt; TXT @_domainVerificationId</code>.</text>
            }</text>
        }</text>
    }
</HelpAlert>

@if (_domains is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudTable Items="_domains" Hover="true" T="MtaStsRow">
        <HeaderContent>
            <MudTh>Domain</MudTh>
            <MudTh>Enabled</MudTh>
            <MudTh>Mode</MudTh>
            <MudTh Style="width: 8rem;">Max age (seconds)</MudTh>
            <MudTh>MX hosts</MudTh>
            <MudTh Style="width: 3rem;"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>
                <MudSwitch T="bool" @bind-Value="context.Enabled" Color="Color.Primary" />
            </MudTd>
            <MudTd>
                <MudSelect T="MtaStsMode" @bind-Value="context.Mode">
                    <MudSelectItem T="MtaStsMode" Value="MtaStsMode.Testing">Testing</MudSelectItem>
                    <MudSelectItem T="MtaStsMode" Value="MtaStsMode.Enforce">Enforce</MudSelectItem>
                    <MudSelectItem T="MtaStsMode" Value="MtaStsMode.None">None</MudSelectItem>
                </MudSelect>
            </MudTd>
            <MudTd Style="width: 8rem;">
                <MudNumericField T="int" @bind-Value="context.MaxAgeSeconds" Min="0" />
            </MudTd>
            <MudTd>
                <div class="d-flex align-start" style="gap: 0.25rem;">
                    <MudTextField @bind-Value="context.MxHostsText" Lines="3" HelperText="One per line, e.g. mail.example.com" />
                    @if (context.IsFetchingMxHosts)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mt-3" />
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Sync" Size="Size.Small" Class="mt-1"
                                       title="Fetch MX hosts from DNS" aria-label="Fetch MX hosts from DNS"
                                       OnClick="@(() => FetchMxHostsAsync(context))" />
                    }
                </div>
            </MudTd>
            <MudTd Style="width: 3rem;">
                @if (context.Status == MtaStsStatus.PendingDns)
                {
                    @if (context.IsDetectingProvider)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.CloudSync" Size="Size.Small"
                                       title="Push the CNAME via your DNS provider" aria-label="@($"Push MTA-STS CNAME for {context.Name} via your DNS provider")"
                                       OnClick="@(() => PushCnameAsync(context))" />
                    }
                }
                <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary" Size="Size.Small"
                               title="Save" aria-label="@($"Save MTA-STS configuration for {context.Name}")"
                               OnClick="@(() => SaveAsync(context))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<MtaStsRow>? _domains;
    private string? _domainVerificationId;

    private bool AnyUnsavedChanges => _domains?.Any(d => d.IsDirty) ?? false;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        if (string.Equals(MtaStsOptions.Value.Provisioner, "Azure", StringComparison.OrdinalIgnoreCase))
        {
            _domainVerificationId = await MtaStsHostProvisioner.GetDomainVerificationIdAsync(CancellationToken.None);
        }

        if (RendererInfo.IsInteractive)
        {
            ShowDnsPushResultToast();
        }
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _domains = await db.Domains
            .AsNoTracking()
            .OrderBy(d => d.SortOrder)
            .ThenBy(d => d.Name)
            .Select(d => new MtaStsRow
            {
                Id = d.Id,
                Name = d.Name,
                Enabled = d.MtaStsEnabled,
                Mode = d.MtaStsMode,
                MaxAgeSeconds = d.MtaStsMaxAgeSeconds,
                MxHostsText = string.Join('\n', d.MtaStsMxHosts),
                Status = d.MtaStsStatus
            })
            .ToListAsync();

        foreach (var row in _domains)
        {
            row.ResetSnapshot();
        }
    }

    private async Task FetchMxHostsAsync(MtaStsRow row)
    {
        row.IsFetchingMxHosts = true;
        try
        {
            var mxHosts = await MxHostsLookup.LookupAsync(row.Name, CancellationToken.None);
            if (mxHosts.Count == 0)
            {
                Snackbar.Add($"No MX records found for {row.Name}.", Severity.Warning);
            }
            else
            {
                row.MxHostsText = string.Join('\n', mxHosts);
            }
        }
        catch (Exception)
        {
            Snackbar.Add($"Failed to look up {row.Name}'s MX records. Try again.", Severity.Error);
        }
        finally
        {
            row.IsFetchingMxHosts = false;
        }
    }

    private async Task PushCnameAsync(MtaStsRow row)
    {
        row.IsDetectingProvider = true;
        try
        {
            var detected = await DnsProviderDetector.DetectAsync(row.Name, CancellationToken.None);
            var providerKey = detected switch
            {
                DetectedDnsProvider.Cloudflare => "cloudflare",
                DetectedDnsProvider.AzureDns => "azure-dns",
                _ => null
            };
            var pushProvider = await DnsPushProviders.FindConfiguredAsync(providerKey);
            if (pushProvider is null)
            {
                Snackbar.Add($"Couldn't find a configured DNS push option for {row.Name} — add the CNAME manually.", Severity.Warning);
                return;
            }

            Navigation.NavigateTo($"/dns-push/{pushProvider.ProviderKey}/start?domainId={row.Id}&target=mta-sts", forceLoad: true);
        }
        finally
        {
            row.IsDetectingProvider = false;
        }
    }

    private void ShowDnsPushResultToast()
    {
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Navigation.Uri).Query);
        switch (query["dnsPush"])
        {
            case "pushed":
                Snackbar.Add("DNS record pushed. It can take a few minutes to propagate.", Severity.Success);
                break;
            case "cancelled":
                break; // user backed out of the provider's consent screen — no need to say anything
            case "zone-not-found":
                Snackbar.Add("Couldn't find that domain in the account you authorized.", Severity.Warning);
                break;
            case "unmergeable":
                Snackbar.Add("Couldn't safely compute a fix for that record — it needs a manual look.", Severity.Warning);
                break;
            case "error":
                Snackbar.Add("The DNS push failed. Try again, or add the record manually.", Severity.Error);
                break;
        }
    }

    private async Task SaveAsync(MtaStsRow row)
    {
        var mxHosts = row.MxHostsText
            .Split(['\n', ','], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        // Mirrors the enable-transition check DomainManagementService.SetMtaStsConfigAsync makes
        // server-side (enabled && !previously enabled) so the row's Status can be updated to match
        // without a full reload.
        var justEnabled = row.Enabled && !row.WasEnabled;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await DomainManagementService.SetMtaStsConfigAsync(db, row.Id, row.Enabled, row.Mode, mxHosts, row.MaxAgeSeconds, CancellationToken.None);
            row.ResetSnapshot();
            if (justEnabled)
            {
                row.Status = MtaStsStatus.PendingDns;
            }
            Snackbar.Add($"MTA-STS configuration saved for {row.Name}.", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add($"Failed to save {row.Name}'s MTA-STS configuration. Try again.", Severity.Error);
        }
    }

    private sealed class MtaStsRow
    {
        public required int Id { get; set; }
        public required string Name { get; set; }
        public bool Enabled { get; set; }
        public MtaStsMode Mode { get; set; }
        public int MaxAgeSeconds { get; set; }
        public string MxHostsText { get; set; } = "";
        public bool IsFetchingMxHosts { get; set; }
        public MtaStsStatus Status { get; set; }
        public bool IsDetectingProvider { get; set; }

        private (bool Enabled, MtaStsMode Mode, int MaxAgeSeconds, string MxHostsText) _snapshot;

        /// <summary>The Enabled value as of the last load or successful save — i.e. before any
        /// in-progress edits on this row. Used to detect a disabled-&gt;enabled transition the same
        /// way DomainManagementService.SetMtaStsConfigAsync does server-side.</summary>
        public bool WasEnabled => _snapshot.Enabled;

        public void ResetSnapshot() => _snapshot = (Enabled, Mode, MaxAgeSeconds, MxHostsText);

        public bool IsDirty => _snapshot != (Enabled, Mode, MaxAgeSeconds, MxHostsText);
    }
}
