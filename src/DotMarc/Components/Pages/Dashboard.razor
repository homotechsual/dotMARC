@page "/dashboard"
@attribute [Authorize(Policy = "DomainsView")]
@using DotMarc.Components.Shared
@using DotMarc.Data
@using DotMarc.Reporting
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject AuditActorAccessor AuditActorAccessor
@inject IDbContextFactory<DotMarcDbContext> DbFactory
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IServiceProvider Services
@inject DotMarc.Ingestion.PollNowSignal PollNow

<AppPageTitle>dotMARC - Dashboard</AppPageTitle>
<div class="d-flex align-center mb-1">
    <MudText Typo="Typo.h4">Dashboard</MudText>
    <DocsLink Href="https://dotmarc.app/docs/getting-started" Text="What this page shows" Class="ml-2" />
</div>
<MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
    Pass rate, DNS status, and polling health for every domain you monitor, updated as reports
    come in. Filter by Group or Tag below, or open a domain for its full report history.
</MudText>

@if (_summary is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6">
            <SearchableSelect TValue="int?" Label="Group" Options="@(_allGroups.Select(group => new SelectOption<int?>(group.Id, group.Name)).ToList())"
                              Value="_selectedGroupId" ValueChanged="@(v => OnGroupFilterChangedAsync(v))"
                              Clearable="@(_scopedGroupIds is null)" Disabled="@(_scopedGroupIds is not null && _scopedGroupIds.Count == 1)" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <SearchableSelect TValue="int?" Label="Tag" Options="@(_allTags.Select(tag => new SelectOption<int?>(tag.Id, tag.Name)).ToList())"
                              Value="_selectedTagId" ValueChanged="@(v => OnTagFilterChangedAsync(v))" Clearable="true" />
        </MudItem>
    </MudGrid>

    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="2">
            <MudPaper Height="100%" Class="pa-4 stat-card" Elevation="1">
                <MudText Typo="Typo.h5" Class="stat-value">@_summary.DomainCount</MudText>
                <MudText Typo="Typo.caption">domains monitored</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudPaper Height="100%" Class="pa-4 stat-card" Elevation="1">
                <MudText Typo="Typo.h5" Class="stat-value" Color="Color.Success">@_summary.OverallPassRate.ToString("P1")</MudText>
                <MudText Typo="Typo.caption">overall pass rate (30d)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudPaper Height="100%" Class="pa-4 stat-card" Elevation="1">
                <MudText Typo="Typo.h5" Class="stat-value" Color="Color.Warning">@_summary.WarningCount</MudText>
                <MudText Typo="Typo.caption">domains with warnings</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudPaper Height="100%" Class="pa-4 stat-card" Elevation="1">
                <MudText Typo="Typo.h5" Class="stat-value" Color="Color.Error">@_summary.MissingCount</MudText>
                <MudText Typo="Typo.caption">missing expected report</MudText>
            </MudPaper>
        </MudItem>
        <AuthorizeView Policy="DomainsWrite">
            <MudItem xs="12" sm="6" md="2">
                <MudPaper Height="100%" Class="pa-4 stat-card cursor-pointer" Elevation="1" @onclick="@(() => Navigation.NavigateTo("/parse-failures"))">
                    <MudText Typo="Typo.h5" Class="stat-value" Color="@(!IsFilterActive && _summary.ParseFailureCount > 0 ? Color.Error : Color.Default)">@_summary.ParseFailureCount</MudText>
                    <MudText Typo="Typo.caption">unparseable messages@(IsFilterActive ? " (all domains)" : "")</MudText>
                </MudPaper>
            </MudItem>
        </AuthorizeView>
        <MudItem xs="12" sm="6" md="2">
            <MudPaper Height="100%" Class="pa-4 stat-card cursor-pointer" Elevation="1">
                <MudText Typo="Typo.h5" Class="stat-value">@_summary.SourceCount</MudText>
                <MudText Typo="Typo.caption">sources provided reports</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (_summary.ReasonBreakdown.Total > 0)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Why rejects/quarantines happened, across every monitored domain (30d)</MudText>
            <MudGrid>
                <MudItem xs="12" sm="5">
                    <MudChart ChartType="ChartType.Donut" T="double"
                              ChartSeries="@([new double[] { _summary.ReasonBreakdown.BenignOverride, _summary.ReasonBreakdown.LocalPolicy, _summary.ReasonBreakdown.Other, _summary.ReasonBreakdown.InferredSpfFailure, _summary.ReasonBreakdown.InferredDkimFailure, _summary.ReasonBreakdown.InferredBothFailure, _summary.ReasonBreakdown.NoReasonGiven }])"
                              ChartLabels="@(new[] { "Benign override", "Local policy", "Other", "SPF failure (inferred)", "DKIM failure (inferred)", "SPF & DKIM failure (inferred)", "No reason given" })"
                              Width="220px" Height="220px" />
                </MudItem>
                <MudItem xs="12" sm="7" Class="d-flex align-center">
                    <ReasonBreakdownList Breakdown="_summary.ReasonBreakdown" />
                </MudItem>
            </MudGrid>
        </MudPaper>
    }

    <div class="d-flex align-center mb-2">
        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary">
            <MudButton Variant="@(_groupedView ? Variant.Outlined : Variant.Filled)" StartIcon="@Icons.Material.Filled.TableRows" OnClick="@(() => _groupedView = false)">All domains</MudButton>
            <MudButton Variant="@(_groupedView ? Variant.Filled : Variant.Outlined)" StartIcon="@Icons.Material.Filled.AccountTree" OnClick="@(() => _groupedView = true)">By group</MudButton>
        </MudButtonGroup>
        <MudSpacer />
        @if (_userKey is not null)
        {
            <MudTooltip Text="Next time you open the Dashboard it starts with this view, these Group and Tag filters and these column filters." Arrow="true">
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveDefaultAsync">Save as my default</MudButton>
            </MudTooltip>
            @if (_hasSavedDefault)
            {
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ClearDefaultAsync">Clear my default</MudButton>
            }
        }
    </div>

    @if (!_groupedView)
    {
        @DomainTable(_rows)
    }
    else if (_groupedTables.Count == 0)
    {
        <MudAlert Severity="Severity.Info">No domains to show.</MudAlert>
    }
    else
    {
        @foreach (var group in _groupedTables)
        {
            <div class="mb-4">
                @DomainTable(group.Rows, group.GroupName ?? "No group")
            </div>
        }
    }

    <MudPaper Class="pa-4 mt-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Polling status</MudText>
        @if (_lastPoll is null)
        {
            <MudText Typo="Typo.body2">Not polled yet.</MudText>
        }
        else if (_lastPoll.Succeeded)
        {
            <MudGrid>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption">Last polled</MudText>
                    <MudText>@_lastPoll.PolledUtc.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption">Messages checked</MudText>
                    <MudText>@_lastPoll.MessagesChecked</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption">Reports parsed</MudText>
                    <MudText>@_lastPoll.ReportsParsed</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption">Parse failures</MudText>
                    <MudText>@_lastPoll.ParseFailures</MudText>
                </MudItem>
            </MudGrid>
        }
        else
        {
            <MudText Color="Color.Error" Style="overflow-wrap:anywhere">
                Last poll (@_lastPoll.PolledUtc.ToString("yyyy-MM-dd HH:mm:ss")) failed:
                @if (string.IsNullOrWhiteSpace(_lastPoll.ErrorMessage))
                {
                    <span>no error message was recorded.</span>
                }
                else
                {
                    @foreach (var part in DotMarc.Components.Shared.TextLinks.Split(_lastPoll.ErrorMessage))
                    {
                        if (part.IsLink)
                        {
                            <MudLink Href="@part.Text" Target="_blank" Color="Color.Error" Underline="Underline.Always">@part.Text</MudLink>
                        }
                        else
                        {
                            @part.Text
                        }
                    }
                }
            </MudText>
        }

        @* Only when dotMARC polls a real mailbox: the demo has none. *@
        @if (Services.GetService<DotMarc.Graph.MailboxAccessCheck>() is not null)
        {
            <AuthorizeView Policy="LogsView" Context="logsAuth">
                <div class="d-flex flex-wrap mt-3" style="gap: 0.5rem;">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.MarkEmailRead" Disabled="@_checkingMailbox" OnClick="CheckMailboxAsync">Check mailbox access</MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Sync" Disabled="@_pollingNow" OnClick="PollNowAsync">@(_pollingNow ? "Polling..." : "Poll now")</MudButton>
                </div>
                @foreach (var result in _mailboxChecks)
                {
                    <MudAlert Severity="@(result.Problem is null ? Severity.Success : result.CanRead ? Severity.Warning : Severity.Error)" Dense="true" Class="mt-2">
                        <b>@result.Purpose</b>: @result.Summary
                        @if (result.Problem is not null)
                        {
                            <br />
                            @foreach (var part in DotMarc.Components.Shared.TextLinks.Split(result.Problem))
                            {
                                if (part.IsLink)
                                {
                                    <MudLink Href="@part.Text" Target="_blank" Underline="Underline.Always">@part.Text</MudLink>
                                }
                                else
                                {
                                    @part.Text
                                }
                            }
                        }
                    </MudAlert>
                }
            </AuthorizeView>
        }
    </MudPaper>
}

@code {
    private RenderFragment DomainTable(IReadOnlyList<DashboardDomainRow> items, string? title = null) => __builder =>
    {
        <MudTable Items="items" Hover="true" T="DashboardDomainRow" CustomHeader="true" Filter="RowMatchesFilters">
            @* The filters apply to every column, so the toggle sits above the table rather than inside one column's heading. *@
            <ToolBarContent>
                @if (title is not null)
            {
                <MudText Typo="Typo.h6">@title <MudText Typo="Typo.caption" Inline="true" Class="mud-text-secondary">(@items.Count)</MudText></MudText>
            }
            <MudSpacer />
                <MudButton Variant="@(_showFilters ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.FilterList"
                           OnClick="@(() => _showFilters = !_showFilters)">@(_showFilters ? "Hide filters" : "Filters")</MudButton>
            </ToolBarContent>
            <HeaderContent>
                <tr>
                    <MudTh rowspan="2"><MudTableSortLabel SortBy="new Func<DashboardDomainRow, object>(r => r.Name)">Domain</MudTableSortLabel></MudTh>
                    <MudTh rowspan="2"><MudTableSortLabel SortBy="new Func<DashboardDomainRow, object>(r => r.Status)">Report Status</MudTableSortLabel></MudTh>
                    <MudTh rowspan="2"><MudTableSortLabel SortBy="new Func<DashboardDomainRow, object>(r => r.PassRate ?? -1)">Pass rate (30d)</MudTableSortLabel></MudTh>
                    <MudTh rowspan="2"><MudTableSortLabel SortBy="new Func<DashboardDomainRow, object>(r => r.LastReportReceivedUtc ?? DateTimeOffset.MinValue)">Last report</MudTableSortLabel></MudTh>
                    <MudTh rowspan="2"><MudTableSortLabel SortBy="new Func<DashboardDomainRow, object>(r => r.IsMonitored)">Monitored</MudTableSortLabel></MudTh>
                    <MudTh colspan="3" Style="text-align:center">DNS Status</MudTh>
                </tr>
                <tr>
                    <MudTh><MudTableSortLabel SortBy="new Func<DashboardDomainRow, object>(r => DmarcStatusPresentation.GetLabel(r.DmarcCheckStatus, r.DmarcAuthorizationCheckStatus))">DMARC</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<DashboardDomainRow, object>(r => MtaStsStatusPresentation.GetLabel(r.MtaStsStatus))">MTA-STS</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<DashboardDomainRow, object>(r => DkimStatusPresentation.GetLabel(r.DkimCheckStatus))">DKIM</MudTableSortLabel></MudTh>
                </tr>
                @if (_showFilters)
                {
                <tr>
                    <MudTh><MudTextField T="string" @bind-Value="_domainFilter" Placeholder="Search" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" /></MudTh>
                    <MudTh>
                        <MudSelect T="string" Value="_statusFilter" ValueChanged="@(v => _statusFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                            @foreach (var status in _rows.Select(r => r.Status).Distinct().OrderBy(s => s))
                            {
                                <MudSelectItem T="string" Value="status">@status</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTh>
                    <MudTh>
                        <MudNumericField T="double?" @bind-Value="_minPassRatePercentFilter" Placeholder="Min %" Margin="Margin.Dense" Min="0" Max="100" />
                    </MudTh>
                    <MudTh><MudTextField T="string" @bind-Value="_lastReportFilter" Placeholder="Search" Immediate="true" Margin="Margin.Dense" /></MudTh>
                    <MudTh>
                        <MudSelect T="bool?" Value="_monitoredFilter" ValueChanged="@(v => _monitoredFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                            <MudSelectItem T="bool?" Value="true">Yes</MudSelectItem>
                            <MudSelectItem T="bool?" Value="false">No</MudSelectItem>
                        </MudSelect>
                    </MudTh>
                    <MudTh>
                        <MudSelect T="string" Value="_dmarcFilter" ValueChanged="@(v => _dmarcFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                            @foreach (var label in _rows.Select(r => DmarcStatusPresentation.GetLabel(r.DmarcCheckStatus, r.DmarcAuthorizationCheckStatus)).Distinct().OrderBy(l => l))
                            {
                                <MudSelectItem T="string" Value="label">@label</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTh>
                    <MudTh>
                        <MudSelect T="string" Value="_mtaStsFilter" ValueChanged="@(v => _mtaStsFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                            @foreach (var label in _rows.Select(r => MtaStsStatusPresentation.GetLabel(r.MtaStsStatus)).Distinct().OrderBy(l => l))
                            {
                                <MudSelectItem T="string" Value="label">@label</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTh>
                    <MudTh>
                        <MudSelect T="string" Value="_dkimFilter" ValueChanged="@(v => _dkimFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                            @foreach (var label in _rows.Select(r => DkimStatusPresentation.GetLabel(r.DkimCheckStatus)).Distinct().OrderBy(l => l))
                            {
                                <MudSelectItem T="string" Value="label">@label</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTh>
                </tr>
                }
            </HeaderContent>
            <RowTemplate>
                <MudTd @onclick="@(() => Navigation.NavigateTo($"/domains/{Uri.EscapeDataString(context.Name)}"))" Style="cursor:pointer">
                    @context.Name
                    @if (context.SpfCheckStatus == SpfCheckStatus.NullSpf)
                    {
                        <MudTooltip Text="This domain publishes a null SPF record (no authorized senders). For parked domains like this, DMARC's p=reject is the recommended policy." Arrow="true">
                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Class="ml-2">Null-routed</MudChip>
                        </MudTooltip>
                    }
                </MudTd>
                <MudTd @onclick="@(() => Navigation.NavigateTo($"/domains/{Uri.EscapeDataString(context.Name)}"))" Style="cursor:pointer"><MudChip T="string" Color="@context.StatusColor" Size="Size.Small">@context.Status</MudChip></MudTd>
                <MudTd @onclick="@(() => Navigation.NavigateTo($"/domains/{Uri.EscapeDataString(context.Name)}"))" Style="cursor:pointer">@(context.PassRate is { } rate ? rate.ToString("P1") : "—")</MudTd>
                <MudTd @onclick="@(() => Navigation.NavigateTo($"/domains/{Uri.EscapeDataString(context.Name)}"))" Style="cursor:pointer">@(context.LastReportReceivedUtc is { } last ? last.ToString("g") : "never")</MudTd>
                <MudTd>
                    <AuthorizeView Policy="DomainsEdit" Context="authState">
                        <Authorized>
                            <MudSwitch T="bool" Value="context.IsMonitored" ValueChanged="@(v => ToggleMonitoredAsync(context, v))" Color="Color.Primary" />
                        </Authorized>
                        <NotAuthorized>
                            @(context.IsMonitored ? "Yes" : "No")
                        </NotAuthorized>
                    </AuthorizeView>
                </MudTd>
                <MudTd @onclick="@(() => Navigation.NavigateTo($"/domains/{Uri.EscapeDataString(context.Name)}"))" Style="cursor:pointer">
                    <MudChip T="string" Color="@DmarcStatusPresentation.GetColor(context.DmarcCheckStatus, context.DmarcAuthorizationCheckStatus)" Size="Size.Small">@DmarcStatusPresentation.GetLabel(context.DmarcCheckStatus, context.DmarcAuthorizationCheckStatus)</MudChip>
                </MudTd>
                <MudTd @onclick="@(() => Navigation.NavigateTo($"/domains/{Uri.EscapeDataString(context.Name)}"))" Style="cursor:pointer">
                    <MudChip T="string" Color="@MtaStsStatusPresentation.GetColor(context.MtaStsStatus)" Size="Size.Small">@MtaStsStatusPresentation.GetLabel(context.MtaStsStatus)</MudChip>
                </MudTd>
                <MudTd @onclick="@(() => Navigation.NavigateTo($"/domains/{Uri.EscapeDataString(context.Name)}"))" Style="cursor:pointer">
                    <MudChip T="string" Color="@DkimStatusPresentation.GetColor(context.DkimCheckStatus)" Size="Size.Small">@DkimStatusPresentation.GetLabel(context.DkimCheckStatus)</MudChip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    };

    private bool _checkingMailbox;
    private bool _pollingNow;
    private IReadOnlyList<DotMarc.Graph.MailboxCheckResult> _mailboxChecks = [];

    /// <summary>Reads each polled mailbox without changing anything, so an admin can see whether dotMARC can reach it.</summary>
    private async Task CheckMailboxAsync()
    {
        _checkingMailbox = true;
        try
        {
            await using var scope = Services.CreateAsyncScope();
            _mailboxChecks = await scope.ServiceProvider.GetRequiredService<DotMarc.Graph.MailboxAccessCheck>().CheckAsync(CancellationToken.None);
        }
        finally
        {
            _checkingMailbox = false;
        }
    }

    /// <summary>Wakes the poller instead of waiting for the next scheduled poll, then shows how that poll went.</summary>
    private async Task PollNowAsync()
    {
        _pollingNow = true;
        try
        {
            await PollNow.RequestAsync().WaitAsync(TimeSpan.FromMinutes(2));
            await LoadAsync();
            Snackbar.Add(_lastPoll?.Succeeded == true ? "Mailbox polled." : "The poll ran but failed. See the polling status for why.", _lastPoll?.Succeeded == true ? Severity.Success : Severity.Warning);
        }
        catch (TimeoutException)
        {
            Snackbar.Add("The poll is taking a while. The polling status will show the result when it finishes.", Severity.Info);
        }
        finally
        {
            _pollingNow = false;
        }
    }

    private DashboardSummary? _summary;
    private List<DashboardDomainRow> _rows = [];
    private PollStatusRow? _lastPoll;
    private List<Group> _allGroups = [];
    private List<Tag> _allTags = [];
    private int? _selectedGroupId;
    private int? _selectedTagId;
    private List<int>? _scopedGroupIds;

    private string? _domainFilter;
    private string? _statusFilter;
    private double? _minPassRatePercentFilter;
    private string? _lastReportFilter;
    private bool? _monitoredFilter;
    private string? _dmarcFilter;
    private string? _mtaStsFilter;
    private string? _dkimFilter;
    private bool _showFilters;
    private bool _groupedView;
    private IReadOnlyList<DashboardDomainGroup> _groupedTables = [];

    private bool IsFilterActive => _selectedGroupId is not null || _selectedTagId is not null;

    private bool RowMatchesFilters(DashboardDomainRow row)
    {
        if (!string.IsNullOrWhiteSpace(_domainFilter) && !row.Name.Contains(_domainFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        if (_statusFilter is not null && row.Status != _statusFilter)
        {
            return false;
        }
        if (_minPassRatePercentFilter is { } minPercent && (row.PassRate ?? 0) * 100 < minPercent)
        {
            return false;
        }
        if (!string.IsNullOrWhiteSpace(_lastReportFilter))
        {
            var text = row.LastReportReceivedUtc is { } last ? last.ToString("g") : "never";
            if (!text.Contains(_lastReportFilter, StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }
        }
        if (_monitoredFilter is { } monitored && row.IsMonitored != monitored)
        {
            return false;
        }
        if (_dmarcFilter is not null && DmarcStatusPresentation.GetLabel(row.DmarcCheckStatus, row.DmarcAuthorizationCheckStatus) != _dmarcFilter)
        {
            return false;
        }
        if (_mtaStsFilter is not null && MtaStsStatusPresentation.GetLabel(row.MtaStsStatus) != _mtaStsFilter)
        {
            return false;
        }
        if (_dkimFilter is not null && DkimStatusPresentation.GetLabel(row.DkimCheckStatus) != _dkimFilter)
        {
            return false;
        }
        return true;
    }

    private string? _userKey;
    private bool _hasSavedDefault;

    protected override async Task OnInitializedAsync()
    {
        _userKey = DashboardPreferencesStore.UserKeyOf(await AuditActorAccessor.GetAsync());
        if (_userKey is not null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (await DashboardPreferencesStore.GetAsync(db, _userKey) is { } saved)
            {
                ApplyPreferences(saved);
                _hasSavedDefault = true;
            }
        }

        await LoadAsync();

        if (RendererInfo.IsInteractive)
        {
            ShowDnsPushResultToast();
        }
    }

    private DashboardPreferences CurrentPreferences() => new(
        _groupedView, _selectedGroupId, _selectedTagId, _showFilters, _statusFilter, _minPassRatePercentFilter, _monitoredFilter, _dmarcFilter, _mtaStsFilter, _dkimFilter);

    private void ApplyPreferences(DashboardPreferences preferences)
    {
        _groupedView = preferences.GroupedView;
        _selectedGroupId = preferences.GroupId;
        _selectedTagId = preferences.TagId;
        _showFilters = preferences.ShowFilters;
        _statusFilter = preferences.Status;
        _minPassRatePercentFilter = preferences.MinPassRatePercent;
        _monitoredFilter = preferences.Monitored;
        _dmarcFilter = preferences.Dmarc;
        _mtaStsFilter = preferences.MtaSts;
        _dkimFilter = preferences.Dkim;
    }

    private async Task SaveDefaultAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await DashboardPreferencesStore.SaveAsync(db, _userKey!, CurrentPreferences());
            _hasSavedDefault = true;
            Snackbar.Add("Saved. The Dashboard will open like this for you from now on.", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't save your default. Try again.", Severity.Error);
        }
    }

    private async Task ClearDefaultAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await DashboardPreferencesStore.ClearAsync(db, _userKey!);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't clear your default. Try again.", Severity.Error);
            return;
        }

        _hasSavedDefault = false;
        ApplyPreferences(new DashboardPreferences());
        await LoadAsync();
        Snackbar.Add("Default cleared. The Dashboard will open with every domain.", Severity.Info);
    }

    private void ShowDnsPushResultToast()
    {
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Navigation.Uri).Query);
        if (query["dnsPush"] == "invalid")
        {
            Snackbar.Add("That DNS push link was invalid or has expired. Try again from the domain's page.", Severity.Warning);
        }
    }

    private async Task LoadAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var scopedGroupClaims = authState.User.FindAll(DotMarc.Security.UserAccessClaimsTransformation.ScopedGroupClaimType).ToList();
        _scopedGroupIds = scopedGroupClaims.Count == 0 ? null : scopedGroupClaims.Select(c => int.Parse(c.Value)).ToList();
        if (_scopedGroupIds is not null && (_selectedGroupId is null || !_scopedGroupIds.Contains(_selectedGroupId.Value)))
        {
            _selectedGroupId = _scopedGroupIds[0];
        }

        // A fresh, untracked context per render: the page is read-only and Blazor Server's DI
        // scope lives for the whole circuit, so injecting DotMarcDbContext directly would keep one
        // context (and its tracked entities) alive for as long as the tab stays open, showing
        // stale data as PollingService writes new reports behind it.
        await using var db = await DbFactory.CreateDbContextAsync();

        _allGroups = await db.Groups.AsNoTracking().OrderBy(g => g.Name).ToListAsync();
        if (_scopedGroupIds is not null)
        {
            _allGroups = _allGroups.Where(g => _scopedGroupIds.Contains(g.Id)).ToList();
        }
        _allTags = await db.Tags.AsNoTracking().OrderBy(t => t.Name).ToListAsync();

        // A saved default can name a Group or Tag that has since been deleted, or a Group this person can no longer see.
        if (_selectedTagId is { } savedTag && _allTags.All(t => t.Id != savedTag))
        {
            _selectedTagId = null;
        }
        if (_selectedGroupId is { } savedGroup && _allGroups.All(g => g.Id != savedGroup))
        {
            _selectedGroupId = _scopedGroupIds?[0];
        }

        var cutoff = DomainStatistics.GetWindowCutoffUtc();
        var query = db.Domains
            .AsNoTracking()
            .Include(d => d.Reports.Where(r => r.ReceivedUtc >= cutoff))
            .ThenInclude(r => r.Records)
            .ThenInclude(rec => rec.OverrideReasons)
            .Include(d => d.Reports.Where(r => r.ReceivedUtc >= cutoff))
            .ThenInclude(r => r.Records)
            .ThenInclude(rec => rec.AuthDetails)
            // Two sibling collections under each record (override reasons and auth details) would
            // otherwise be joined into one result, multiplying rows and repeating every report's
            // RawXml on each of them.
            .Include(d => d.Groups)
            .AsSplitQuery()
            .AsQueryable();

        if (_selectedGroupId is { } groupId)
        {
            query = query.Where(d => d.Groups.Any(g => g.Id == groupId));
        }
        if (_selectedTagId is { } tagId)
        {
            query = query.Where(d => d.Tags.Any(t => t.Id == tagId));
        }

        var domains = await query.ToListAsync();

        var parseFailureCount = await db.ParseFailures.CountAsync();

        (_summary, _rows) = DashboardSummary.Build(domains, parseFailureCount);

        var visibleGroups = (_selectedGroupId is { } onlyGroup ? _allGroups.Where(g => g.Id == onlyGroup) : _allGroups).Select(g => (g.Id, g.Name)).ToList();
        _groupedTables = DashboardGrouping.Group(
            _rows,
            domains.ToDictionary(d => d.Id, d => (IReadOnlyList<int>)d.Groups.Select(g => g.Id).ToList()),
            visibleGroups);

        _lastPoll = await db.PollCycles
            .AsNoTracking()
            .OrderByDescending(p => p.PolledUtc)
            .Select(p => new PollStatusRow(p.PolledUtc, p.MessagesChecked, p.ReportsParsed, p.ParseFailures, p.Succeeded, p.ErrorMessage))
            .FirstOrDefaultAsync();
    }

    private async Task ToggleMonitoredAsync(DashboardDomainRow row, bool isMonitored)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await DomainManagementService.SetMonitoredAsync(db, await AuditActorAccessor.GetAsync(), row.Id, isMonitored, CancellationToken.None);
        }
        catch (Exception)
        {
            Snackbar.Add($"Failed to update {row.Name}. Try again.", Severity.Error);
        }
        await LoadAsync();
    }

    private async Task OnGroupFilterChangedAsync(int? groupId)
    {
        _selectedGroupId = groupId;
        await LoadAsync();
    }

    private async Task OnTagFilterChangedAsync(int? tagId)
    {
        _selectedTagId = tagId;
        await LoadAsync();
    }

    private sealed record PollStatusRow(DateTimeOffset PolledUtc, int MessagesChecked, int ReportsParsed, int ParseFailures, bool Succeeded, string? ErrorMessage);
}
