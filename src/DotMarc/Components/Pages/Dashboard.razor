@page "/dashboard"
@attribute [Authorize(Policy = "DomainsView")]
@using DotMarc.Components.Shared
@using DotMarc.Data
@using DotMarc.Reporting
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<DotMarcDbContext> DbFactory
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>dotMARC - Dashboard</PageTitle>
<div class="d-flex align-center mb-1">
    <MudText Typo="Typo.h4">Dashboard</MudText>
    <DocsLink Href="https://dotmarc.app/docs/getting-started" Text="What this page shows" Class="ml-2" />
</div>
<MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
    Pass rate, DNS status, and polling health for every domain you monitor, updated as reports
    come in. Filter by Group or Tag below, or open a domain for its full report history.
</MudText>

@if (_summary is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6">
            <MudSelect T="int?" Label="Group" Value="_selectedGroupId" ValueChanged="@(v => OnGroupFilterChangedAsync(v))" Clearable="@(_scopedGroupIds is null)" Disabled="@(_scopedGroupIds is not null && _scopedGroupIds.Count == 1)">
                @foreach (var group in _allGroups)
                {
                    <MudSelectItem T="int?" Value="group.Id">@group.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="int?" Label="Tag" Value="_selectedTagId" ValueChanged="@(v => OnTagFilterChangedAsync(v))" Clearable="true">
                @foreach (var tag in _allTags)
                {
                    <MudSelectItem T="int?" Value="tag.Id">@tag.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="2">
            <MudPaper Height="100%" Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h5">@_summary.DomainCount</MudText>
                <MudText Typo="Typo.caption">domains monitored</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudPaper Height="100%" Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h5" Color="Color.Success">@_summary.OverallPassRate.ToString("P1")</MudText>
                <MudText Typo="Typo.caption">overall pass rate (30d)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudPaper Height="100%" Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h5" Color="Color.Warning">@_summary.WarningCount</MudText>
                <MudText Typo="Typo.caption">domains with warnings</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudPaper Height="100%" Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h5" Color="Color.Error">@_summary.MissingCount</MudText>
                <MudText Typo="Typo.caption">missing expected report</MudText>
            </MudPaper>
        </MudItem>
        <AuthorizeView Policy="DomainsWrite">
            <MudItem xs="12" sm="6" md="2">
                <MudPaper Height="100%" Class="pa-4 cursor-pointer" Elevation="1" @onclick="@(() => Navigation.NavigateTo("/parse-failures"))">
                    <MudText Typo="Typo.h5" Color="@(!IsFilterActive && _summary.ParseFailureCount > 0 ? Color.Error : Color.Default)">@_summary.ParseFailureCount</MudText>
                    <MudText Typo="Typo.caption">unparseable messages@(IsFilterActive ? " (all domains)" : "")</MudText>
                </MudPaper>
            </MudItem>
        </AuthorizeView>
        <MudItem xs="12" sm="6" md="2">
            <MudPaper Height= "100%" Class="pa-4 cursor-pointer" Elevation="1">
                <MudText Typo="Typo.h5">@_summary.SourceCount</MudText>
                <MudText Typo="Typo.caption">sources provided reports</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (_summary.ReasonBreakdown.Total > 0)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Why rejects/quarantines happened, across every monitored domain (30d)</MudText>
            <MudGrid>
                <MudItem xs="12" sm="5">
                    <MudChart ChartType="ChartType.Donut" T="double"
                              ChartSeries="@([new double[] { _summary.ReasonBreakdown.BenignOverride, _summary.ReasonBreakdown.LocalPolicy, _summary.ReasonBreakdown.Other, _summary.ReasonBreakdown.InferredAuthFailure, _summary.ReasonBreakdown.NoReasonGiven }])"
                              ChartLabels="@(new[] { "Benign override", "Local policy", "Other", "SPF/DKIM failure (inferred)", "No reason given" })"
                              Width="220px" Height="220px" />
                </MudItem>
                <MudItem xs="12" sm="7" Class="d-flex align-center">
                    <MudText Typo="Typo.body2">
                        Of @_summary.ReasonBreakdown.Total rejected/quarantined messages: @_summary.ReasonBreakdown.BenignOverride benign
                        override (forwarders/mailing lists), @_summary.ReasonBreakdown.LocalPolicy local policy,
                        @_summary.ReasonBreakdown.Other other, @_summary.ReasonBreakdown.InferredAuthFailure with an inferred
                        SPF/DKIM failure, @_summary.ReasonBreakdown.NoReasonGiven no reason given.
                    </MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }

    <MudTable Items="_rows" Hover="true" T="DashboardDomainRow" CustomHeader="true" Filter="RowMatchesFilters">
        <HeaderContent>
            <tr>
                <MudTh rowspan="2"><MudTableSortLabel SortBy="new Func<DashboardDomainRow, object>(r => r.Name)">Domain</MudTableSortLabel></MudTh>
                <MudTh rowspan="2"><MudTableSortLabel SortBy="new Func<DashboardDomainRow, object>(r => r.Status)">Report Status</MudTableSortLabel></MudTh>
                <MudTh rowspan="2"><MudTableSortLabel SortBy="new Func<DashboardDomainRow, object>(r => r.PassRate ?? -1)">Pass rate (30d)</MudTableSortLabel></MudTh>
                <MudTh rowspan="2"><MudTableSortLabel SortBy="new Func<DashboardDomainRow, object>(r => r.LastReportReceivedUtc ?? DateTimeOffset.MinValue)">Last report</MudTableSortLabel></MudTh>
                <MudTh rowspan="2"><MudTableSortLabel SortBy="new Func<DashboardDomainRow, object>(r => r.IsMonitored)">Monitored</MudTableSortLabel></MudTh>
                <MudTh colspan="2" Style="text-align:center; position:relative">
                    DNS Status
                    <MudIconButton Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" Color="@(_showFilters ? Color.Primary : Color.Default)"
                                   OnClick="@(() => _showFilters = !_showFilters)" Style="position:absolute; right:0; top:50%; transform:translateY(-50%);" title="Toggle column filters" />
                </MudTh>
            </tr>
            <tr>
                <MudTh><MudTableSortLabel SortBy="new Func<DashboardDomainRow, object>(r => DmarcStatusPresentation.GetLabel(r.DmarcCheckStatus, r.DmarcAuthorizationCheckStatus))">DMARC</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<DashboardDomainRow, object>(r => MtaStsStatusPresentation.GetLabel(r.MtaStsStatus))">MTA-STS</MudTableSortLabel></MudTh>
            </tr>
            @if (_showFilters)
            {
            <tr>
                <MudTh><MudTextField T="string" @bind-Value="_domainFilter" Placeholder="Search" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" /></MudTh>
                <MudTh>
                    <MudSelect T="string" Value="_statusFilter" ValueChanged="@(v => _statusFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                        @foreach (var status in _rows.Select(r => r.Status).Distinct().OrderBy(s => s))
                        {
                            <MudSelectItem T="string" Value="status">@status</MudSelectItem>
                        }
                    </MudSelect>
                </MudTh>
                <MudTh>
                    <MudNumericField T="double?" @bind-Value="_minPassRatePercentFilter" Placeholder="Min %" Margin="Margin.Dense" Min="0" Max="100" />
                </MudTh>
                <MudTh><MudTextField T="string" @bind-Value="_lastReportFilter" Placeholder="Search" Immediate="true" Margin="Margin.Dense" /></MudTh>
                <MudTh>
                    <MudSelect T="bool?" Value="_monitoredFilter" ValueChanged="@(v => _monitoredFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                        <MudSelectItem T="bool?" Value="true">Yes</MudSelectItem>
                        <MudSelectItem T="bool?" Value="false">No</MudSelectItem>
                    </MudSelect>
                </MudTh>
                <MudTh>
                    <MudSelect T="string" Value="_dmarcFilter" ValueChanged="@(v => _dmarcFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                        @foreach (var label in _rows.Select(r => DmarcStatusPresentation.GetLabel(r.DmarcCheckStatus, r.DmarcAuthorizationCheckStatus)).Distinct().OrderBy(l => l))
                        {
                            <MudSelectItem T="string" Value="label">@label</MudSelectItem>
                        }
                    </MudSelect>
                </MudTh>
                <MudTh>
                    <MudSelect T="string" Value="_mtaStsFilter" ValueChanged="@(v => _mtaStsFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                        @foreach (var label in _rows.Select(r => MtaStsStatusPresentation.GetLabel(r.MtaStsStatus)).Distinct().OrderBy(l => l))
                        {
                            <MudSelectItem T="string" Value="label">@label</MudSelectItem>
                        }
                    </MudSelect>
                </MudTh>
            </tr>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd @onclick="@(() => Navigation.NavigateTo($"/domains/{Uri.EscapeDataString(context.Name)}"))" Style="cursor:pointer">
                @context.Name
                @if (context.SpfCheckStatus == SpfCheckStatus.NullSpf)
                {
                    <MudTooltip Text="This domain publishes a null SPF record (no authorized senders). For parked domains like this, DMARC's p=reject is the recommended policy." Arrow="true">
                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Class="ml-2">Null-routed</MudChip>
                    </MudTooltip>
                }
            </MudTd>
            <MudTd @onclick="@(() => Navigation.NavigateTo($"/domains/{Uri.EscapeDataString(context.Name)}"))" Style="cursor:pointer"><MudChip T="string" Color="@context.StatusColor" Size="Size.Small">@context.Status</MudChip></MudTd>
            <MudTd @onclick="@(() => Navigation.NavigateTo($"/domains/{Uri.EscapeDataString(context.Name)}"))" Style="cursor:pointer">@(context.PassRate is { } rate ? rate.ToString("P1") : "—")</MudTd>
            <MudTd @onclick="@(() => Navigation.NavigateTo($"/domains/{Uri.EscapeDataString(context.Name)}"))" Style="cursor:pointer">@(context.LastReportReceivedUtc is { } last ? last.ToString("g") : "never")</MudTd>
            <MudTd>
                <AuthorizeView Policy="DomainsEdit" Context="authState">
                    <Authorized>
                        <MudSwitch T="bool" Value="context.IsMonitored" ValueChanged="@(v => ToggleMonitoredAsync(context, v))" Color="Color.Primary" />
                    </Authorized>
                    <NotAuthorized>
                        @(context.IsMonitored ? "Yes" : "No")
                    </NotAuthorized>
                </AuthorizeView>
            </MudTd>
            <MudTd @onclick="@(() => Navigation.NavigateTo($"/domains/{Uri.EscapeDataString(context.Name)}"))" Style="cursor:pointer">
                <MudChip T="string" Color="@DmarcStatusPresentation.GetColor(context.DmarcCheckStatus, context.DmarcAuthorizationCheckStatus)" Size="Size.Small">@DmarcStatusPresentation.GetLabel(context.DmarcCheckStatus, context.DmarcAuthorizationCheckStatus)</MudChip>
            </MudTd>
            <MudTd @onclick="@(() => Navigation.NavigateTo($"/domains/{Uri.EscapeDataString(context.Name)}"))" Style="cursor:pointer">
                <MudChip T="string" Color="@MtaStsStatusPresentation.GetColor(context.MtaStsStatus)" Size="Size.Small">@MtaStsStatusPresentation.GetLabel(context.MtaStsStatus)</MudChip>
            </MudTd>
        </RowTemplate>
    </MudTable>

    <MudPaper Class="pa-4 mt-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Polling status</MudText>
        @if (_lastPoll is null)
        {
            <MudText Typo="Typo.body2">Not polled yet.</MudText>
        }
        else if (_lastPoll.Succeeded)
        {
            <MudGrid>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption">Last polled</MudText>
                    <MudText>@_lastPoll.PolledUtc.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption">Messages checked</MudText>
                    <MudText>@_lastPoll.MessagesChecked</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption">Reports parsed</MudText>
                    <MudText>@_lastPoll.ReportsParsed</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption">Parse failures</MudText>
                    <MudText>@_lastPoll.ParseFailures</MudText>
                </MudItem>
            </MudGrid>
        }
        else
        {
            <MudText Color="Color.Error" Style="overflow-wrap:anywhere">
                Last poll (@_lastPoll.PolledUtc.ToString("yyyy-MM-dd HH:mm:ss")) failed:
                @(string.IsNullOrWhiteSpace(_lastPoll.ErrorMessage) ? "no error message was recorded." : _lastPoll.ErrorMessage)
            </MudText>
        }
    </MudPaper>
}

@code {
    private DashboardSummary? _summary;
    private List<DashboardDomainRow> _rows = [];
    private PollStatusRow? _lastPoll;
    private List<Group> _allGroups = [];
    private List<Tag> _allTags = [];
    private int? _selectedGroupId;
    private int? _selectedTagId;
    private List<int>? _scopedGroupIds;

    private string? _domainFilter;
    private string? _statusFilter;
    private double? _minPassRatePercentFilter;
    private string? _lastReportFilter;
    private bool? _monitoredFilter;
    private string? _dmarcFilter;
    private string? _mtaStsFilter;
    private bool _showFilters;

    private bool IsFilterActive => _selectedGroupId is not null || _selectedTagId is not null;

    private bool RowMatchesFilters(DashboardDomainRow row)
    {
        if (!string.IsNullOrWhiteSpace(_domainFilter) && !row.Name.Contains(_domainFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        if (_statusFilter is not null && row.Status != _statusFilter)
        {
            return false;
        }
        if (_minPassRatePercentFilter is { } minPercent && (row.PassRate ?? 0) * 100 < minPercent)
        {
            return false;
        }
        if (!string.IsNullOrWhiteSpace(_lastReportFilter))
        {
            var text = row.LastReportReceivedUtc is { } last ? last.ToString("g") : "never";
            if (!text.Contains(_lastReportFilter, StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }
        }
        if (_monitoredFilter is { } monitored && row.IsMonitored != monitored)
        {
            return false;
        }
        if (_dmarcFilter is not null && DmarcStatusPresentation.GetLabel(row.DmarcCheckStatus, row.DmarcAuthorizationCheckStatus) != _dmarcFilter)
        {
            return false;
        }
        if (_mtaStsFilter is not null && MtaStsStatusPresentation.GetLabel(row.MtaStsStatus) != _mtaStsFilter)
        {
            return false;
        }
        return true;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        if (RendererInfo.IsInteractive)
        {
            ShowDnsPushResultToast();
        }
    }

    private void ShowDnsPushResultToast()
    {
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Navigation.Uri).Query);
        if (query["dnsPush"] == "invalid")
        {
            Snackbar.Add("That DNS push link was invalid or has expired. Try again from the domain's page.", Severity.Warning);
        }
    }

    private async Task LoadAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var scopedGroupClaims = authState.User.FindAll(DotMarc.Security.UserAccessClaimsTransformation.ScopedGroupClaimType).ToList();
        _scopedGroupIds = scopedGroupClaims.Count == 0 ? null : scopedGroupClaims.Select(c => int.Parse(c.Value)).ToList();
        if (_scopedGroupIds is not null && (_selectedGroupId is null || !_scopedGroupIds.Contains(_selectedGroupId.Value)))
        {
            _selectedGroupId = _scopedGroupIds[0];
        }

        // A fresh, untracked context per render: the page is read-only and Blazor Server's DI
        // scope lives for the whole circuit, so injecting DotMarcDbContext directly would keep one
        // context (and its tracked entities) alive for as long as the tab stays open, showing
        // stale data as PollingService writes new reports behind it.
        await using var db = await DbFactory.CreateDbContextAsync();

        _allGroups = await db.Groups.AsNoTracking().OrderBy(g => g.Name).ToListAsync();
        if (_scopedGroupIds is not null)
        {
            _allGroups = _allGroups.Where(g => _scopedGroupIds.Contains(g.Id)).ToList();
        }
        _allTags = await db.Tags.AsNoTracking().OrderBy(t => t.Name).ToListAsync();

        var cutoff = DomainStatistics.GetWindowCutoffUtc();
        var query = db.Domains
            .AsNoTracking()
            .Include(d => d.Reports.Where(r => r.ReceivedUtc >= cutoff))
            .ThenInclude(r => r.Records)
            .ThenInclude(rec => rec.OverrideReasons)
            .Include(d => d.Reports.Where(r => r.ReceivedUtc >= cutoff))
            .ThenInclude(r => r.Records)
            .ThenInclude(rec => rec.AuthDetails)
            .AsQueryable();

        if (_selectedGroupId is { } groupId)
        {
            query = query.Where(d => d.Groups.Any(g => g.Id == groupId));
        }
        if (_selectedTagId is { } tagId)
        {
            query = query.Where(d => d.Tags.Any(t => t.Id == tagId));
        }

        var domains = await query.ToListAsync();

        var parseFailureCount = await db.ParseFailures.CountAsync();

        (_summary, _rows) = DashboardSummary.Build(domains, parseFailureCount);

        _lastPoll = await db.PollCycles
            .AsNoTracking()
            .OrderByDescending(p => p.PolledUtc)
            .Select(p => new PollStatusRow(p.PolledUtc, p.MessagesChecked, p.ReportsParsed, p.ParseFailures, p.Succeeded, p.ErrorMessage))
            .FirstOrDefaultAsync();
    }

    private async Task ToggleMonitoredAsync(DashboardDomainRow row, bool isMonitored)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await DomainManagementService.SetMonitoredAsync(db, row.Id, isMonitored, CancellationToken.None);
        }
        catch (Exception)
        {
            Snackbar.Add($"Failed to update {row.Name}. Try again.", Severity.Error);
        }
        await LoadAsync();
    }

    private async Task OnGroupFilterChangedAsync(int? groupId)
    {
        _selectedGroupId = groupId;
        await LoadAsync();
    }

    private async Task OnTagFilterChangedAsync(int? tagId)
    {
        _selectedTagId = tagId;
        await LoadAsync();
    }

    private sealed record PollStatusRow(DateTimeOffset PolledUtc, int MessagesChecked, int ReportsParsed, int ParseFailures, bool Succeeded, string? ErrorMessage);
}
