@page "/alerts"
@attribute [Authorize(Policy = "AlertsView")]
@using DotMarc.Data
@using DotMarc.Components.Shared
@using DotMarc.Notifications
@using DotMarc.Psa
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<DotMarcDbContext> DbFactory
@inject AuditActorAccessor AuditActorAccessor
@inject IPsaTicketService PsaTicketService
@inject IEnumerable<IPsaProvider> PsaProviders
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>dotMARC - Alerts</PageTitle>
<div class="d-flex align-center mb-4">
    <MudText Typo="Typo.h4">Alerts</MudText>
    <DocsLink Href="https://dotmarc.app/docs/alerts" Text="Alert types and delivery channels" Class="ml-2" />
</div>

@if (_alerts is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_alerts.Count == 0)
{
    <MudAlert Severity="Severity.Info">No alert events have fired yet.</MudAlert>
}
else
{
    <MudTable Items="_alerts" Hover="true" T="AlertEvent" CustomHeader="true" Filter="AlertMatchesFilters">
        <ToolBarContent>
            <MudSpacer />
            <MudButton Variant="@(_showFilters ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.FilterList"
                       OnClick="@(() => _showFilters = !_showFilters)">@(_showFilters ? "Hide filters" : "Filters")</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <tr>
                <MudTh><MudTableSortLabel SortBy="new Func<AlertEvent, object>(e => e.DomainName)">Domain</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<AlertEvent, object>(e => e.AlertType)">Type</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<AlertEvent, object>(e => e.Severity)">Severity</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<AlertEvent, object>(e => e.CreatedUtc)">Created</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<AlertEvent, object>(e => e.IsResolved ? e.ResolvedUtc ?? DateTimeOffset.MinValue : DateTimeOffset.MaxValue)">Resolved</MudTableSortLabel></MudTh>
                <MudTh>Message</MudTh>
                <MudTh>Tickets</MudTh>
                <MudTh></MudTh>
            </tr>
            @if (_showFilters)
            {
            <tr>
                <MudTh><MudTextField T="string" @bind-Value="_domainFilter" Placeholder="Search" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" /></MudTh>
                <MudTh>
                    <MudSelect T="string" Value="_typeFilter" ValueChanged="@(v => _typeFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                        @foreach (var alertType in _alerts.Select(e => e.AlertType).Distinct().OrderBy(t => t))
                        {
                            <MudSelectItem T="string" Value="alertType">@alertType</MudSelectItem>
                        }
                    </MudSelect>
                </MudTh>
                <MudTh>
                    <MudSelect T="string" Value="_severityFilter" ValueChanged="@(v => _severityFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                        @foreach (var severity in _alerts.Select(e => e.Severity).Distinct().OrderBy(s => s))
                        {
                            <MudSelectItem T="string" Value="severity">@severity</MudSelectItem>
                        }
                    </MudSelect>
                </MudTh>
                <MudTh><MudTextField T="string" @bind-Value="_createdFilter" Placeholder="Search" Immediate="true" Margin="Margin.Dense" /></MudTh>
                <MudTh>
                    <MudSelect T="bool?" Value="_resolvedFilter" ValueChanged="@(v => _resolvedFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                        <MudSelectItem T="bool?" Value="false">Open</MudSelectItem>
                        <MudSelectItem T="bool?" Value="true">Resolved</MudSelectItem>
                    </MudSelect>
                </MudTh>
                <MudTh><MudTextField T="string" @bind-Value="_messageFilter" Placeholder="Search" Immediate="true" Margin="Margin.Dense" /></MudTh>
                <MudTh></MudTh>
                <MudTh></MudTh>
            </tr>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.DomainName</MudTd>
            <MudTd>@context.AlertType</MudTd>
            <MudTd><MudChip T="string" Color="@GetSeverityColor(context.Severity)" Size="Size.Small">@context.Severity</MudChip></MudTd>
            <MudTd>@FormatCreated(context)</MudTd>
            <MudTd>@(context.IsResolved ? context.ResolvedUtc?.ToLocalTime().ToString("g") ?? "—" : "Open")</MudTd>
            <MudTd>@context.Message</MudTd>
            <MudTd DataLabel="Tickets">
                @foreach (var ticket in context.Tickets.OrderBy(ticket => ticket.Psa))
                {
                    var label = $"{ticket.Psa.DisplayName()} #{ticket.TicketId}";
                    var state = ticket.IsOpen ? "Open" : "Closed";
                    @* A filled chip is a ticket still open in the PSA, an outlined one a closed ticket. *@
                    @if (_ticketUrlTemplates.GetValueOrDefault(ticket.Psa) is { } template)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="@(ticket.IsOpen ? Variant.Filled : Variant.Outlined)" title="@state"
                                 Href="@string.Format(CultureInfo.InvariantCulture, template, Uri.EscapeDataString(ticket.TicketId))" Target="_blank">@label</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Variant="@(ticket.IsOpen ? Variant.Filled : Variant.Outlined)" title="@state">@label</MudChip>
                    }
                }
            </MudTd>
            <MudTd>
                @if (!context.IsResolved && AlertAcknowledgement.IsAcknowledgeable(context.AlertType))
                {
                    <AuthorizeView Policy="AlertsManage" Context="authorization">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => AcknowledgeAsync(context))">Acknowledge</MudButton>
                    </AuthorizeView>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<AlertEvent>? _alerts;
    private Dictionary<PsaKind, string?> _ticketUrlTemplates = [];

    private string? _domainFilter;
    private string? _typeFilter;
    private string? _severityFilter;
    private string? _createdFilter;
    private bool? _resolvedFilter;
    private string? _messageFilter;
    private bool _showFilters;

    private static string FormatCreated(AlertEvent alert) => alert.CreatedUtc.ToLocalTime().ToString("g");

    private bool AlertMatchesFilters(AlertEvent alert)
    {
        if (!string.IsNullOrWhiteSpace(_domainFilter) && !alert.DomainName.Contains(_domainFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        if (_typeFilter is not null && alert.AlertType != _typeFilter)
        {
            return false;
        }
        if (_severityFilter is not null && alert.Severity != _severityFilter)
        {
            return false;
        }
        if (!string.IsNullOrWhiteSpace(_createdFilter) && !FormatCreated(alert).Contains(_createdFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        if (_resolvedFilter is { } resolved && alert.IsResolved != resolved)
        {
            return false;
        }
        if (!string.IsNullOrWhiteSpace(_messageFilter) && !alert.Message.Contains(_messageFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        return true;
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _alerts = await db.AlertEvents
            .AsNoTracking()
            .Include(e => e.Tickets)
            .OrderByDescending(e => e.CreatedUtc)
            .Take(100)
            .ToListAsync();

        // A link that can't be built (the PSA's web address isn't known) just leaves its chips unlinked.
        var templates = new Dictionary<PsaKind, string?>();
        foreach (var provider in PsaProviders)
        {
            try
            {
                templates[provider.Kind] = await provider.GetTicketUrlTemplateAsync(db);
            }
            catch (Exception)
            {
                templates[provider.Kind] = null;
            }
        }

        _ticketUrlTemplates = templates;
    }

    private async Task AcknowledgeAsync(AlertEvent alert)
    {
        var accepted = alert.AlertType == AlertTypes.DmarcPolicyWeakened ? "its current DMARC policy" : "its current nameservers";
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Acknowledge alert",
            $"Close this alert for {alert.DomainName} and accept {accepted} as the new normal? Its PSA tickets are closed too, if it has any.",
            yesText: "Acknowledge", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        // The button only renders with AlertsManage, and Blazor only runs handlers for rendered elements.
        await using var db = await DbFactory.CreateDbContextAsync();
        var result = await AlertAcknowledgement.AcknowledgeAsync(db, await AuditActorAccessor.GetAsync(), alert.Id, PsaTicketService);
        var closed = result.Tickets.Closed;
        var failed = result.Tickets.Failed;
        switch (result.Outcome)
        {
            case AcknowledgeOutcome.Acknowledged:
                Snackbar.Add(closed == 0 ? "Alert acknowledged." : $"Alert acknowledged. Closed {closed} ticket{(closed == 1 ? "" : "s")}.", Severity.Success);
                break;
            case AcknowledgeOutcome.AcknowledgedButTicketNotClosed:
                Snackbar.Add($"Alert acknowledged, but {failed} ticket{(failed == 1 ? "" : "s")} couldn't be closed. dotMARC will keep trying, or close {(failed == 1 ? "it" : "them")} in the PSA.", Severity.Warning);
                break;
            default:
                Snackbar.Add("That alert is already closed.", Severity.Info);
                break;
        }

        await LoadAsync();
    }

    private static Color GetSeverityColor(string severity) => severity switch
    {
        "Error" => Color.Error,
        "Warning" => Color.Warning,
        _ => Color.Info
    };
}
