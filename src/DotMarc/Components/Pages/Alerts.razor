@page "/alerts"
@attribute [Authorize(Policy = "AlertsView")]
@using DotMarc.Data
@using DotMarc.Components.Shared
@using DotMarc.Notifications
@using DotMarc.Psa
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<DotMarcDbContext> DbFactory
@inject AuditActorAccessor AuditActorAccessor
@inject IPsaTicketService PsaTicketService
@inject IEnumerable<IPsaProvider> PsaProviders
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar

<AppPageTitle>dotMARC - Alerts</AppPageTitle>
<div class="d-flex align-center mb-4">
    <MudText Typo="Typo.h4">Alerts</MudText>
    <DocsLink Href="https://dotmarc.app/docs/alerts" Text="Alert types and delivery channels" Class="ml-2" />
</div>

@if (_alerts is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudTable Items="_alerts" Hover="true" T="AlertEvent" CustomHeader="true" Filter="AlertMatchesFilters" Class="responsive-detail-table" Breakpoint="Breakpoint.Lg">
        <ToolBarContent>
            <ListToolbar Label="Alert controls" SearchLabel="Search alert domains" @bind-Search="_domainFilter" @bind-Expanded="_showFilters"
                         FilterCount="@FilterCount" ClearFilters="ClearFilters">
                <SortContent><ListTableSort TItem="AlertEvent" @ref="_tableSort" /></SortContent>
                <FiltersContent>
                    <MudSelect T="string" Label="Alert type" @bind-Value="_typeFilter" Clearable="true">
                        @foreach (var type in _alerts.Select(e => e.AlertType).Distinct().Order()) { <MudSelectItem Value="type">@type</MudSelectItem> }
                    </MudSelect>
                    <MudSelect T="string" Label="Severity" @bind-Value="_severityFilter" Clearable="true">
                        @foreach (var severity in _alerts.Select(e => e.Severity).Distinct().Order()) { <MudSelectItem Value="severity">@severity</MudSelectItem> }
                    </MudSelect>
                    <MudTextField Label="Created contains" @bind-Value="_createdFilter" Immediate="true" />
                    <MudSelect T="bool?" Label="Resolved" @bind-Value="_resolvedFilter" Clearable="true">
                        <MudSelectItem T="bool?" Value="false">Open</MudSelectItem><MudSelectItem T="bool?" Value="true">Resolved</MudSelectItem>
                    </MudSelect>
                    <MudTextField Label="Message contains" @bind-Value="_messageFilter" Immediate="true" />
                </FiltersContent>
            </ListToolbar>
        </ToolBarContent>
        <HeaderContent>
            <tr>
                <MudTh><MudTableSortLabel SortDirectionChanged="RefreshSort" SortLabel="Domain" SortBy="new Func<AlertEvent, object>(e => e.DomainName)">Domain</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortDirectionChanged="RefreshSort" SortLabel="Type" SortBy="new Func<AlertEvent, object>(e => e.AlertType)">Type</MudTableSortLabel></MudTh>
                @if (_showRule)
                {
                    <MudTh>Rule</MudTh>
                }
                <MudTh><MudTableSortLabel SortDirectionChanged="RefreshSort" SortLabel="Severity" SortBy="new Func<AlertEvent, object>(e => e.Severity)">Severity</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortDirectionChanged="RefreshSort" SortLabel="Created" SortBy="new Func<AlertEvent, object>(e => e.CreatedUtc)">Created</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortDirectionChanged="RefreshSort" SortLabel="Resolved" SortBy="new Func<AlertEvent, object>(e => e.IsResolved ? e.ResolvedUtc ?? DateTimeOffset.MinValue : DateTimeOffset.MaxValue)">Resolved</MudTableSortLabel></MudTh>
                <MudTh>Message</MudTh>
                <MudTh>Tickets</MudTh>
                <MudTh></MudTh>
            </tr>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Domain">
                @if (_domainNames.Contains(context.DomainName))
                {
                    <MudLink Href="@($"/domains/{Uri.EscapeDataString(context.DomainName)}")">@context.DomainName</MudLink>
                }
                else
                {
                    @context.DomainName
                }
            </MudTd>
            <MudTd DataLabel="Type">@context.AlertType</MudTd>
            @if (_showRule)
            {
                <MudTd DataLabel="Rule">@RuleNameOf(context)</MudTd>
            }
            <MudTd DataLabel="Severity"><MudChip T="string" Color="@GetSeverityColor(context.Severity)" Size="Size.Small">@context.Severity</MudChip></MudTd>
            <MudTd DataLabel="Created">@FormatCreated(context)</MudTd>
            <MudTd DataLabel="Resolved">@(context.IsResolved ? context.ResolvedUtc?.ToLocalTime().ToString("g") ?? "—" : "Open")</MudTd>
            <MudTd DataLabel="Message">
                @context.Message
                @if (AlertRulePresentation.DescribeNotification(context, RuleOf(context), _zone) is { } notification)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@notification</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Tickets">
                @foreach (var ticket in _tickets[context.Id].OrderBy(ticket => ticket.Psa))
                {
                    var label = $"{ticket.Psa.DisplayName()} #{ticket.TicketId}";
                    var state = ticket.IsOpen ? "Open" : "Closed";
                    @* A filled chip is a ticket still open in the PSA, an outlined one a closed ticket. *@
                    @if (_ticketUrlTemplates.GetValueOrDefault(ticket.Psa) is { } template)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="@(ticket.IsOpen ? Variant.Filled : Variant.Outlined)" title="@state"
                                 Href="@string.Format(CultureInfo.InvariantCulture, template, Uri.EscapeDataString(ticket.TicketId))" Target="_blank">@label</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Variant="@(ticket.IsOpen ? Variant.Filled : Variant.Outlined)" title="@state">@label</MudChip>
                    }
                }
            </MudTd>
            <MudTd DataLabel="Actions">
                @if (!context.IsResolved && AlertAcknowledgement.IsAcknowledgeable(context.AlertType))
                {
                    <AuthorizeView Policy="AlertsManage" Context="authorization">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => AcknowledgeAsync(context))">Acknowledge</MudButton>
                    </AuthorizeView>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private ListTableSort<AlertEvent>? _tableSort;
    private Task RefreshSort(SortDirection _) => _tableSort?.RefreshAsync() ?? Task.CompletedTask;
    private int FilterCount => new[] { _typeFilter, _severityFilter, _createdFilter, _messageFilter }.Count(value => !string.IsNullOrWhiteSpace(value)) + (_resolvedFilter is null ? 0 : 1);
    private void ClearFilters() { _typeFilter = _severityFilter = _createdFilter = _messageFilter = null; _resolvedFilter = null; }
    private List<AlertEvent>? _alerts;
    private HashSet<string> _domainNames = [];
    private Dictionary<PsaKind, string?> _ticketUrlTemplates = [];
    private ILookup<int, AlertTicket> _tickets = Array.Empty<AlertTicket>().ToLookup(ticket => ticket.AlertEventId);

    private string? _domainFilter;
    private string? _typeFilter;
    private string? _severityFilter;
    private string? _createdFilter;
    private bool? _resolvedFilter;
    private string? _messageFilter;
    private bool _showFilters;

    private static string FormatCreated(AlertEvent alert) => alert.CreatedUtc.ToLocalTime().ToString("g");

    private bool AlertMatchesFilters(AlertEvent alert)
    {
        if (!string.IsNullOrWhiteSpace(_domainFilter) && !alert.DomainName.Contains(_domainFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        if (_typeFilter is not null && alert.AlertType != _typeFilter)
        {
            return false;
        }
        if (_severityFilter is not null && alert.Severity != _severityFilter)
        {
            return false;
        }
        if (!string.IsNullOrWhiteSpace(_createdFilter) && !FormatCreated(alert).Contains(_createdFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        if (_resolvedFilter is { } resolved && alert.IsResolved != resolved)
        {
            return false;
        }
        if (!string.IsNullOrWhiteSpace(_messageFilter) && !alert.Message.Contains(_messageFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        return true;
    }

    // Rule names can name clients, so the column is only for staff with no group limit, as the rules page is.
    private bool _showRule;
    private Dictionary<int, string> _ruleNames = [];

    private Dictionary<int, AlertRule> _rulesById = [];
    private TimeZoneInfo _zone = TimeZoneInfo.Utc;

    private AlertRule? RuleOf(AlertEvent alert) => alert.AlertRuleId is { } ruleId && _rulesById.TryGetValue(ruleId, out var rule) ? rule : null;

    private string RuleNameOf(AlertEvent alert) => alert.AlertRuleId is { } ruleId && _ruleNames.TryGetValue(ruleId, out var name) ? name : string.Empty;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _alerts = await db.AlertEvents
            .AsNoTracking()
            .OrderByDescending(e => e.CreatedUtc)
            .Take(100)
            .ToListAsync();

        // An alert raised again while an earlier copy's ticket is open shows that ticket too, rather than none.
        _tickets = await AlertTicketLinks.LoadAsync(db, _alerts);

        _showRule = AlertRuleAccess.MayView((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User);
        _rulesById = _showRule ? await db.AlertRules.AsNoTracking().ToDictionaryAsync(rule => rule.Id) : [];
        _ruleNames = _rulesById.ToDictionary(pair => pair.Key, pair => pair.Value.Name);
        _zone = QuietHours.ZoneFor((await NotificationSettingsService.GetAsync(db)).TimeZoneId);

        var alertDomainNames = _alerts.Select(alert => alert.DomainName).Distinct().ToArray();
        _domainNames = (await db.Domains.AsNoTracking()
            .Where(domain => alertDomainNames.Contains(domain.Name))
            .Select(domain => domain.Name)
            .ToListAsync()).ToHashSet(StringComparer.OrdinalIgnoreCase);

        // A link that can't be built (the PSA's web address isn't known) just leaves its chips unlinked.
        var templates = new Dictionary<PsaKind, string?>();
        foreach (var provider in PsaProviders)
        {
            try
            {
                templates[provider.Kind] = await provider.GetTicketUrlTemplateAsync(db);
            }
            catch (Exception)
            {
                templates[provider.Kind] = null;
            }
        }

        _ticketUrlTemplates = templates;
    }

    private async Task AcknowledgeAsync(AlertEvent alert)
    {
        var accepted = alert.AlertType == AlertTypes.DmarcPolicyWeakened ? "its current DMARC policy" : "its current nameservers";
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Acknowledge alert",
            $"Close this alert for {alert.DomainName} and accept {accepted} as the new normal? Its PSA tickets are closed too, if it has any.",
            yesText: "Acknowledge", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        // The button only renders with AlertsManage, and Blazor only runs handlers for rendered elements.
        await using var db = await DbFactory.CreateDbContextAsync();
        var result = await AlertAcknowledgement.AcknowledgeAsync(db, await AuditActorAccessor.GetAsync(), alert.Id, PsaTicketService);
        var closed = result.Tickets.Closed;
        var failed = result.Tickets.Failed;
        switch (result.Outcome)
        {
            case AcknowledgeOutcome.Acknowledged:
                Snackbar.Add(closed == 0 ? "Alert acknowledged." : $"Alert acknowledged. Closed {closed} ticket{(closed == 1 ? "" : "s")}.", Severity.Success);
                break;
            case AcknowledgeOutcome.AcknowledgedButTicketNotClosed:
                Snackbar.Add($"Alert acknowledged, but {failed} ticket{(failed == 1 ? "" : "s")} couldn't be closed. dotMARC will keep trying, or close {(failed == 1 ? "it" : "them")} in the PSA.", Severity.Warning);
                break;
            default:
                Snackbar.Add("That alert is already closed.", Severity.Info);
                break;
        }

        await LoadAsync();
    }

    private static Color GetSeverityColor(string severity) => severity switch
    {
        "Critical" or "Error" => Color.Error,
        "Warning" => Color.Warning,
        _ => Color.Info
    };
}
